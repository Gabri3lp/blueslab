                                        <!-- Stage Gimmick / Rules Warning (Purely Informational) -->
                                        @{
                                            var stageWarnings = GetStageGimmickWarnings(move, State.Enemies[State.ActiveTargetIndex]);
                                        }
                                        @if (stageWarnings.Count > 0)
