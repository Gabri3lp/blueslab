@using BluesLab.Models
@using BluesLab.Services
@using BluesLab.Components.Modals
@inject SyncPairDataService DataService
@inject DamageCalculatorService CalcService
@inject StageService StageSvc
@inject GridStateService GridState

<div class="team-calculator-container p-2 p-md-3">
    <!-- Top Stage & Battle Conditions Bar -->
    <div class="card bg-dark border-secondary shadow-sm mb-4">
        <div class="card-header bg-secondary bg-opacity-25 border-secondary d-flex justify-content-between align-items-center flex-wrap gap-2 py-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-trophy-fill text-warning fs-5"></i>
                <span class="fw-bold text-light fs-5">3v3 Team Battle Simulator</span>
                <span class="badge bg-danger">Pasio Gym Battle No. 3</span>
            </div>
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <!-- Shared Sync Buffs -->
                <div class="d-flex align-items-center gap-2 bg-dark p-1 px-3 rounded border border-secondary">
                    <span class="text-info small fw-bold"><i class="bi bi-lightning-charge-fill text-warning"></i> Ally Sync Buffs:</span>
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2 text-light" @onclick="() => ChangeAllySyncBuffs(-1)">-</button>
                    <b class="text-warning fs-6">@State.AllySyncBuffs</b>
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2 text-light" @onclick="() => ChangeAllySyncBuffs(1)">+</button>
                    <span class="text-muted small">(@((1.0 + State.AllySyncBuffs * 0.5).ToString("0.#"))x)</span>
                </div>

                <div class="d-flex align-items-center gap-2 bg-dark p-1 px-3 rounded border border-secondary">
                    <span class="text-danger small fw-bold"><i class="bi bi-lightning-charge-fill text-danger"></i> Enemy Sync Buffs:</span>
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2 text-light" @onclick="() => ChangeEnemySyncBuffs(-1)">-</button>
                    <b class="text-danger fs-6">@State.EnemySyncBuffs</b>
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2 text-light" @onclick="() => ChangeEnemySyncBuffs(1)">+</button>
                    <span class="text-muted small">(@((1.0 + State.EnemySyncBuffs * 0.5).ToString("0.#"))x)</span>
                </div>
            </div>
        </div>

        <div class="card-body p-3">
            <!-- Stage Selection -->
            <div class="row g-2 align-items-center mb-3">
                <div class="col-md-5">
                    <label class="form-label small text-muted mb-1"><i class="bi bi-diagram-3-fill text-warning me-1"></i> Gym Circuit / Tier:</label>
                    <select class="form-select form-select-sm bg-dark text-light border-secondary" value="@State.SelectedLeagueId" @onchange="OnLeagueChanged">
                        @foreach (var l in _leagues)
                        {
                            <option value="@l.LeagueId">@l.Name</option>
                        }
                    </select>
                </div>

                <div class="col-md-5">
                    <label class="form-label small text-muted mb-1"><i class="bi bi-swords text-danger me-1"></i> Gym Leader Battle:</label>
                    <select class="form-select form-select-sm bg-dark text-light border-secondary" value="@State.SelectedFightId" @onchange="OnFightChanged">
                        @{
                            var currentLeague = _leagues.FirstOrDefault(l => l.LeagueId == State.SelectedLeagueId);
                            if (currentLeague != null)
                            {
                                @foreach (var f in currentLeague.Fights)
                                {
                                    <option value="@f.FightId">@f.Title</option>
                                }
                            }
                        }
                    </select>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-sm btn-outline-info w-100" @onclick="LoadSelectedStage">
                        <i class="bi bi-cloud-arrow-down-fill me-1"></i> Apply Stage
                    </button>
                </div>
            </div>

            <!-- Active Gym Stage Rules & Themes Card -->
            @if (State.ActiveFight != null)
            {
                <div class="p-2 mb-3 rounded bg-black bg-opacity-30 border border-secondary border-opacity-75 small">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <span class="badge bg-warning text-dark fw-bold">Leader: @State.ActiveFight.Leader</span>
                        <span class="badge type-badge type-@State.ActiveFight.StageType.ToLowerInvariant()">@State.ActiveFight.StageType</span>
                        @if (!string.IsNullOrEmpty(State.ActiveFight.Theme) && !State.ActiveFight.Theme.Equals("No rules", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge bg-secondary"><i class="bi bi-info-circle me-1"></i>Theme: @State.ActiveFight.Theme</span>
                        }
                    </div>
                    @if (State.ActiveFight.Rules.Count > 0)
                    {
                        <div class="d-flex flex-column gap-1 mt-1">
                            @foreach (var r in State.ActiveFight.Rules)
                            {
                                <div class="text-warning-emphasis d-flex align-items-center gap-1" style="font-size: 0.78rem;">
                                    <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                                    <span>@r</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <!-- Global Field Conditions -->
            <div class="row g-2 pt-2 border-top border-secondary align-items-center">
                <div class="col-6 col-md-3">
                    <label class="form-label small text-muted mb-1">Weather:</label>
                    <select class="form-select form-select-sm bg-dark text-light border-secondary" @bind="State.Field.Weather">
                        <option value="">None (Normal)</option>
                        <option value="Sunny">Sunny ☀️</option>
                        <option value="Rainy">Rainy 🌧️</option>
                        <option value="Sandstorm">Sandstorm 🏜️</option>
                        <option value="Hail">Hail ❄️</option>
                    </select>
                </div>

                <div class="col-6 col-md-3">
                    <label class="form-label small text-muted mb-1">Terrain:</label>
                    <select class="form-select form-select-sm bg-dark text-light border-secondary" @bind="State.Field.Terrain">
                        <option value="">None</option>
                        <option value="Electric Terrain">Electric Terrain ⚡</option>
                        <option value="Grassy Terrain">Grassy Terrain 🌿</option>
                        <option value="Psychic Terrain">Psychic Terrain 🔮</option>
                    </select>
                </div>

                <div class="col-6 col-md-3">
                    <label class="form-label small text-muted mb-1">Zone:</label>
                    <select class="form-select form-select-sm bg-dark text-light border-secondary" @bind="State.Field.Zone">
                        <option value="">None</option>
                        @foreach (var z in CombatantState.ValidZoneTypes)
                        {
                            <option value="@($"{z} Zone")">@($"{z} Zone")</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-md-3">
                    <label class="form-label small text-muted mb-1">Targets in Area:</label>
                    <select class="form-select form-select-sm bg-dark text-light border-secondary" @bind="State.Field.TargetCount">
                        <option value="1">1 Target (Single)</option>
                        <option value="2">2 Targets (x0.66)</option>
                        <option value="3">3 Targets (x0.50)</option>
                    </select>
                </div>
            </div>

            <!-- Regional Battle Circles (Team-wide) -->
            <div class="pt-2 border-top border-secondary border-opacity-50 mt-2">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-outline-info btn-sm py-0 px-2" style="font-size: 0.75rem;" @onclick="() => _showCirclesPanel = !_showCirclesPanel">
                            <i class="bi bi-record-circle me-1"></i> Battle Circles @(State.GetActiveCirclesCount() > 0 ? $"({State.GetActiveCirclesCount()})" : "")
                        </button>
                        @if (State.GetActiveCirclesCount() > 0)
                        {
                            <button class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 0.7rem;" @onclick="() => { State.ClearAllCircles(); StateHasChanged(); }">
                                Clear Circles
                            </button>
                        }
                    </div>

                    <!-- Active Circles Badges -->
                    <div class="d-flex flex-wrap gap-1 align-items-center">
                        @foreach (var r in CombatantState.CircleRegions)
                        {
                            int allies = State.TeamCircleAllyCounts.GetValueOrDefault(r, 1);
                            if (State.IsCircleActive(r, "physical"))
                            {
                                <span class="badge bg-info text-dark d-inline-flex align-items-center gap-1 shadow-sm" style="font-size: 0.72rem;">
                                    @r Phys (+@(10 + 10 * allies)%)
                                    <i class="bi bi-x-circle-fill opacity-75 ms-1" style="cursor: pointer;" title="Remove" @onclick='() => State.ToggleCircle(r, "physical")'></i>
                                </span>
                            }
                            if (State.IsCircleActive(r, "special"))
                            {
                                <span class="badge bg-info text-dark d-inline-flex align-items-center gap-1 shadow-sm" style="font-size: 0.72rem;">
                                    @r Spec (+@(10 + 10 * allies)%)
                                    <i class="bi bi-x-circle-fill opacity-75 ms-1" style="cursor: pointer;" title="Remove" @onclick='() => State.ToggleCircle(r, "special")'></i>
                                </span>
                            }
                            if (State.IsCircleActive(r, "defensive"))
                            {
                                <span class="badge bg-info text-dark d-inline-flex align-items-center gap-1 shadow-sm" style="font-size: 0.72rem;">
                                    @r Def (+@(5 + 5 * allies)%)
                                    <i class="bi bi-x-circle-fill opacity-75 ms-1" style="cursor: pointer;" title="Remove" @onclick='() => State.ToggleCircle(r, "defensive")'></i>
                                </span>
                            }
                        }
                    </div>
                </div>

                @if (_showCirclesPanel || State.GetActiveCirclesCount() > 0)
                {
                    <div class="mt-2 pt-2 border-top border-secondary border-opacity-50 bg-black bg-opacity-25 p-2 rounded">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="small text-warning fw-bold text-uppercase" style="font-size: 0.75rem;">Circle Region:</span>
                            <select class="form-select form-select-sm bg-dark text-light border-secondary py-0" style="width: 120px; font-size: 0.75rem;" @bind="_selectedCircleRegion" @bind:after="StateHasChanged">
                                @foreach (var r in CombatantState.CircleRegions)
                                {
                                    <option value="@r">@r</option>
                                }
                            </select>

                            <div class="d-flex flex-wrap align-items-center gap-1">
                                <button class="btn btn-sm py-0 px-2 @(State.IsCircleActive(_selectedCircleRegion, "physical") ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light")" style="font-size: 0.75rem;"
                                        @onclick='() => State.ToggleCircle(_selectedCircleRegion, "physical")'>
                                    Physical Circle
                                </button>
                                <button class="btn btn-sm py-0 px-2 @(State.IsCircleActive(_selectedCircleRegion, "special") ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light")" style="font-size: 0.75rem;"
                                        @onclick='() => State.ToggleCircle(_selectedCircleRegion, "special")'>
                                    Special Circle
                                </button>
                                <button class="btn btn-sm py-0 px-2 @(State.IsCircleActive(_selectedCircleRegion, "defensive") ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light")" style="font-size: 0.75rem;"
                                        @onclick='() => State.ToggleCircle(_selectedCircleRegion, "defensive")'>
                                    Defensive Circle
                                </button>
                            </div>

                            <div class="d-flex align-items-center gap-1 ms-auto">
                                <span class="small text-secondary fw-bold" style="font-size: 0.75rem;">Allies:</span>
                                <div class="btn-group btn-group-sm">
                                    @for (int a = 1; a <= 3; a++)
                                    {
                                        int count = a;
                                        <button class="btn btn-sm py-0 px-2 @(State.TeamCircleAllyCounts.GetValueOrDefault(_selectedCircleRegion, 1) == count ? "btn-primary fw-bold" : "btn-outline-secondary text-light")" style="font-size: 0.75rem;"
                                                @onclick="() => { State.TeamCircleAllyCounts[_selectedCircleRegion] = count; StateHasChanged(); }">
                                            @count
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Allies Row (3 Slots) -->
    <div class="mb-4">
        <h5 class="text-success fw-bold mb-3 d-flex align-items-center justify-content-between">
            <span><i class="bi bi-people-fill me-2"></i> Allied Team (3 Slots)</span>
            <span class="text-muted small fw-normal">Select an ally to set as Active Attacker</span>
        </h5>

        <div class="row g-3">
            @for (int i = 0; i < 3; i++)
            {
                int slotIndex = i;
                var ally = State.Allies[slotIndex];
                bool isAttacker = State.ActiveAttackerIndex == slotIndex;

                <div class="col-lg-4">
                    <div class="card h-100 @(isAttacker ? "border-primary bg-primary bg-opacity-10 shadow" : "border-secondary bg-dark") p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge @(isAttacker ? "bg-primary" : "bg-secondary")">Slot @(slotIndex + 1)</span>
                                @if (isAttacker)
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-lightning-fill"></i> Attacker</span>
                                }
                            </div>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm @(isAttacker ? "btn-primary" : "btn-outline-secondary text-light")" @onclick="() => SetActiveAttacker(slotIndex)">
                                    @(isAttacker ? "Attacking" : "Select")
                                </button>
                            </div>
                        </div>

                        <!-- Sync Pair Display or Modal Picker Trigger -->
                        @if (ally.Pair == null)
                        {
                            <div class="my-3 text-center">
                                <button class="btn btn-outline-warning w-100 py-3 d-flex flex-column align-items-center gap-1 border-dashed"
                                        @onclick="() => OpenPairPicker(slotIndex)">
                                    <i class="bi bi-person-plus-fill fs-3 text-warning"></i>
                                    <span class="fw-bold">Choose Sync Pair</span>
                                    <span class="small text-muted">Click to open search modal</span>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex gap-2 align-items-center mb-2 p-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-50">
                                <img src="@ally.Pair.IconUrl" alt="@ally.Pair.DisplayName" class="rounded-circle border border-warning" style="width: 44px; height: 44px; object-fit: cover;" onerror="this.src='img/trainers/unknown.png';" />
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="fw-bold text-light text-truncate" title="@ally.Pair.DisplayName">@ally.Pair.DisplayName</div>
                                    <div class="d-flex gap-1 mt-1 align-items-center flex-wrap">
                                        <span class="badge type-badge type-@ally.Pair.Type.ToLowerInvariant()">@ally.Pair.Type</span>
                                        <span class="badge bg-secondary">@ally.Pair.Role</span>
                                        @if (!string.IsNullOrEmpty(ally.Pair.ExRole) && ally.HasExRole)
                                        {
                                            <span class="badge bg-indigo">EX: @ally.Pair.ExRole</span>
                                        }
                                    </div>
                                </div>
                                <button class="btn btn-sm btn-outline-warning py-1 px-2" title="Change Sync Pair" @onclick="() => OpenPairPicker(slotIndex)">
                                    <i class="bi bi-arrow-repeat"></i>
                                </button>
                            </div>

                            <!-- Forms Tab (Base, Mega, Dynamax, Tera) -->
                            @if (ally.Pair.Variations.Count > 0 || ally.Pair.HasMega || ally.Pair.HasTera)
                            {
                                <div class="btn-group btn-group-sm w-100 mb-2">
                                    <button class="btn btn-sm py-0 @(ally.FormIndex == 0 ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light")" @onclick="() => SetAllyForm(slotIndex, 0)">Base</button>
                                    @for (int vIdx = 0; vIdx < ally.Pair.Variations.Count; vIdx++)
                                    {
                                        int fIdx = vIdx + 1;
                                        var v = ally.Pair.Variations[vIdx];
                                        string formLabel = (v.FormId == 4 || v.FormName == "Form 4") ? "DMax" : v.FormName;
                                        <button class="btn btn-sm py-0 @(ally.FormIndex == fIdx ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light")" @onclick="() => SetAllyForm(slotIndex, fIdx)">@formLabel</button>
                                    }
                                </div>
                            }

                            <!-- Levels & Star Controls -->
                            <div class="row g-1 mb-2 small">
                                <div class="col-4">
                                    <label class="text-muted" style="font-size: 0.72rem;">Move Lv:</label>
                                    <select class="form-select form-select-sm bg-dark text-light border-secondary py-0" @bind="ally.MoveLevel">
                                        @for (int m = 1; m <= 5; m++)
                                        {
                                            <option value="@m">@m/5</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-4">
                                    <label class="text-muted" style="font-size: 0.72rem;">Stars:</label>
                                    <select class="form-select form-select-sm bg-dark text-light border-secondary py-0" @bind="ally.StarLevel">
                                        <option value="3★">3★</option>
                                        <option value="4★">4★</option>
                                        <option value="5★">5★</option>
                                        <option value="5★ 20/20">5★ 20/20</option>
                                        @if (ally.Pair.HasEx)
                                        {
                                            <option value="5★ EX">5★ EX</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-4">
                                    <label class="text-muted" style="font-size: 0.72rem;">Level:</label>
                                    <select class="form-select form-select-sm bg-dark text-light border-secondary py-0" @bind="ally.CharLevel">
                                        <option value="120">120</option>
                                        <option value="130">130</option>
                                        <option value="140">140</option>
                                        <option value="150">150</option>
                                        <option value="180">180</option>
                                        <option value="200">200</option>
                                    </select>
                                </div>
                                @if (ally.Pair.HasSuperAwakening)
                                {
                                    <div class="col-6 mt-1">
                                        <label class="text-danger" style="font-size: 0.72rem;">Super Awakening:</label>
                                        <select class="form-select form-select-sm bg-dark text-light border-danger py-0" @bind="ally.SuperAwakeningLevel">
                                            @for (int sa = 0; sa <= 5; sa++)
                                            {
                                                <option value="@sa">@(sa == 0 ? "SA: None" : $"SA Lv. {sa}")</option>
                                            }
                                        </select>
                                    </div>
                                }
                                @if (ally.Pair.HasEx && !string.IsNullOrEmpty(ally.Pair.ExRole))
                                {
                                    <div class="@(ally.Pair.HasSuperAwakening ? "col-6" : "col-12") mt-1">
                                        <label class="text-muted" style="font-size: 0.72rem;">EX Role:</label>
                                        <button class="btn btn-sm w-100 py-0 @(ally.HasExRole ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-muted")" @onclick="() => ally.HasExRole = !ally.HasExRole" style="font-size: 0.75rem; height: 26px;">
                                            @(ally.HasExRole ? "EX Role ON" : "EX Role OFF")
                                        </button>
                                    </div>
                                }
                            </div>

                            <!-- Lucky Skill Dropdown -->
                            <div class="mb-2">
                                <label class="text-muted small mb-0" style="font-size: 0.72rem;">Lucky Skill:</label>
                                <select class="form-select form-select-sm bg-dark text-light border-secondary py-0" style="font-size: 0.75rem;" @bind="ally.LuckySkillName">
                                    <option value="">(None)</option>
                                    @foreach (var ls in _rules.LuckySkills.Where(s => s.IsAvailableFor(ally.Pair.Role, ally.Pair.DisplayName)))
                                    {
                                        <option value="@ls.Name">@ls.Name</option>
                                    }
                                </select>
                            </div>

                            <!-- Stat Stages Dropdowns (-6 to +6) -->
                            <div class="bg-black bg-opacity-25 p-2 rounded border border-secondary mb-2 small">
                                <div class="text-muted fw-bold mb-1" style="font-size: 0.7rem;">Stat Stages (+6 to -6):</div>
                                <div class="row row-cols-3 g-1">
                                    @foreach (var stat in new[] { "atk", "def", "spa", "spd", "spe", "crit" })
                                    {
                                        int val = ally.Stages.GetValueOrDefault(stat, stat == "crit" ? 3 : 6);
                                        int maxStage = stat == "crit" ? 3 : 6;
                                        int minStage = stat == "crit" ? 0 : -6;
                                        <div class="col">
                                            <div class="d-flex align-items-center justify-content-between p-1 rounded bg-dark border border-secondary">
                                                <span class="text-uppercase fw-bold" style="font-size: 0.68rem;">@stat</span>
                                                <select class="form-select form-select-sm bg-dark text-light border-0 py-0 px-1 text-center"
                                                        style="width: 48px; font-size: 0.72rem; height: 22px;"
                                                        value="@val"
                                                        @onchange="(e) => OnAllyStageChange(slotIndex, stat, e)">
                                                    @for (int s = maxStage; s >= minStage; s--)
                                                    {
                                                        <option value="@s">@(s > 0 ? $"+{s}" : s.ToString())</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Next Boosts (PMUN, SMUN, SYUN, Crit Hit, SE Next) -->
                            <div class="bg-black bg-opacity-25 p-2 rounded border border-secondary mb-2 small">
                                <div class="text-muted fw-bold mb-1" style="font-size: 0.7rem;">Next Boosts &amp; Breaks:</div>
                                <div class="d-flex flex-wrap align-items-center gap-1">
                                    <!-- PMUN -->
                                    <div class="d-flex align-items-center gap-1 bg-dark px-1 py-0.5 rounded border border-secondary" style="font-size: 0.72rem;">
                                        <span class="text-light fw-bold">PM:</span>
                                        <select class="form-select form-select-sm bg-dark text-light border-0 py-0 px-0 text-center" style="width: 36px; font-size: 0.72rem; height: 20px;" @bind="ally.PhysicalBoostNext">
                                            @for (int b = 0; b <= 10; b++) { <option value="@b">@b</option> }
                                        </select>
                                    </div>
                                    <!-- SMUN -->
                                    <div class="d-flex align-items-center gap-1 bg-dark px-1 py-0.5 rounded border border-secondary" style="font-size: 0.72rem;">
                                        <span class="text-light fw-bold">SM:</span>
                                        <select class="form-select form-select-sm bg-dark text-light border-0 py-0 px-0 text-center" style="width: 36px; font-size: 0.72rem; height: 20px;" @bind="ally.SpecialBoostNext">
                                            @for (int b = 0; b <= 10; b++) { <option value="@b">@b</option> }
                                        </select>
                                    </div>
                                    <!-- SYUN -->
                                    <div class="d-flex align-items-center gap-1 bg-dark px-1 py-0.5 rounded border border-secondary" style="font-size: 0.72rem;">
                                        <span class="text-light fw-bold">SY:</span>
                                        <select class="form-select form-select-sm bg-dark text-light border-0 py-0 px-0 text-center" style="width: 36px; font-size: 0.72rem; height: 20px;" @bind="ally.SyncMoveBoostNext">
                                            @for (int b = 0; b <= 10; b++) { <option value="@b">@b</option> }
                                        </select>
                                    </div>

                                    <button class="btn btn-sm py-0 px-1 @(ally.IsCriticalMove ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-muted")" style="font-size: 0.72rem;" @onclick="() => ally.IsCriticalMove = !ally.IsCriticalMove">Crit</button>
                                    <button class="btn btn-sm py-0 px-1 @(ally.SuperEffectiveNext ? "btn-danger text-white fw-bold" : "btn-outline-secondary text-muted")" style="font-size: 0.72rem;" @onclick="() => ally.SuperEffectiveNext = !ally.SuperEffectiveNext">SE Next</button>
                                </div>
                            </div>

                            <!-- Grid Quick Preset & Counter -->
                            <div class="d-flex justify-content-between align-items-center pt-1 border-top border-secondary border-opacity-50 small">
                                <span class="text-muted" style="font-size: 0.72rem;">
                                    <i class="bi bi-grid-3x3 me-1"></i>Grid: <b class="text-warning">@State.AllyActiveGrids[slotIndex].Count</b> cells
                                </span>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-info py-0 px-2" style="font-size: 0.7rem;" @onclick="() => State.SetFullGridForAlly(slotIndex)">Full Grid</button>
                                    <button class="btn btn-outline-secondary py-0 px-2" style="font-size: 0.7rem;" @onclick="() => State.ClearGridForAlly(slotIndex)">Clear</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Enemies Row (3 Targets: Left, Center, Right) -->
    <div class="mb-4">
        <h5 class="text-danger fw-bold mb-3 d-flex align-items-center justify-content-between">
            <span><i class="bi bi-shield-shaded me-2"></i> Enemy Opponents (3 Targets)</span>
            <span class="text-muted small fw-normal">Select a target to focus single-target damage</span>
        </h5>

        <div class="row g-3">
            @for (int i = 0; i < 3; i++)
            {
                int targetIndex = i;
                var enemy = State.Enemies[targetIndex];
                bool isTarget = State.ActiveTargetIndex == targetIndex;
                string slotLabel = targetIndex switch { 0 => "Left Enemy", 1 => "Center (Boss)", _ => "Right Enemy" };
                string displayTrainer = string.IsNullOrEmpty(enemy.CustomTrainerName) ? slotLabel : enemy.CustomTrainerName;
                string displayPokemon = string.IsNullOrEmpty(enemy.CustomPokemonName) ? "" : enemy.CustomPokemonName;

                <div class="col-lg-4">
                    <div class="card h-100 @(isTarget ? "border-danger bg-danger bg-opacity-10 shadow" : "border-secondary bg-dark") p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge @(isTarget ? "bg-danger" : "bg-secondary")">@slotLabel</span>
                                @if (isTarget)
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-crosshair"></i> Targeted</span>
                                }
                            </div>
                            <button class="btn btn-sm @(isTarget ? "btn-danger" : "btn-outline-secondary text-light")" @onclick="() => State.ActiveTargetIndex = targetIndex">
                                @(isTarget ? "Targeted" : "Target")
                            </button>
                        </div>

                        <!-- Enemy Visual Header -->
                        <div class="d-flex align-items-center gap-2 mb-2 p-2 rounded bg-black bg-opacity-25 border border-secondary border-opacity-50">
                            @if (!string.IsNullOrEmpty(enemy.CustomIconUrl))
                            {
                                <img src="@enemy.CustomIconUrl" alt="" class="rounded-circle border border-danger" style="width: 40px; height: 40px; object-fit: cover;" onerror="this.src='img/trainers/unknown.png';" />
                            }
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="fw-bold text-light text-truncate small" title="@displayTrainer">@displayTrainer</div>
                                <div class="text-muted small text-truncate" style="font-size: 0.75rem;">@displayPokemon</div>
                            </div>
                            <span class="badge type-badge type-@enemy.Weakness.ToLowerInvariant()">Weak: @enemy.Weakness</span>
                        </div>

                        <!-- Enemy Stats Summary (Max HP, Def, SpD, Weakness) -->
                        <div class="row g-2 mb-2 small">
                            <div class="col-6">
                                <label class="text-muted" style="font-size: 0.72rem;">Weakness:</label>
                                <select class="form-select form-select-sm bg-dark text-light border-secondary py-0" @bind="enemy.Weakness">
                                    @foreach (var t in CombatantState.AllTypes)
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="text-muted" style="font-size: 0.72rem;">Max HP:</label>
                                <input type="number" class="form-control form-control-sm bg-dark text-light border-secondary py-0" value="@enemy.ManualStats.GetValueOrDefault("hp", 2000)" @onchange="@(e => OnEnemyHp(targetIndex, e))" />
                            </div>
                            <div class="col-6">
                                <label class="text-muted" style="font-size: 0.72rem;">Defense:</label>
                                <input type="number" class="form-control form-control-sm bg-dark text-light border-secondary py-0" value="@enemy.ManualStats.GetValueOrDefault("def", 100)" @onchange="@(e => OnEnemyDef(targetIndex, e))" />
                            </div>
                            <div class="col-6">
                                <label class="text-muted" style="font-size: 0.72rem;">Sp. Def:</label>
                                <input type="number" class="form-control form-control-sm bg-dark text-light border-secondary py-0" value="@enemy.ManualStats.GetValueOrDefault("spd", 100)" @onchange="@(e => OnEnemySpd(targetIndex, e))" />
                            </div>
                        </div>

                        <!-- Enemy Debuff / Stat Stages Dropdowns (-6 to +6) -->
                        <div class="bg-black bg-opacity-25 p-2 rounded border border-secondary mb-2 small">
                            <div class="text-muted fw-bold mb-1" style="font-size: 0.7rem;">Debuffs / Stages (+6 to -6):</div>
                            <div class="row row-cols-3 g-1">
                                @foreach (var stat in new[] { "def", "spd", "spe", "atk", "spa" })
                                {
                                    int val = enemy.Stages.GetValueOrDefault(stat, 0);
                                    <div class="col">
                                        <div class="d-flex align-items-center justify-content-between p-1 rounded bg-dark border border-secondary">
                                            <span class="text-uppercase fw-bold" style="font-size: 0.68rem;">@stat</span>
                                            <select class="form-select form-select-sm bg-dark text-light border-0 py-0 px-1 text-center"
                                                    style="width: 48px; font-size: 0.72rem; height: 22px;"
                                                    value="@val"
                                                    @onchange="(e) => OnEnemyStageChange(targetIndex, stat, e)">
                                                @for (int s = 6; s >= -6; s--)
                                                {
                                                    <option value="@s">@(s > 0 ? $"+{s}" : s.ToString())</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Status Condition & Volatiles -->
                        <div class="bg-black bg-opacity-25 p-2 rounded border border-secondary mb-2 small">
                            <div class="mb-1">
                                <label class="text-muted mb-0" style="font-size: 0.72rem;">Status Condition:</label>
                                <select class="form-select form-select-sm bg-dark text-light border-secondary py-0" style="font-size: 0.75rem;" @bind="enemy.StatusCondition">
                                    <option value="">None</option>
                                    <option value="burned">Burned 🔥</option>
                                    <option value="paralyzed">Paralyzed ⚡</option>
                                    <option value="poisoned">Poisoned ☠️</option>
                                    <option value="badly poisoned">Badly Poisoned 🟣</option>
                                    <option value="asleep">Asleep 💤</option>
                                    <option value="frozen">Frozen ❄️</option>
                                </select>
                            </div>

                            <!-- Volatiles Buttons (Official Icons) -->
                            <div class="d-flex align-items-center gap-1 mt-2">
                                <span class="text-muted small me-1" style="font-size: 0.7rem;">Volatile:</span>
                                <button class="btn btn-sm py-0 px-2 @(enemy.VolatileStatus.GetValueOrDefault("confused", false) ? "btn-warning fw-bold text-dark" : "btn-outline-secondary text-light")"
                                        style="font-size: 0.72rem;"
                                        title="Confused"
                                        @onclick='() => enemy.VolatileStatus["confused"] = !enemy.VolatileStatus.GetValueOrDefault("confused", false)'>
                                    <img src="img/battle/SCTP_001.png" alt="" style="height: 16px; width: 16px; object-fit: contain;" />
                                </button>
                                <button class="btn btn-sm py-0 px-2 @(enemy.VolatileStatus.GetValueOrDefault("trapped", false) ? "btn-warning fw-bold text-dark" : "btn-outline-secondary text-light")"
                                        style="font-size: 0.72rem;"
                                        title="Trapped"
                                        @onclick='() => enemy.VolatileStatus["trapped"] = !enemy.VolatileStatus.GetValueOrDefault("trapped", false)'>
                                    <img src="img/battle/SCTP_004.png" alt="" style="height: 16px; width: 16px; object-fit: contain;" />
                                </button>
                                <button class="btn btn-sm py-0 px-2 @(enemy.VolatileStatus.GetValueOrDefault("flinching", false) ? "btn-warning fw-bold text-dark" : "btn-outline-secondary text-light")"
                                        style="font-size: 0.72rem;"
                                        title="Flinching"
                                        @onclick='() => enemy.VolatileStatus["flinching"] = !enemy.VolatileStatus.GetValueOrDefault("flinching", false)'>
                                    <img src="img/battle/SCTP_002.png" alt="" style="height: 16px; width: 16px; object-fit: contain;" />
                                </button>

                                <div class="ms-auto d-flex gap-1">
                                    <button class="btn btn-sm py-0 px-2 @(enemy.PhysicalBreak ? "btn-pink fw-bold" : "btn-outline-secondary text-light")"
                                            style="font-size: 0.72rem;"
                                            title="Phys Break"
                                            @onclick="() => enemy.PhysicalBreak = !enemy.PhysicalBreak">
                                        <img src="img/battle/break_phys.png" alt="" style="height: 16px; width: 16px; object-fit: contain;" />
                                    </button>
                                    <button class="btn btn-sm py-0 px-2 @(enemy.SpecialBreak ? "btn-pink fw-bold" : "btn-outline-secondary text-light")"
                                            style="font-size: 0.72rem;"
                                            title="Spec Break"
                                            @onclick="() => enemy.SpecialBreak = !enemy.SpecialBreak">
                                        <img src="img/battle/break_spec.png" alt="" style="height: 16px; width: 16px; object-fit: contain;" />
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Enemy Rebuff, Mitigations & Screens -->
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-1 pt-1 border-top border-secondary border-opacity-50 small">
                            <!-- Rebuff on Weakness Type -->
                            <div class="d-flex align-items-center gap-1">
                                <span class="text-danger fw-bold" style="font-size: 0.7rem;">Rebuff:</span>
                                <div class="btn-group btn-group-sm">
                                    @for (int r = -3; r <= 3; r++)
                                    {
                                        int rb = r;
                                        int curVal = enemy.EnemyTypeRebuffs.GetValueOrDefault(enemy.Weakness, 0);
                                        <button class="btn btn-sm py-0 px-1 @(curVal == rb ? (rb < 0 ? "btn-primary fw-bold" : (rb > 0 ? "btn-danger fw-bold" : "btn-secondary text-light")) : "btn-outline-secondary text-light")"
                                                style="font-size: 0.68rem;"
                                                @onclick="() => enemy.EnemyTypeRebuffs[enemy.Weakness] = rb">
                                            @(rb > 0 ? $"+{rb}" : rb.ToString())
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- Screens Toggle -->
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm py-0 px-1 @(enemy.PhysicalDamageReduction ? "btn-warning fw-bold text-dark" : "btn-outline-secondary text-light")"
                                        style="font-size: 0.68rem;"
                                        title="Physical Damage Reduction"
                                        @onclick="() => enemy.PhysicalDamageReduction = !enemy.PhysicalDamageReduction">
                                    Reflect
                                </button>
                                <button class="btn btn-sm py-0 px-1 @(enemy.SpecialDamageReduction ? "btn-warning fw-bold text-dark" : "btn-outline-secondary text-light")"
                                        style="font-size: 0.68rem;"
                                        title="Special Damage Reduction"
                                        @onclick="() => enemy.SpecialDamageReduction = !enemy.SpecialDamageReduction">
                                    Light Screen
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Damage Results Section for Active Attacker -->
    @if (State.ActiveAttacker.Pair != null)
    {
        <div class="card bg-dark border-secondary shadow-sm mb-4">
            <div class="card-header bg-secondary bg-opacity-25 border-secondary d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-graph-up text-warning fs-5"></i>
                    <span class="fw-bold text-light fs-5">
                        Damage Outputs: @State.ActiveAttacker.Pair.DisplayName
                    </span>
                </div>
                <span class="badge bg-purple">Slot @(State.ActiveAttackerIndex + 1) Active</span>
            </div>

            <div class="card-body">
                <div class="d-flex flex-column gap-3">
                    @{
                        var allAttackerMoves = State.ActiveAttacker.Pair.Moves
                            .Concat(CalcService.GetMaxMoves(State.ActiveAttacker.Pair))
                            .Where(m => !m.Category.Equals("Status", StringComparison.OrdinalIgnoreCase) && int.TryParse(m.Power, out int p) && p > 0)
                            .ToList();
                        var normalAttackerMoves = allAttackerMoves.Where(m => !m.IsMax).ToList();
                        var maxAttackerMoves = allAttackerMoves.Where(m => m.IsMax).ToList();
                    }

                    @foreach (var move in normalAttackerMoves)
                    {
                        var teamResult = CalcService.CalculateTeamDamage(move, State, _rules);

                        <div class="card move-card move-card-@move.Type.ToLowerInvariant() p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div class="fw-bold text-light fs-6">@move.Name</div>
                                    <div class="d-flex gap-1 align-items-center mt-1 flex-wrap">
                                        <span class="badge type-badge type-@move.Type.ToLowerInvariant()">@move.Type</span>
                                        <span class="badge bg-secondary">@move.Category</span>
                                        @if (move.IsSync)
                                        {
                                            <span class="badge bg-purple">Sync Move</span>
                                        }
                                        @if (teamResult.IsAoE)
                                        {
                                            <span class="badge bg-info text-dark"><i class="bi bi-broadcast me-1"></i>AoE / All Targets</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark border border-secondary text-secondary">Single Target</span>
                                        }
                                        @if (move.MaxUses > 0)
                                        {
                                            <span class="badge" style="background-color: rgba(56, 189, 248, 0.2); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.5); font-weight: 600;">
                                                <i class="bi bi-arrow-repeat me-0.5"></i>@move.MaxUses @(move.MaxUses == 1 ? "Use" : "Uses")
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Triple Enemy Breakdown with % Max HP -->
                            <div class="row g-2 mt-1">
                                @for (int eIdx = 0; eIdx < 3; eIdx++)
                                {
                                    int slot = eIdx;
                                    var dmg = slot switch
                                    {
                                        0 => teamResult.LeftDamage,
                                        1 => teamResult.CenterDamage,
                                        _ => teamResult.RightDamage
                                    };
                                    var opp = State.Enemies[slot];
                                    bool isTargetedEnemy = State.ActiveTargetIndex == slot;
                                    string slotTitle = slot switch { 0 => "Left Enemy", 1 => "Center (Boss)", _ => "Right Enemy" };
                                    string oppName = string.IsNullOrEmpty(opp.CustomTrainerName) ? slotTitle : $"{opp.CustomTrainerName}";

                                    <div class="col-md-4">
                                        <div class="p-2 rounded border @(isTargetedEnemy ? "border-warning bg-warning bg-opacity-10 shadow-sm" : "border-secondary bg-black bg-opacity-25") text-center">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="small text-muted fw-bold text-truncate" style="font-size: 0.75rem;">@oppName</span>
                                                @if (teamResult.IsAoE)
                                                {
                                                    <span class="badge bg-info text-dark py-0" style="font-size: 0.65rem;">AoE Hit</span>
                                                }
                                                else if (isTargetedEnemy)
                                                {
                                                    <span class="badge bg-danger text-white py-0" style="font-size: 0.65rem;"><i class="bi bi-crosshair me-0.5"></i>Target</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary text-muted py-0" style="font-size: 0.65rem;" title="Single-target move only attacks the targeted enemy. Value shown is hypothetical.">Hypothetical</span>
                                                }
                                            </div>

                                            <!-- Damage & HP Percentage Display -->
                                            <div class="d-flex align-items-baseline justify-content-center gap-1">
                                                <span class="fs-5 fw-bold text-warning">@dmg.AvgDamage.ToString("N0")</span>
                                                <span class="fw-bold @(dmg.IsOHKO ? "text-danger" : "text-info")" style="font-size: 0.95rem;">
                                                    (@dmg.AvgHpPercent.ToString("0.0")%)
                                                </span>
                                            </div>

                                            <!-- Min - Max Range -->
                                            <div class="small text-muted" style="font-size: 0.72rem;">
                                                @dmg.MinDamage.ToString("N0") (@dmg.MinHpPercent.ToString("0.0")%) - @dmg.MaxDamage.ToString("N0") (@dmg.MaxHpPercent.ToString("0.0")%)
                                            </div>

                                            <!-- Health Bar Visualizer -->
                                            <div class="progress mt-1" style="height: 6px; background-color: rgba(255,255,255,0.15); border-radius: 3px;">
                                                <div class="progress-bar @(dmg.AvgHpPercent >= 100 ? "bg-danger" : (dmg.AvgHpPercent >= 50 ? "bg-warning" : "bg-success"))"
                                                     role="progressbar"
                                                     style="width: @Math.Min(100, Math.Max(0, dmg.AvgHpPercent))%;"></div>
                                            </div>

                                            @if (dmg.IsOHKO)
                                            {
                                                <div class="mt-1">
                                                    <span class="badge bg-danger text-white py-0" style="font-size: 0.68rem;">
                                                        <i class="bi bi-skull-fill me-1"></i>100%+ OHKO
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Breakdown Multiplier Pills for Active Target -->
                            <div class="d-flex flex-wrap gap-1 mt-2">
                                @foreach (var pill in teamResult.ActiveTargetDamage.Breakdown)
                                {
                                    <span class="badge" style="background-color: @pill.Color; font-size: 0.7rem;">
                                        @pill.Label: @pill.Value
                                    </span>
                                }
                            </div>
                        </div>
                    }

                    @if (maxAttackerMoves.Count > 0)
                    {
                        <div class="d-flex align-items-center justify-content-between gap-2 mt-3 pt-2 border-top border-secondary border-opacity-50">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge btn-pink text-white px-2 py-1" style="font-size: 0.8rem;">
                                    <i class="bi bi-clouds-fill me-1"></i> Max Moves (Dynamax)
                                </span>
                                <span class="text-muted small" style="font-size: 0.75rem;">(Unaffected by Next Boosts &amp; AoE penalty)</span>
                            </div>
                            <span class="badge bg-secondary text-light" style="font-size: 0.7rem;">@maxAttackerMoves.Count Available</span>
                        </div>

                        @foreach (var move in maxAttackerMoves)
                        {
                            var teamResult = CalcService.CalculateTeamDamage(move, State, _rules);

                            <div class="card move-card move-card-@move.Type.ToLowerInvariant() p-3 border-pink">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-bold text-light fs-6">@move.Name</span>
                                            <span class="badge btn-pink text-white">Max Move</span>
                                        </div>
                                        <div class="d-flex gap-1 align-items-center mt-1">
                                            <span class="badge type-badge type-@move.Type.ToLowerInvariant()">@move.Type</span>
                                            <span class="badge bg-secondary">@move.Category</span>
                                            @if (teamResult.IsAoE)
                                            {
                                                <span class="badge bg-info text-dark">AoE / All Targets</span>
                                            }
                                            <span class="badge" style="background-color: rgba(232, 67, 147, 0.2); color: #ff79b0; border: 1px solid rgba(232, 67, 147, 0.5); font-weight: 600;">
                                                <i class="bi bi-arrow-repeat me-0.5"></i>1 Use
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Triple Enemy Breakdown for Max Move -->
                                <div class="row g-2 mt-1">
                                    @for (int eIdx = 0; eIdx < 3; eIdx++)
                                    {
                                        int slot = eIdx;
                                        var dmg = slot switch
                                        {
                                            0 => teamResult.LeftDamage,
                                            1 => teamResult.CenterDamage,
                                            _ => teamResult.RightDamage
                                        };
                                        var opp = State.Enemies[slot];
                                        bool isTargetedEnemy = State.ActiveTargetIndex == slot;
                                        string slotTitle = slot switch { 0 => "Left Enemy", 1 => "Center (Boss)", _ => "Right Enemy" };
                                        string oppName = string.IsNullOrEmpty(opp.CustomTrainerName) ? slotTitle : $"{opp.CustomTrainerName}";

                                        <div class="col-md-4">
                                            <div class="p-2 rounded border @(isTargetedEnemy ? "border-warning bg-warning bg-opacity-10 shadow-sm" : "border-secondary bg-black bg-opacity-25") text-center">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="small text-muted fw-bold text-truncate" style="font-size: 0.75rem;">@oppName</span>
                                                    @if (teamResult.IsAoE)
                                                    {
                                                        <span class="badge bg-info text-dark py-0" style="font-size: 0.65rem;">AoE Hit</span>
                                                    }
                                                    else if (isTargetedEnemy)
                                                    {
                                                        <span class="badge bg-danger text-white py-0" style="font-size: 0.65rem;"><i class="bi bi-crosshair me-0.5"></i>Target</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary text-muted py-0" style="font-size: 0.65rem;">Hypothetical</span>
                                                    }
                                                </div>

                                                <div class="d-flex align-items-baseline justify-content-center gap-1">
                                                    <span class="fs-5 fw-bold text-warning">@dmg.AvgDamage.ToString("N0")</span>
                                                    <span class="fw-bold @(dmg.IsOHKO ? "text-danger" : "text-info")" style="font-size: 0.95rem;">
                                                        (@dmg.AvgHpPercent.ToString("0.0")%)
                                                    </span>
                                                </div>

                                                <div class="small text-muted" style="font-size: 0.72rem;">
                                                    @dmg.MinDamage.ToString("N0") (@dmg.MinHpPercent.ToString("0.0")%) - @dmg.MaxDamage.ToString("N0") (@dmg.MaxHpPercent.ToString("0.0")%)
                                                </div>

                                                <div class="progress mt-1" style="height: 6px; background-color: rgba(255,255,255,0.15); border-radius: 3px;">
                                                    <div class="progress-bar @(dmg.AvgHpPercent >= 100 ? "bg-danger" : (dmg.AvgHpPercent >= 50 ? "bg-warning" : "bg-success"))"
                                                         role="progressbar"
                                                         style="width: @Math.Min(100, Math.Max(0, dmg.AvgHpPercent))%;"></div>
                                                </div>

                                                @if (dmg.IsOHKO)
                                                {
                                                    <div class="mt-1">
                                                        <span class="badge bg-danger text-white py-0" style="font-size: 0.68rem;">
                                                            <i class="bi bi-skull-fill me-1"></i>100%+ OHKO
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Breakdown Multiplier Pills for Active Target -->
                                <div class="d-flex flex-wrap gap-1 mt-2">
                                    @foreach (var pill in teamResult.ActiveTargetDamage.Breakdown)
                                    {
                                        <span class="badge" style="background-color: @pill.Color; font-size: 0.7rem;">
                                            @pill.Label: @pill.Value
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }

    <!-- Sync Pair Picker Modal -->
    <PairPickerModal @bind-IsOpen="_showPairPicker"
                     OnPairSelected="OnModalPairSelected" />
</div>

@code {
    private TeamBattleState State { get; set; } = new();
    private List<StageLeague> _leagues = new();
    private List<PairManifestItem> _allManifest = new();
    private DamageRulesDocument _rules = new();

    private bool _showPairPicker = false;
    private int _pickingSlot = 0;
    private bool _showCirclesPanel = false;
    private string _selectedCircleRegion = "Kanto";

    protected override async Task OnInitializedAsync()
    {
        _leagues = await StageSvc.GetLeaguesAsync();
        _allManifest = await DataService.GetManifestAsync();
        _rules = await DataService.GetDamageRulesAsync();

        if (_leagues.Count > 0)
        {
            var firstLeague = _leagues[0];
            State.SelectedLeagueId = firstLeague.LeagueId;
            var firstFight = firstLeague.Fights.FirstOrDefault();
            if (firstFight != null)
            {
                State.SelectedFightId = firstFight.FightId;
                StageSvc.ApplyFightToEnemies(State, firstFight);
            }
        }

        // Set default Slot 1 pair if available
        if (_allManifest.Count > 0)
        {
            await LoadAllyPair(0, _allManifest[0].TrainerId);
        }
    }

    private void OpenPairPicker(int slot)
    {
        _pickingSlot = slot;
        _showPairPicker = true;
    }

    private async Task OnModalPairSelected(string trainerId)
    {
        await LoadAllyPair(_pickingSlot, trainerId);
        _showPairPicker = false;
    }

    private void ChangeAllySyncBuffs(int delta)
    {
        State.AllySyncBuffs = Math.Clamp(State.AllySyncBuffs + delta, 0, 9);
    }

    private void ChangeEnemySyncBuffs(int delta)
    {
        State.EnemySyncBuffs = Math.Clamp(State.EnemySyncBuffs + delta, 0, 9);
    }

    private void OnLeagueChanged(ChangeEventArgs e)
    {
        State.SelectedLeagueId = e.Value?.ToString() ?? "circuit_1";
        var currentLeague = _leagues.FirstOrDefault(l => l.LeagueId == State.SelectedLeagueId);
        if (currentLeague != null && currentLeague.Fights.Count > 0)
        {
            State.SelectedFightId = currentLeague.Fights[0].FightId;
            StageSvc.ApplyFightToEnemies(State, currentLeague.Fights[0]);
        }
    }

    private void OnFightChanged(ChangeEventArgs e)
    {
        State.SelectedFightId = e.Value?.ToString() ?? "";
        LoadSelectedStage();
    }

    private void LoadSelectedStage()
    {
        var currentLeague = _leagues.FirstOrDefault(l => l.LeagueId == State.SelectedLeagueId);
        var fight = currentLeague?.Fights.FirstOrDefault(f => f.FightId == State.SelectedFightId);
        if (fight != null)
        {
            StageSvc.ApplyFightToEnemies(State, fight);
        }
    }

    private void SetActiveAttacker(int slot)
    {
        State.ActiveAttackerIndex = slot;
    }

    private async Task LoadAllyPair(int slot, string trainerId)
    {
        var detail = await DataService.GetPairDetailAsync(trainerId);
        if (detail != null)
        {
            var ally = State.Allies[slot];
            ally.Pair = detail;
            ally.FormIndex = 0;
            ally.MoveLevel = 5;
            ally.SuperAwakeningLevel = detail.HasSuperAwakening ? 5 : 0;
            ally.HasExRole = detail.HasEx && !string.IsNullOrEmpty(detail.ExRole);
            ally.StarLevel = detail.HasEx ? "5★ EX" : (detail.Rarity == 5 ? "5★ 20/20" : $"{detail.Rarity}★");
            ally.CharLevel = "180";
            ally.IsCriticalMove = true;
            ally.SuperEffectiveNext = false;

            // Default stat stages
            foreach (var s in CombatantState.StageLabels)
            {
                ally.Stages[s] = s == "crit" ? 3 : 6;
            }

            // By default, activate full grid for optimal calculation
            State.SetFullGridForAlly(slot);

            State.UpdateCircleAllyCounts();

            StateHasChanged();
        }
    }

    private void SetAllyForm(int slot, int formIdx)
    {
        State.Allies[slot].FormIndex = formIdx;
    }

    private void OnAllyStageChange(int slot, string stat, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            State.Allies[slot].Stages[stat] = val;
        }
    }

    private void OnEnemyStageChange(int target, string stat, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            State.Enemies[target].Stages[stat] = val;
        }
    }

    private void OnEnemyHp(int target, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            State.Enemies[target].ManualStats["hp"] = val;
        }
    }

    private void OnEnemyDef(int target, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            State.Enemies[target].ManualStats["def"] = val;
        }
    }

    private void OnEnemySpd(int target, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            State.Enemies[target].ManualStats["spd"] = val;
        }
    }
}