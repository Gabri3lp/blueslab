                                                                {
                                                                    <span class="badge bg-dark border border-secondary text-secondary py-0" style="font-size: 0.62rem;" title="Single-target move only hits the targeted opponent">Not Targeted</span>
                                                                }
                                                            </div>

                                                            <!-- Damage & HP Damage Percentage Dealt -->
                                                            <div class="d-flex align-items-baseline justify-content-center gap-1">
                                                                <span class="fs-5 fw-bold @(isTargetedEnemy || teamResult.IsAoE ? "text-warning" : "text-secondary")">@dmg.AvgDamage.ToString("N0")</span>
