    private List<string> GetStageGimmickWarnings(MoveItem move, CombatantState opp)
    {
        var warnings = new List<string>();
        if (State.ActiveFight?.Rules == null || State.ActiveFight.Rules.Count == 0) return warnings;

        foreach (var rule in State.ActiveFight.Rules)
        {
            if (rule.Contains("status condition or interference", StringComparison.OrdinalIgnoreCase))
            {
                bool hasStatus = !string.IsNullOrEmpty(opp.StatusCondition);
                bool hasInterference = opp.VolatileStatus.GetValueOrDefault("confused", false) ||
                                       opp.VolatileStatus.GetValueOrDefault("trapped", false) ||
                                       opp.VolatileStatus.GetValueOrDefault("flinching", false);
                if (!hasStatus && !hasInterference)
                {
                    warnings.Add("Target is unaffected by status or interference! Deals 0 damage in this stage until afflicted.");
                }
            }

            if (rule.Contains("not supereffective", StringComparison.OrdinalIgnoreCase) ||
                rule.Contains("not super effective", StringComparison.OrdinalIgnoreCase))
            {
                bool isSE = !string.IsNullOrEmpty(opp.Weakness) && string.Equals(move.Type, opp.Weakness, StringComparison.OrdinalIgnoreCase);
                if (!isSE)
                {
                    warnings.Add("Move is not super effective! Deals 0 damage in this stage.");
                }
            }
        }
        return warnings;
    }
