                                                                @if (!teamResult.IsAoE && !isTargetedEnemy)
                                                                {
                                                                    <span class="text-muted">(If targeted: @dmg.AvgHpPercent.ToString("0.0")% &bull; Leaves @dmg.RemainingHpPercent.ToString("0.0")% HP)</span>
                                                                }
                                                                else
                                                                {
                                                                    <span>@dmg.MinHpPercent.ToString("0.0")% - @dmg.MaxHpPercent.ToString("0.0")% &bull; Leaves @dmg.RemainingHpPercent.ToString("0.0")% HP</span>
                                                                }
