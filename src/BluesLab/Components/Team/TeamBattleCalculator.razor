                                                                <div class="progress-bar @(dmg.RemainingHpPercent <= 25 ? "bg-danger" : (dmg.RemainingHpPercent <= 50 ? "bg-warning" : "bg-success")) @(!teamResult.IsAoE && !isTargetedEnemy ? "opacity-50" : "")"
                                                                     role="progressbar"
                                                                     style="width: @Math.Min(100, Math.Max(0, dmg.RemainingHpPercent))%;"></div>
                                                            </div>

                                                            @if (dmg.IsOHKO || dmg.RemainingHpPercent <= 0)
                                                            {
                                                                <div class="mt-1">
                                                                    <span class="badge bg-danger text-white py-0" style="font-size: 0.68rem;">
                                                                        <i class="bi bi-skull-fill me-1"></i>OHKO
                                                                    </span>
