@using BluesLab.Models
@using BluesLab.Services
@using BluesLab.Components.Modals
@using BluesLab.Components.HexGrid
@inject SyncPairDataService DataService
@inject DamageCalculatorService CalcService
@inject StageService StageSvc
@inject GridStateService GridState
@inject TeamConfigurationService TeamConfigSvc
@implements IDisposable

<div class="team-calculator-container p-2 p-md-3">
    <!-- Top Stage & Battle Conditions Bar (Compact Full Width) -->
    <div class="card bg-dark border-secondary shadow-sm mb-3">
        <div class="card-header bg-secondary bg-opacity-25 border-secondary d-flex justify-content-between align-items-center flex-wrap gap-2 py-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-trophy-fill text-warning fs-5"></i>
                <span class="fw-bold text-light fs-5">@Loc.T("team_battle_simulator", "3v3 Team Battle Simulator")</span>
                <span class="badge bg-danger">@(State.ActiveFight != null ? State.ActiveFight.Title : (_leagues.FirstOrDefault(l => l.LeagueId == State.SelectedLeagueId)?.Name ?? "Pasio Battle"))</span>
            </div>

            <!-- Team Actions: My Teams, Save, Share, Compare, Reset -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button class="btn btn-sm btn-outline-info d-inline-flex align-items-center gap-1"
                        @onclick="() => _showSavedTeamsModal = true"
                        title="@Loc.T("saved_teams", "My Teams")">
                    <i class="bi bi-folder2-open"></i>
                    <span>@Loc.T("saved_teams", "My Teams")</span>
                    @if (_savedTeamsCount > 0)
                    {
                        <span class="badge bg-info text-dark py-0 px-1" style="font-size: 0.68rem;">@_savedTeamsCount</span>
                    }
                </button>

                <button class="btn btn-sm btn-outline-warning d-inline-flex align-items-center gap-1"
                        @onclick="() => _showSavedTeamsModal = true"
                        title="@Loc.T("save_team", "Save Team")">
                    <i class="bi bi-save2"></i>
                    <span>@Loc.T("save_team", "Save Team")</span>
                </button>

                <button class="btn btn-sm btn-warning text-dark fw-bold d-inline-flex align-items-center gap-1"
                        @onclick="() => _showShareModal = true"
                        title="@Loc.T("share_team", "Share Team")">
                    <i class="bi bi-share-fill"></i>
                    <span>@Loc.T("share_team", "Share Team")</span>
                </button>

                <button class="btn btn-sm btn-outline-light d-inline-flex align-items-center gap-1"
                        @onclick="OpenCompare"
                        title="@Loc.T("compare", "Compare Configurations")">
                    <i class="bi bi-speedometer2"></i>
                    <span>@Loc.T("compare", "Compare")</span>
                </button>

                <button class="btn btn-sm btn-outline-danger py-1 px-2"
                        @onclick="ResetTeam"
                        title="@Loc.T("reset_team", "Reset Team")">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </button>
            </div>
        </div>

        <div class="card-body p-3">
            <!-- Stage Category Tabs & Selection -->
            <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom border-secondary border-opacity-50">
                <button type="button" class="btn btn-sm @(_stageCategory == "gym" ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light")"
                        @onclick='() => SetStageCategory("gym")'>
                    <i class="bi bi-shield-shaded me-1"></i>Pasio Gym
                </button>
                <button type="button" class="btn btn-sm @(_stageCategory == "tower" ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light")"
                        @onclick='() => SetStageCategory("tower")'>
                    <i class="bi bi-building me-1"></i>Type Towers
                </button>
                <button type="button" class="btn btn-sm @(_stageCategory == "ultimate" ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light")"
                        @onclick='() => SetStageCategory("ultimate")'>
                    <i class="bi bi-lightning-charge-fill me-1"></i>Ultimate Battles
                </button>
            </div>

            @if (_stageCategory == "gym")
            {
                <div class="row g-2 align-items-center mb-2">
                    <div class="col-md-6">
                        <label class="form-label small text-muted mb-1"><i class="bi bi-diagram-3-fill text-warning me-1"></i> @Loc.T("circuit_tier", "Circuit / Tier:")</label>
                        <select class="form-select form-select-sm bg-dark text-light border-secondary" value="@State.SelectedLeagueId" @onchange="OnLeagueChanged">
                            @foreach (var l in _leagues)
                            {
                                <option value="@l.LeagueId">@l.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small text-muted mb-1"><i class="bi bi-swords text-danger me-1"></i> @Loc.T("battle", "Battle:")</label>
                        <select class="form-select form-select-sm bg-dark text-light border-secondary" value="@State.SelectedFightId" @onchange="OnFightChanged">
                            @{
                                var currentLeague = _leagues.FirstOrDefault(l => l.LeagueId == State.SelectedLeagueId);
                                if (currentLeague != null)
                                {
                                    @foreach (var f in currentLeague.Fights)
                                    {
                                        <option value="@f.FightId">@f.Title</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                </div>
            }
            else if (_stageCategory == "tower")
            {
                <div class="row g-2 align-items-center mb-2">
                    <div class="col-md-6">
                        <label class="form-label small text-muted mb-1"><i class="bi bi-fire text-warning me-1"></i> Type Tower:</label>
                        <select class="form-select form-select-sm bg-dark text-light border-secondary" value="@_selectedTowerType" @onchange="OnTowerTypeChanged">
                            @foreach (var t in _towerStages)
                            {
                                <option value="@t.Type">@Loc.GetTypeName(t.Type) Tower</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small text-muted mb-1"><i class="bi bi-layer-forward text-info me-1"></i> Floor:</label>
                        <select class="form-select form-select-sm bg-dark text-light border-secondary" value="@_selectedTowerFloor" @onchange="OnTowerFloorChanged">
                            @{
                                var towerObj = _towerStages.FirstOrDefault(t => t.Type.Equals(_selectedTowerType, StringComparison.OrdinalIgnoreCase));
                                if (towerObj != null)
                                {
                                    @foreach (var fl in towerObj.Floors)
                                    {
                                        <option value="@fl.Floor">@fl.FloorName - @fl.Fight.Title</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                </div>
            }
            else if (_stageCategory == "ultimate")
            {
                <div class="row g-2 align-items-center mb-2">
                    <div class="col-12">
                        <label class="form-label small text-muted mb-1"><i class="bi bi-lightning-charge text-danger me-1"></i> Ultimate Battle Stage:</label>
                        @if (_ultimateStages.Count > 0)
                        {
                            <select class="form-select form-select-sm bg-dark text-light border-secondary" value="@State.SelectedFightId" @onchange="OnUltimateStageChanged">
                                @foreach (var f in _ultimateStages)
                                {
                                    <option value="@f.FightId">@f.Title</option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="p-2 rounded bg-black bg-opacity-25 border border-secondary border-opacity-50 text-muted small">
                                <i class="bi bi-info-circle me-1"></i> No Ultimate Battles added yet. Stages will appear here once configured in <code>ultimate_stages.json</code>.
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Active Stage Rules & Themes Card -->
            @if (State.ActiveFight != null)
            {
                <div class="p-2 mb-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-75 small">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <span class="badge bg-warning text-dark fw-bold">@Loc.T("leader", "Leader:"): @State.ActiveFight.Leader</span>
                        <span class="badge type-badge type-@State.ActiveFight.StageType.ToLowerInvariant()">@Loc.GetTypeName(State.ActiveFight.StageType)</span>
                        @if (!string.IsNullOrEmpty(State.ActiveFight.Theme) && !State.ActiveFight.Theme.Equals("No rules", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge bg-secondary"><i class="bi bi-info-circle me-1"></i>@Loc.T("theme", "Theme:"): @State.ActiveFight.Theme</span>
                        }
                    </div>
                    @if (State.ActiveFight.Rules.Count > 0)
                    {
                        <div class="d-flex flex-column gap-1 mt-1">
                            @foreach (var r in State.ActiveFight.Rules)
                            {
                                <div class="text-warning-emphasis d-flex align-items-center gap-1" style="font-size: 0.78rem;">
                                    <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                                    <span>@r</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <!-- Global Field Conditions (Weather, Terrain, Zone) -->
            <div class="row g-2 pt-2 border-top border-secondary align-items-center">
                <!-- Weather -->
                <div class="col-12 col-md-4">
                    <label class="form-label small text-muted mb-1">@Loc.T("weather", "Weather:")</label>
                    <div class="input-group input-group-sm">
                        <select class="form-select bg-dark text-light border-secondary py-0" style="font-size: 0.75rem;" @bind="State.Field.Weather" @bind:after="() => { if (string.IsNullOrEmpty(State.Field.Weather)) State.Field.WeatherEx = false; StateHasChanged(); }">
                            <option value="">@Loc.T("weather_none", "None (Normal)")</option>
                            <option value="Sunny">@Loc.T("weather_sunny", "Sunny ☀️")</option>
                            <option value="Rainy">@Loc.T("weather_rainy", "Rainy 🌧️")</option>
                            <option value="Sandstorm">@Loc.T("weather_sandstorm", "Sandstorm 🏜️")</option>
                            <option value="Hail">@Loc.T("weather_hail", "Hail ❄️")</option>
                        </select>
                        <button class="btn py-0 px-2 @(State.Field.WeatherEx && !string.IsNullOrEmpty(State.Field.Weather) ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light")"
                                style="font-size: 0.75rem;"
                                disabled="@string.IsNullOrEmpty(State.Field.Weather)"
                                title="@(string.IsNullOrEmpty(State.Field.Weather) ? "Select a Weather first to enable EX" : "Toggle Weather EX")"
                                @onclick="() => { State.Field.WeatherEx = !State.Field.WeatherEx; StateHasChanged(); }">EX</button>
                    </div>
                </div>

                <!-- Terrain -->
                <div class="col-12 col-md-4">
                    <label class="form-label small text-muted mb-1">@Loc.T("terrain", "Terrain:")</label>
                    <div class="input-group input-group-sm">
                        <select class="form-select bg-dark text-light border-secondary py-0" style="font-size: 0.75rem;" @bind="State.Field.Terrain" @bind:after="() => { if (string.IsNullOrEmpty(State.Field.Terrain)) State.Field.TerrainEx = false; StateHasChanged(); }">
                            <option value="">@Loc.T("terrain_none", "None")</option>
                            <option value="Electric Terrain">@Loc.T("terrain_electric", "Electric Terrain ⚡")</option>
                            <option value="Grassy Terrain">@Loc.T("terrain_grassy", "Grassy Terrain 🌿")</option>
                            <option value="Psychic Terrain">@Loc.T("terrain_psychic", "Psychic Terrain 🔮")</option>
                        </select>
                        <button class="btn py-0 px-2 @(State.Field.TerrainEx && !string.IsNullOrEmpty(State.Field.Terrain) ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light")"
                                style="font-size: 0.75rem;"
                                disabled="@string.IsNullOrEmpty(State.Field.Terrain)"
                                title="@(string.IsNullOrEmpty(State.Field.Terrain) ? "Select a Terrain first to enable EX" : "Toggle Terrain EX")"
                                @onclick="() => { State.Field.TerrainEx = !State.Field.TerrainEx; StateHasChanged(); }">EX</button>
                    </div>
                </div>

                <!-- Zone -->
                <div class="col-12 col-md-4">
                    <label class="form-label small text-muted mb-1">@Loc.T("zone", "Zone:")</label>
                    <div class="input-group input-group-sm">
                        <select class="form-select bg-dark text-light border-secondary py-0" style="font-size: 0.75rem;" @bind="State.Field.Zone" @bind:after="() => { if (string.IsNullOrEmpty(State.Field.Zone)) State.Field.ZoneEx = false; StateHasChanged(); }">
                            <option value="">@Loc.T("zone_none", "None")</option>
                            @foreach (var z in CombatantState.ValidZoneTypes)
                            {
                                <option value="@($"{z} Zone")">@Loc.GetTypeName(z) @Loc.T("zone", "Zone")</option>
                            }
                        </select>
                        <button class="btn py-0 px-2 @(State.Field.ZoneEx && !string.IsNullOrEmpty(State.Field.Zone) ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light")"
                                style="font-size: 0.75rem;"
                                disabled="@string.IsNullOrEmpty(State.Field.Zone)"
                                title="@(string.IsNullOrEmpty(State.Field.Zone) ? "Select a Zone first to enable EX" : "Toggle Zone EX")"
                                @onclick="() => { State.Field.ZoneEx = !State.Field.ZoneEx; StateHasChanged(); }">EX</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2-COLUMN FULLSCREEN LAYOUT (Left = Grid & Config, Right = Damage Calculations) -->
    <div class="row g-3">
        <!-- ==================== LEFT COLUMN: GRID (ON TOP WHEN ACTIVE) + TEAMS ==================== -->
        <div class="col-12 col-xl-6">
            <!-- Sync Grid Placed on Top of Left Column When Configuring Pair -->
            @if (_showInlineGrid && State.ActiveAttacker.Pair != null)
            {
                <div class="card bg-dark border-secondary shadow-sm mb-3">
                    <div class="card-header bg-secondary bg-opacity-25 border-secondary py-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-diagram-3-fill text-warning fs-5"></i>
                            <div>
                                <span class="fw-bold text-light fs-6">
                                    @Loc.T("grid", "Sync Grid"): @Loc.GetDisplayName(State.ActiveAttacker.Pair)
                                </span>
                                <span class="badge bg-primary ms-2" style="font-size: 0.72rem;">@string.Format(Loc.T("slot_active", "Slot {0} Active"), State.ActiveAttackerIndex + 1)</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <!-- Quick Slot Switcher inside Grid -->
                            <div class="btn-group btn-group-sm me-1">
                                @for (int s = 0; s < 3; s++)
                                {
                                    int slot = s;
                                    var ally = State.Allies[slot];
                                    if (ally.Pair != null)
                                    {
                                        <button class="btn btn-sm py-0 px-2 @(State.ActiveAttackerIndex == slot ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light")"
                                                style="font-size: 0.72rem; height: 26px;"
                                                title="@string.Format(Loc.T("slot", "Slot {0}"), slot + 1): @Loc.GetDisplayName(ally.Pair)"
                                                @onclick="() => State.ActiveAttackerIndex = slot">
                                            @string.Format(Loc.T("slot", "Slot {0}"), slot + 1)
                                        </button>
                                    }
                                }
                            </div>

                            <div class="form-check form-switch me-1 d-flex align-items-center gap-1 mb-0" title="Toggle Hard Cap (adjacency restriction)">
                                <input class="form-check-input cursor-pointer" type="checkbox" role="switch" id="teamInlineHardCap"
                                       checked="@GridState.HardCap"
                                       @onchange="(e) => { GridState.HardCap = (bool)(e.Value ?? true); StateHasChanged(); }" />
                                <label class="form-check-label text-secondary small select-none cursor-pointer" for="teamInlineHardCap" style="font-size: 0.75rem;">@Loc.T("hard_cap", "Hard Cap")</label>
                            </div>
                            <button class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 0.75rem; height: 26px;"
                                    @onclick="() => { GridState.ResetGrid(State.ActiveAttacker.Pair, State.ActiveAttacker.MoveLevel, State.AllyActiveGrids[State.ActiveAttackerIndex]); StateHasChanged(); }"
                                    title="@Loc.T("reset_grid", "Reset Grid")">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>@Loc.T("reset", "Reset")
                            </button>
                            <button class="btn btn-outline-warning btn-sm py-0 px-2" style="font-size: 0.75rem; height: 26px;"
                                    @onclick="() => OpenGridModal(State.ActiveAttackerIndex)"
                                    title="Open Fullscreen Grid Modal">
                                <i class="bi bi-arrows-fullscreen me-1"></i>@Loc.T("expand", "Expand")
                            </button>
                            <button class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size: 0.75rem; height: 26px;"
                                    @onclick="() => _showInlineGrid = false"
                                    title="Close Sync Grid and return to Ally Side">
                                <i class="bi bi-x-lg me-1"></i>@Loc.T("close_grid", "Close Grid")
                            </button>
                        </div>
                    </div>

                    <div class="card-body p-0 position-relative overflow-hidden" style="height: 520px; background-color: #0b0f19;">
                        <HexGridView Pair="State.ActiveAttacker.Pair"
                                     MoveLevel="State.ActiveAttacker.MoveLevel"
                                     MoveLevelChanged="(newLevel) => { State.ActiveAttacker.MoveLevel = Math.Min(newLevel, 5); State.ActiveAttacker.SuperAwakeningLevel = newLevel > 5 ? newLevel - 5 : 0; StateHasChanged(); }"
                                     ActiveCells="State.AllyActiveGrids[State.ActiveAttackerIndex]"
                                     OnGridChanged="StateHasChanged" />
                    </div>
                </div>
            }
            else
            {
                <!-- Allied Team (3 Slots) with Circles & Screens -->
                <div class="card bg-dark border-secondary shadow-sm mb-3">
                <div class="card-header bg-secondary bg-opacity-25 border-secondary py-2 px-3">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div>
                            <h6 class="text-success fw-bold mb-0 d-flex align-items-center gap-2">
                                <i class="bi bi-people-fill"></i> @Loc.T("ally_side", "Ally Side")
                            </h6>
                        </div>

                        <!-- Allied Team Field Effects: Sync Buffs, Screens & Battle Circles -->
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <!-- Ally Sync Buff (Icon only, no shield) -->
                            <div class="d-flex align-items-center gap-1 bg-dark px-2 rounded border border-secondary" style="height: 24px; overflow: hidden;" title="Ally Sync Buffs">
                                <img src="img/sync_icon.png" alt="Sync" style="width: 16px; height: 16px; object-fit: contain;" />
                                <input type="number" min="0" max="9" class="sync-buff-input"
                                       @bind="State.AllySyncBuffs" @bind:after="StateHasChanged" />
                                <span class="small text-warning fw-bold" style="font-size: 0.72rem;">×@(1.0 + State.AllySyncBuffs * 0.5)</span>
                            </div>

                            <!-- Allied Screens -->
                            <div class="d-flex align-items-center gap-1">
                                <span class="text-info fw-bold me-1" style="font-size: 0.72rem;"><i class="bi bi-shield"></i> @Loc.T("screens", "Screens:")</span>
                                <button class="btn btn-sm py-0 px-2 d-inline-flex align-items-center justify-content-center @(State.AlliedPhysicalDamageReduction ? "btn-warning fw-bold text-dark" : "btn-outline-secondary text-light")"
                                        style="font-size: 0.72rem; height: 24px;"
                                        title="@Loc.T("screen_reflect", "Reflect")"
                                        @onclick="() => State.AlliedPhysicalDamageReduction = !State.AlliedPhysicalDamageReduction">
                                    <img src="img/battle/icon_physicaldamagereduction.png" alt="Phys" style="height: 16px; width: 16px; object-fit: contain;" />
                                </button>
                                <button class="btn btn-sm py-0 px-2 d-inline-flex align-items-center justify-content-center @(State.AlliedSpecialDamageReduction ? "btn-warning fw-bold text-dark" : "btn-outline-secondary text-light")"
                                        style="font-size: 0.72rem; height: 24px;"
                                        title="@Loc.T("screen_light_screen", "Light Screen")"
                                        @onclick="() => State.AlliedSpecialDamageReduction = !State.AlliedSpecialDamageReduction">
                                    <img src="img/battle/icon_specialdamagereduction.png" alt="Spec" style="height: 16px; width: 16px; object-fit: contain;" />
                                </button>
                            </div>

                            <!-- Cheer & Move Gauge Accel -->
                            <div class="d-flex align-items-center gap-1">
                                <button class="btn btn-sm py-0 px-2 d-inline-flex align-items-center gap-1 @(State.Cheer ? "btn-danger fw-bold" : "btn-outline-secondary text-light")"
                                        style="font-size: 0.72rem; height: 24px;"
                                        title="@Loc.T("cheer", "Cheer (+50% Move & Sync Power)")"
                                        @onclick="() => State.Cheer = !State.Cheer">
                                    <i class="bi bi-megaphone-fill"></i>
                                    <span>@Loc.T("cheer", "Cheer (+50%)")</span>
                                </button>
                                <button class="btn btn-sm py-0 px-2 d-inline-flex align-items-center justify-content-center @(State.AlliedMoveGaugeAccel ? "btn-info text-dark fw-bold" : "btn-outline-secondary text-light")"
                                        style="font-size: 0.72rem; height: 24px;"
                                        title="@Loc.T("move_gauge_accel", "Move Gauge Acceleration")"
                                        @onclick="() => State.AlliedMoveGaugeAccel = !State.AlliedMoveGaugeAccel">
                                    <img src="img/battle/icon_acceleration.png" alt="MGA" style="height: 16px; width: 16px; object-fit: contain;" />
                                </button>
                            </div>

                            <!-- Team Gear Button -->
                            <button class="btn btn-outline-warning btn-sm py-0 px-2 d-inline-flex align-items-center gap-1" style="font-size: 0.72rem; height: 24px;" @onclick="() => _showTeamGearModal = true">
                                <i class="bi bi-backpack2"></i> @Loc.T("gears", "Gear")
                            </button>

                            <!-- Battle Circles Modal Button -->
                            <div class="d-flex align-items-center gap-1">
                                <button class="btn btn-outline-info btn-sm py-0 px-2 d-inline-flex align-items-center gap-1" style="font-size: 0.72rem; height: 24px;" @onclick="() => _showCircleModal = true">
                                    <i class="bi bi-circle-square"></i> @Loc.T("regional_circles", "Circles") @(State.GetActiveCirclesCount() > 0 ? $"({State.GetActiveCirclesCount()})" : "")
                                </button>
                                @if (State.GetActiveCirclesCount() > 0)
                                {
                                    <button class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 0.7rem; height: 24px;" @onclick="() => { State.ClearAllCircles(); StateHasChanged(); }">
                                        @Loc.T("clear", "Clear")
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Active Circles Badges -->
                    @if (State.GetActiveCirclesCount() > 0)
                    {
                        <div class="d-flex flex-wrap gap-1 align-items-center mt-2 pt-2 border-top border-secondary border-opacity-50">
                            <span class="small text-info fw-bold d-flex align-items-center gap-1" style="font-size: 0.72rem;">
                                <i class="bi bi-circle-square"></i> @Loc.T("regional_circles", "Circles"):
                            </span>
                            @foreach (var r in CombatantState.CircleRegions)
                            {
                                int allies = State.GetCircleBuffLevel(r);
                                if (State.IsCircleActive(r, "physical"))
                                {
                                    <span class="badge bg-danger text-light d-inline-flex align-items-center gap-1 shadow-sm" style="font-size: 0.72rem;">
                                        @r @Loc.T("circle_phys", "Phys") (+@(10 + 10 * allies)%)
                                        <i class="bi bi-x-circle-fill opacity-75 ms-1 cursor-pointer" title="@Loc.T("remove_pair", "Remove")" @onclick='() => State.ToggleCircle(r, "physical")'></i>
                                    </span>
                                }
                                if (State.IsCircleActive(r, "special"))
                                {
                                    <span class="badge bg-primary text-light d-inline-flex align-items-center gap-1 shadow-sm" style="font-size: 0.72rem;">
                                        @r @Loc.T("circle_spec", "Spec") (+@(10 + 10 * allies)%)
                                        <i class="bi bi-x-circle-fill opacity-75 ms-1 cursor-pointer" title="@Loc.T("remove_pair", "Remove")" @onclick='() => State.ToggleCircle(r, "special")'></i>
                                    </span>
                                }
                                if (State.IsCircleActive(r, "defensive"))
                                {
                                    <span class="badge bg-success text-light d-inline-flex align-items-center gap-1 shadow-sm" style="font-size: 0.72rem;">
                                        @r @Loc.T("circle_def", "Def") (+@(5 + 5 * allies)%)
                                        <i class="bi bi-x-circle-fill opacity-75 ms-1 cursor-pointer" title="@Loc.T("remove_pair", "Remove")" @onclick='() => State.ToggleCircle(r, "defensive")'></i>
                                    </span>
                                }
                            }
                        </div>
                    }
                </div>

                <!-- 3 Ally Slots Row -->
                <div class="card-body p-2">
                    <div class="row g-2">
                        @for (int i = 0; i < 3; i++)
                        {
                            int slotIndex = i;
                            var ally = State.Allies[slotIndex];
                            bool isAttacker = State.ActiveAttackerIndex == slotIndex;
                            bool isGridOpenForThis = _showInlineGrid && isAttacker;

                            <div class="col-12 col-md-4">
                                <div class="card h-100 @(isAttacker ? "border-primary bg-primary bg-opacity-10 shadow-sm" : "border-secondary bg-dark") p-2">
                                    <!-- Slot Header -->
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="badge @(isAttacker ? "bg-primary" : "bg-secondary")" style="font-size: 0.7rem;">@string.Format(Loc.T("slot", "Slot {0}"), slotIndex + 1)</span>
                                            @if (isAttacker)
                                            {
                                                <span class="badge bg-warning text-dark" style="font-size: 0.68rem;"><i class="bi bi-lightning-fill"></i> @Loc.T("attacking", "Attacking")</span>
                                            }
                                        </div>
                                        <button class="btn btn-sm py-0 px-2 @(isAttacker ? "btn-primary fw-bold" : "btn-outline-secondary text-light")" style="font-size: 0.72rem; height: 22px;" @onclick="() => SetActiveAttacker(slotIndex)">
                                            @(isAttacker ? Loc.T("selected", "Selected") : Loc.T("select", "Select"))
                                        </button>
                                    </div>

                                    <!-- Sync Pair Avatar & Info -->
                                    @if (ally.Pair == null)
                                    {
                                        <div class="my-2 text-center">
                                            <button class="btn btn-outline-warning w-100 py-3 d-flex flex-column align-items-center gap-1 border-dashed"
                                                    @onclick="() => OpenPairPicker(slotIndex)">
                                                <i class="bi bi-person-plus-fill fs-4 text-warning"></i>
                                                <span class="small fw-bold">@Loc.T("choose_pair", "Choose Pair")</span>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex gap-2 align-items-center mb-2 p-1 rounded bg-black bg-opacity-30 border border-secondary border-opacity-50">
                                            <img src="@ally.Pair.IconUrl" alt="@Loc.GetDisplayName(ally.Pair)" class="rounded-circle border border-warning" style="width: 38px; height: 38px; object-fit: cover;" onerror="this.src='img/trainers/unknown.png';" />
                                            <div class="flex-grow-1 overflow-hidden">
                                                <div class="fw-bold text-light text-truncate" style="font-size: 0.78rem;" title="@Loc.GetDisplayName(ally.Pair)">@Loc.GetDisplayName(ally.Pair)</div>
                                                <div class="d-flex gap-1 align-items-center flex-wrap" style="font-size: 0.68rem;">
                                                    <span class="badge type-badge type-@ally.Pair.Type.ToLowerInvariant() py-0">@Loc.GetTypeName(ally.Pair.Type)</span>
                                                    <span class="badge bg-secondary py-0">@Loc.GetRoleName(ally.Pair.Role)</span>
                                                    @if (!string.IsNullOrEmpty(ally.Pair.ExRole) && ally.HasExRole)
                                                    {
                                                        <span class="badge bg-indigo py-0">EX: @Loc.GetRoleName(ally.Pair.ExRole)</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="d-flex gap-1 align-items-center">
                                                <button class="btn btn-sm btn-outline-warning p-1" style="height: 24px; width: 24px; font-size: 0.7rem; line-height: 1;" title="@Loc.T("change_pair", "Change Pair")" @onclick="() => OpenPairPicker(slotIndex)">
                                                    <i class="bi bi-arrow-repeat"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger p-1" style="height: 24px; width: 24px; font-size: 0.7rem; line-height: 1;" title="@Loc.T("remove_pair", "Remove Pair")" @onclick="() => RemoveAllyPair(slotIndex)">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Master Passives Active on this Pair -->
                                        @if (CalcService.GetMasterPassivesForPair(ally.Pair, _rules).Count > 0)
                                        {
                                            <div class="d-flex flex-wrap gap-1 mb-1">
                                                @foreach (var mp in CalcService.GetMasterPassivesForPair(ally.Pair, _rules))
                                                {
                                                    int matching = State.GetMasterPassiveAllyCount(mp.Theme, ownerIndex: slotIndex);
                                                    int pct = (int)Math.Round(mp.PowerUpForAdditionalAllies(matching) * 100);
                                                    int totalTheme = matching + 1;
                                                    int mpId = ally.Pair.Passives.FirstOrDefault(p => p.Name.Contains(mp.PassiveName, StringComparison.OrdinalIgnoreCase))?.Id ?? 0;
                                                    string mpTitle = Loc.GetPassiveName(mpId, mp.PassiveName);
                                                    <span class="badge bg-purple text-light d-inline-flex align-items-center gap-1 py-0 px-1" style="font-size: 0.65rem; max-width: 100%;" title="@mpTitle: +@pct% to team (@totalTheme @mp.Theme pair@(totalTheme > 1 ? "s" : "") on team: 1 base + @matching other @(matching == 1 ? "ally" : "allies"))">
                                                        <i class="bi bi-star-fill text-warning flex-shrink-0"></i>
                                                        <span class="text-truncate">@mpTitle</span>
                                                        <span class="flex-shrink-0">(+@pct%)</span>
                                                    </span>
                                                }
                                            </div>
                                        }

                                        <!-- Form Tabs -->
                                        @if (ally.Pair.Variations.Count > 0 || ally.Pair.HasMega || ally.Pair.HasTera)
                                        {
                                            <div class="btn-group btn-group-sm w-100 mb-1">
                                                <button class="btn btn-sm py-0 @(ally.FormIndex == 0 ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light")" style="font-size: 0.7rem; height: 20px;" @onclick="() => SetAllyForm(slotIndex, 0)">@Loc.T("base", "Base")</button>
                                                @for (int vIdx = 0; vIdx < ally.Pair.Variations.Count; vIdx++)
                                                {
                                                    int fIdx = vIdx + 1;
                                                    var v = ally.Pair.Variations[vIdx];
                                                    string formLabel = (v.FormId == 4 || v.FormName == "Form 4") ? "DMax" : v.FormName;
                                                    <button class="btn btn-sm py-0 @(ally.FormIndex == fIdx ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light")" style="font-size: 0.7rem; height: 20px;" @onclick="() => SetAllyForm(slotIndex, fIdx)">@formLabel</button>
                                                }
                                            </div>
                                        }

                                        <!-- Quick Level & Star Controls -->
                                        <div class="row g-1 mb-1 small">
                                            <div class="col-4">
                                                <label class="text-muted mb-0" style="font-size: 0.68rem;">@Loc.T("level", "Move Lv:")</label>
                                                <select class="form-select form-select-sm bg-dark text-light border-secondary py-0 px-1" style="font-size: 0.7rem; height: 22px;" @bind="ally.MoveLevel">
                                                    @for (int m = 1; m <= 5; m++)
                                                    {
                                                        <option value="@m">@m/5</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-4">
                                                <label class="text-muted mb-0" style="font-size: 0.68rem;">@Loc.T("stars", "Stars:")</label>
                                                <select class="form-select form-select-sm bg-dark text-light border-secondary py-0 px-1" style="font-size: 0.7rem; height: 22px;" @bind="ally.StarLevel">
                                                    <option value="3★">3★</option>
                                                    <option value="4★">4★</option>
                                                    <option value="5★">5★</option>
                                                    <option value="5★ 20/20">5★ 20/20</option>
                                                    @if (ally.Pair.HasEx)
                                                    {
                                                        <option value="5★ EX">5★ EX</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-4">
                                                <label class="text-muted mb-0" style="font-size: 0.68rem;">@Loc.T("char_level", "Level:")</label>
                                                <select class="form-select form-select-sm bg-dark text-light border-secondary py-0 px-1" style="font-size: 0.7rem; height: 22px;" @bind="ally.CharLevel">
                                                    <option value="120">120</option>
                                                    <option value="130">130</option>
                                                    <option value="140">140</option>
                                                    <option value="150">150</option>
                                                    <option value="180">180</option>
                                                    <option value="200">200</option>
                                                </select>
                                            </div>
                                            @if (ally.Pair.HasSuperAwakening)
                                            {
                                                <div class="col-6">
                                                    <label class="text-danger mb-0" style="font-size: 0.68rem;">@Loc.T("super_awakening", "Super Awakening:")</label>
                                                    <select class="form-select form-select-sm bg-dark text-light border-danger py-0 px-1" style="font-size: 0.7rem; height: 22px;" @bind="ally.SuperAwakeningLevel">
                                                        @for (int sa = 0; sa <= 5; sa++)
                                                        {
                                                            <option value="@sa">@(sa == 0 ? "SA: None" : $"SA Lv. {sa}")</option>
                                                        }
                                                    </select>
                                                </div>
                                            }
                                            @if (ally.Pair.HasEx && !string.IsNullOrEmpty(ally.Pair.ExRole))
                                            {
                                                <div class="@(ally.Pair.HasSuperAwakening ? "col-6" : "col-12")">
                                                    <label class="text-muted mb-0" style="font-size: 0.68rem;">@Loc.T("ex_role", "EX Role:")</label>
                                                    <button class="btn btn-sm w-100 py-0 @(ally.HasExRole ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light")" @onclick="() => ally.HasExRole = !ally.HasExRole" style="font-size: 0.7rem; height: 22px;">
                                                        @(ally.HasExRole ? Loc.T("ex_role_on", "EX Role ON") : Loc.T("ex_role_off", "EX Role OFF"))
                                                    </button>
                                                </div>
                                            }
                                        </div>

                                        <!-- Lucky Skill -->
                                        <div class="mb-1">
                                            <select class="form-select form-select-sm bg-dark text-light border-secondary py-0 px-1" style="font-size: 0.7rem; height: 22px;" @bind="ally.LuckySkillName">
                                                <option value="">@Loc.T("lucky_skill", "Lucky Skill: (None)")</option>
                                                @foreach (var ls in _rules.LuckySkills.Where(s => s.IsAvailableFor(ally.Pair.Role, ally.Pair.DisplayName)))
                                                {
                                                    <option value="@ls.Name">@ls.Name</option>
                                                }
                                            </select>
                                        </div>

                                        <!-- Stat Stages Dropdowns (-6 to +6) -->
                                        <div class="bg-black bg-opacity-25 p-1 rounded border border-secondary mb-1">
                                            <div class="row row-cols-4 g-1">
                                                @foreach (var stat in new[] { "atk", "def", "spa", "spd", "spe", "acc", "eva", "crit" })
                                                {
                                                    int defaultVal = stat == "crit" ? 3 : ((stat == "acc" || stat == "eva") ? 0 : 6);
                                                    int val = ally.Stages.GetValueOrDefault(stat, defaultVal);
                                                    int maxStage = stat == "crit" ? 3 : 6;
                                                    int minStage = stat == "crit" ? 0 : -6;
                                                    <div class="col">
                                                        <div class="d-flex align-items-center justify-content-between p-0 px-1 rounded bg-dark border border-secondary" style="height: 22px;">
                                                            <span class="text-light fw-bold text-uppercase flex-shrink-0" style="font-size: 0.65rem; min-width: 22px;">@stat</span>
                                                            <select class="form-select form-select-sm bg-dark text-light border-0 py-0 px-0 text-center font-monospace"
                                                                    style="width: 30px; font-size: 0.7rem; height: 20px; font-weight: 600; background-image: none !important; -webkit-appearance: none; -moz-appearance: none; appearance: none;"
                                                                    value="@val"
                                                                    @onchange="(ev) => OnAllyStageChange(slotIndex, stat, ev)">
                                                                @for (int stg = maxStage; stg >= minStage; stg--)
                                                                {
                                                                    <option value="@stg">@(stg > 0 ? $"+{stg}" : stg.ToString())</option>
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <!-- Next Boosts (PM, SM, SY, Crit, SE Next) -->
                                        <div class="bg-black bg-opacity-25 p-1 rounded border border-secondary mb-1">
                                            <div class="d-flex flex-wrap align-items-center gap-1">
                                                <div class="d-flex align-items-center gap-1 bg-dark px-1 rounded border border-secondary" style="font-size: 0.68rem; height: 22px;" title="Physical Moves ↑ Next (PMUN)">
                                                    <img src="img/battle/icon_boost_physical.png" alt="PM" style="height: 16px; width: 16px; object-fit: contain;" />
                                                    <select class="form-select form-select-sm bg-dark text-light border-0 py-0 px-0 text-center font-monospace"
                                                            style="width: 24px; font-size: 0.7rem; height: 20px; font-weight: 600; background-image: none !important; -webkit-appearance: none; -moz-appearance: none; appearance: none;"
                                                            @bind="ally.PhysicalBoostNext">
                                                        @for (int b = 0; b <= 10; b++) { <option value="@b">@b</option> }
                                                    </select>
                                                </div>
                                                <div class="d-flex align-items-center gap-1 bg-dark px-1 rounded border border-secondary" style="font-size: 0.68rem; height: 22px;" title="Special Moves ↑ Next (SMUN)">
                                                    <img src="img/battle/icon_boost_special.png" alt="SM" style="height: 16px; width: 16px; object-fit: contain;" />
                                                    <select class="form-select form-select-sm bg-dark text-light border-0 py-0 px-0 text-center font-monospace"
                                                            style="width: 24px; font-size: 0.7rem; height: 20px; font-weight: 600; background-image: none !important; -webkit-appearance: none; -moz-appearance: none; appearance: none;"
                                                            @bind="ally.SpecialBoostNext">
                                                        @for (int b = 0; b <= 10; b++) { <option value="@b">@b</option> }
                                                    </select>
                                                </div>
                                                <div class="d-flex align-items-center gap-1 bg-dark px-1 rounded border border-secondary" style="font-size: 0.68rem; height: 22px;" title="Sync Move ↑ Next (SYUN)">
                                                    <img src="img/battle/icon_boost_sync.png" alt="SY" style="height: 16px; width: 16px; object-fit: contain;" />
                                                    <select class="form-select form-select-sm bg-dark text-light border-0 py-0 px-0 text-center font-monospace"
                                                            style="width: 24px; font-size: 0.7rem; height: 20px; font-weight: 600; background-image: none !important; -webkit-appearance: none; -moz-appearance: none; appearance: none;"
                                                            @bind="ally.SyncMoveBoostNext">
                                                        @for (int b = 0; b <= 10; b++) { <option value="@b">@b</option> }
                                                    </select>
                                                </div>
                                                <button class="btn btn-sm py-0 px-1 @(ally.IsCriticalMove ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light")" style="font-size: 0.68rem; height: 22px;" @onclick="() => ally.IsCriticalMove = !ally.IsCriticalMove">@Loc.T("crit", "Crit")</button>
                                                <button class="btn btn-sm py-0 px-1 @(ally.SuperEffectiveNext ? "btn-danger text-white fw-bold" : "btn-outline-secondary text-light")" style="font-size: 0.68rem; height: 22px;" @onclick="() => ally.SuperEffectiveNext = !ally.SuperEffectiveNext">@Loc.T("se_next", "SE Next")</button>
                                            </div>
                                        </div>

                                        <!-- Grid Button (Places Grid at top of Left Column) -->
                                        <div class="d-flex justify-content-end align-items-center pt-1 border-top border-secondary border-opacity-50">
                                            <button class="btn btn-sm py-0 px-2 @(isGridOpenForThis ? "btn-warning text-dark fw-bold" : "btn-outline-warning")"
                                                    style="font-size: 0.72rem; height: 22px;"
                                                    @onclick="() => ToggleConfigureGrid(slotIndex)">
                                                <i class="bi bi-diagram-3 me-1"></i>@(isGridOpenForThis ? Loc.T("close_grid", "Close Grid") : Loc.T("grid", "Grid"))
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

            <!-- Enemy Side with Shared Screens and Damage Field -->
            <div class="card bg-dark border-secondary shadow-sm mb-3">
                <div class="card-header bg-secondary bg-opacity-25 border-secondary py-2 px-3">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div>
                            <h6 class="text-danger fw-bold mb-0 d-flex align-items-center gap-2">
                                <i class="bi bi-shield-shaded"></i> @Loc.T("enemy_side", "Enemy Side")
                            </h6>
                        </div>

                        <!-- Enemy Shared Screens, Damage Field & Sync Buff -->
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <!-- Enemy Sync Buff (Icon only, no shield) -->
                            <div class="d-flex align-items-center gap-1 bg-dark px-2 rounded border border-secondary" style="height: 24px; overflow: hidden;" title="@Loc.T("turn_sync_buff", "Enemy Sync Buffs")">
                                <img src="img/sync_icon.png" alt="Sync" style="width: 16px; height: 16px; object-fit: contain; filter: hue-rotate(180deg) saturate(2);" />
                                <input type="number" min="0" max="9" class="sync-buff-input"
                                       @bind="State.EnemySyncBuffs" @bind:after="StateHasChanged" />
                                <span class="small text-danger fw-bold" style="font-size: 0.72rem;">×@(1.0 + State.EnemySyncBuffs * 0.5)</span>
                            </div>

                            <!-- Enemy Screens -->
                            <div class="d-flex align-items-center gap-1">
                                <span class="text-danger fw-bold me-1" style="font-size: 0.72rem;"><i class="bi bi-shield"></i> @Loc.T("screens", "Screens:")</span>
                                <button class="btn btn-sm py-0 px-2 d-inline-flex align-items-center justify-content-center @(State.EnemyPhysicalDamageReduction ? "btn-warning fw-bold text-dark" : "btn-outline-secondary text-light")"
                                        style="font-size: 0.72rem; height: 24px;"
                                        title="@Loc.T("screen_reflect", "Physical Damage Reduction (Reflect) for all enemies")"
                                        @onclick="() => State.EnemyPhysicalDamageReduction = !State.EnemyPhysicalDamageReduction">
                                    <img src="img/battle/icon_physicaldamagereduction.png" alt="Phys" style="height: 16px; width: 16px; object-fit: contain;" />
                                </button>
                                <button class="btn btn-sm py-0 px-2 d-inline-flex align-items-center justify-content-center @(State.EnemySpecialDamageReduction ? "btn-warning fw-bold text-dark" : "btn-outline-secondary text-light")"
                                        style="font-size: 0.72rem; height: 24px;"
                                        title="@Loc.T("screen_light_screen", "Special Damage Reduction (Light Screen) for all enemies")"
                                        @onclick="() => State.EnemySpecialDamageReduction = !State.EnemySpecialDamageReduction">
                                    <img src="img/battle/icon_specialdamagereduction.png" alt="Spec" style="height: 16px; width: 16px; object-fit: contain;" />
                                </button>
                                <button class="btn btn-sm py-0 px-2 d-inline-flex align-items-center justify-content-center @(State.EnemyMoveGaugeAccel ? "btn-warning fw-bold text-dark" : "btn-outline-secondary text-light")"
                                        style="font-size: 0.72rem; height: 24px;"
                                        title="@Loc.T("move_gauge_accel", "Move Gauge Acceleration")"
                                        @onclick="() => State.EnemyMoveGaugeAccel = !State.EnemyMoveGaugeAccel">
                                    <img src="img/battle/icon_acceleration.png" alt="MGA" style="height: 16px; width: 16px; object-fit: contain;" />
                                </button>
                            </div>

                            <!-- Enemy Damage Field -->
                            <div class="d-flex align-items-center gap-1">
                                <span class="text-danger fw-bold" style="font-size: 0.72rem;"><i class="bi bi-crosshair"></i> @Loc.T("damage_field", "Damage Field:")</span>
                                <select class="form-select form-select-sm bg-dark text-light border-secondary py-0" style="min-width: 145px; width: auto; font-size: 0.72rem; height: 24px;" @bind="State.EnemyDamageField" @bind:after="StateHasChanged">
                                    <option value="">@Loc.T("damage_field_0", "None")</option>
                                    @foreach (var t in CombatantState.AllTypes)
                                    {
                                        <option value="@t">@Loc.GetTypeName(t)</option>
                                    }
                                </select>
                            </div>

                            <!-- Apply to All Button -->
                            <button class="btn btn-sm btn-outline-danger py-0 px-2 d-inline-flex align-items-center gap-1 fw-bold"
                                    style="font-size: 0.72rem; height: 24px;"
                                    title="@Loc.T("apply_settings_all_enemies", "Configure and apply settings to opponents")"
                                    @onclick="OpenApplyToAllModal">
                                <i class="bi bi-check2-all"></i>
                                <span>@Loc.T("apply_to_all", "Apply to All")</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 3 Enemy Targets Row -->
                <div class="card-body p-2">
                    <div class="row g-2">
                        @for (int i = 0; i < 3; i++)
                        {
                            int targetIndex = i;
                            var enemy = State.Enemies[targetIndex];
                            bool isTarget = State.ActiveTargetIndex == targetIndex;
                            string slotLabel = targetIndex switch { 0 => Loc.T("enemy_left", "Left Enemy"), 1 => Loc.T("enemy_center", "Center (Boss)"), _ => Loc.T("enemy_right", "Right Enemy") };
                            string displayTrainer = string.IsNullOrEmpty(enemy.CustomTrainerName) ? slotLabel : enemy.CustomTrainerName;
                            string displayPokemon = string.IsNullOrEmpty(enemy.CustomPokemonName) ? "" : enemy.CustomPokemonName;

                            <div class="col-12 col-md-4">
                                <div class="card h-100 @(isTarget ? "border-danger bg-danger bg-opacity-10 shadow-sm" : "border-secondary bg-dark") p-2">
                                    <!-- Enemy Header -->
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <button type="button"
                                                class="badge @(isTarget ? "bg-danger text-white border-0 shadow-sm" : "bg-secondary text-light border-0") cursor-pointer py-1 px-2 d-inline-flex align-items-center gap-1"
                                                style="font-size: 0.72rem;"
                                                title="@(isTarget ? Loc.T("slot_active", "Active Target") : Loc.T("target", "Click to set as target"))"
                                                @onclick="() => State.ActiveTargetIndex = targetIndex">
                                            @if (isTarget)
                                            {
                                                <i class="bi bi-crosshair"></i>
                                            }
                                            <span>@slotLabel</span>
                                        </button>
                                        @if (isTarget)
                                        {
                                            <i class="bi bi-crosshair text-danger fs-6" title="@Loc.T("target", "Target")"></i>
                                        }
                                    </div>

                                    <!-- Visual Header -->
                                    <div class="d-flex align-items-center gap-2 mb-1 p-1 rounded bg-black bg-opacity-25 border border-secondary border-opacity-50">
                                        @if (!string.IsNullOrEmpty(enemy.CustomIconUrl))
                                        {
                                            <img src="@enemy.CustomIconUrl" alt="" class="rounded-circle border border-danger" style="width: 36px; height: 36px; object-fit: cover;" onerror="this.src='img/trainers/unknown.png';" />
                                        }
                                        <div class="flex-grow-1 overflow-hidden">
                                            <div class="fw-bold text-light text-truncate" style="font-size: 0.78rem;" title="@displayTrainer">@displayTrainer</div>
                                            <div class="text-muted text-truncate" style="font-size: 0.7rem;">@displayPokemon</div>
                                        </div>
                                        <span class="badge type-badge type-@enemy.Weakness.ToLowerInvariant() py-0" style="font-size: 0.68rem;">@Loc.T("weak", "Weak"): @Loc.GetTypeName(enemy.Weakness)</span>
                                    </div>

                                    <!-- Enemy Stats Summary (Weakness, HP, Def, SpD) -->
                                    <div class="row g-1 mb-1 small">
                                        <div class="col-6">
                                            <label class="text-muted mb-0" style="font-size: 0.68rem;">@Loc.T("weakness", "Weakness"):</label>
                                            <select class="form-select form-select-sm bg-dark text-light border-secondary py-0 px-1" style="font-size: 0.7rem; height: 22px;" @bind="enemy.Weakness">
                                                @foreach (var t in CombatantState.AllTypes)
                                                {
                                                    <option value="@t">@Loc.GetTypeName(t)</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-6">
                                            <label class="text-muted mb-0" style="font-size: 0.68rem;">@Loc.T("hp", "Max HP"):</label>
                                            <input type="number" class="form-control form-control-sm bg-dark text-light border-secondary py-0 px-1" style="font-size: 0.7rem; height: 22px;" value="@enemy.ManualStats.GetValueOrDefault("hp", 2000)" @onchange="@(ev => OnEnemyHp(targetIndex, ev))" />
                                        </div>
                                        <div class="col-6">
                                            <label class="text-muted mb-0" style="font-size: 0.68rem;">@Loc.T("defense", "Defense"):</label>
                                            <input type="number" class="form-control form-control-sm bg-dark text-light border-secondary py-0 px-1" style="font-size: 0.7rem; height: 22px;" value="@enemy.ManualStats.GetValueOrDefault("def", 100)" @onchange="@(ev => OnEnemyDef(targetIndex, ev))" />
                                        </div>
                                        <div class="col-6">
                                            <label class="text-muted mb-0" style="font-size: 0.68rem;">@Loc.T("sp_def", "Sp. Def"):</label>
                                            <input type="number" class="form-control form-control-sm bg-dark text-light border-secondary py-0 px-1" style="font-size: 0.7rem; height: 22px;" value="@enemy.ManualStats.GetValueOrDefault("spd", 100)" @onchange="@(ev => OnEnemySpd(targetIndex, ev))" />
                                        </div>
                                    </div>

                                    <!-- Mitigations (Clean Def Mit & SpD Mit) -->
                                    <div class="row g-1 mb-1 small">
                                        <div class="col-6">
                                            <div class="d-flex align-items-center justify-content-between p-1 rounded bg-black bg-opacity-25 border border-secondary">
                                                <span class="text-secondary fw-bold" style="font-size: 0.68rem;" title="Physical Def debuff mitigation (0-9)">@Loc.T("def_mit", "Def Mit:")</span>
                                                <select class="form-select form-select-sm bg-dark text-light border-0 py-0 px-1 text-center font-monospace"
                                                        style="width: 30px; font-size: 0.7rem; height: 20px; font-weight: 600; background-image: none !important; -webkit-appearance: none; -moz-appearance: none; appearance: none;"
                                                        value="@enemy.Mitigations.GetValueOrDefault("def", 5)"
                                                        @onchange='(ev) => { if (int.TryParse(ev.Value?.ToString(), out int v)) { enemy.Mitigations["def"] = v; StateHasChanged(); } }'>
                                                    @for (int m = 0; m <= 9; m++)
                                                    {
                                                        <option value="@m">@m</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="d-flex align-items-center justify-content-between p-1 rounded bg-black bg-opacity-25 border border-secondary">
                                                <span class="text-secondary fw-bold" style="font-size: 0.68rem;" title="Special SpD debuff mitigation (0-9)">@Loc.T("spd_mit", "SpD Mit:")</span>
                                                <select class="form-select form-select-sm bg-dark text-light border-0 py-0 px-1 text-center font-monospace"
                                                        style="width: 30px; font-size: 0.7rem; height: 20px; font-weight: 600; background-image: none !important; -webkit-appearance: none; -moz-appearance: none; appearance: none;"
                                                        value="@enemy.Mitigations.GetValueOrDefault("spd", 5)"
                                                        @onchange='(ev) => { if (int.TryParse(ev.Value?.ToString(), out int v)) { enemy.Mitigations["spd"] = v; StateHasChanged(); } }'>
                                                    @for (int m = 0; m <= 9; m++)
                                                    {
                                                        <option value="@m">@m</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Debuffs / Stages (-6 to +6) -->
                                    <div class="bg-black bg-opacity-25 p-1 rounded border border-secondary mb-1 small">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="text-light fw-bold" style="font-size: 0.68rem;">@Loc.T("turn_stat", "Debuffs"):</span>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-danger py-0 px-1" style="font-size: 0.62rem; height: 18px;" @onclick="() => SetAllEnemyDebuffs(targetIndex, -6)">@Loc.T("set_all_debuffs_6", "All -6")</button>
                                                <button class="btn btn-outline-secondary py-0 px-1" style="font-size: 0.62rem; height: 18px;" @onclick="() => SetAllEnemyDebuffs(targetIndex, 0)">@Loc.T("reset_grid", "Reset 0")</button>
                                            </div>
                                        </div>
                                        <div class="row row-cols-4 g-1">
                                            @foreach (var stat in new[] { "def", "spd", "spe", "atk", "spa", "acc", "eva" })
                                            {
                                                int defaultVal = (stat == "acc" || stat == "eva") ? 0 : -6;
                                                int val = enemy.Stages.GetValueOrDefault(stat, defaultVal);
                                                <div class="col">
                                                    <div class="d-flex align-items-center justify-content-between p-0 px-1 rounded bg-dark border border-secondary" style="height: 22px;">
                                                        <span class="text-light fw-bold text-uppercase flex-shrink-0" style="font-size: 0.65rem; min-width: 22px;">@stat</span>
                                                        <select class="form-select form-select-sm bg-dark text-light border-0 py-0 px-0 text-center font-monospace"
                                                                style="width: 30px; font-size: 0.7rem; height: 20px; font-weight: 600; background-image: none !important; -webkit-appearance: none; -moz-appearance: none; appearance: none;"
                                                                value="@val"
                                                                @onchange="(ev) => OnEnemyStageChange(targetIndex, stat, ev)">
                                                            @for (int s = 6; s >= -6; s--)
                                                            {
                                                                <option value="@s">@(s > 0 ? $"+{s}" : s.ToString())</option>
                                                            }
                                                        </select>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Status & Interference -->
                                    <div class="bg-black bg-opacity-25 p-1 rounded border border-secondary mb-1 small">
                                        <div class="d-flex align-items-center gap-1 mb-1">
                                            <select class="form-select form-select-sm bg-dark text-light border-secondary py-0 px-1" style="font-size: 0.7rem; height: 22px;" @bind="enemy.StatusCondition">
                                                <option value="">Status: @Loc.T("weather_none", "None")</option>
                                                <option value="burned">Burned 🔥</option>
                                                <option value="paralyzed">Paralyzed ⚡</option>
                                                <option value="poisoned">Poisoned ☠️</option>
                                                <option value="badly poisoned">Badly Poisoned 🟣</option>
                                                <option value="asleep">Asleep 💤</option>
                                                <option value="frozen">Frozen ❄️</option>
                                            </select>
                                        </div>
                                        <div class="d-flex flex-wrap align-items-center gap-1">
                                            <button class="btn btn-sm py-0 px-1 @(enemy.VolatileStatus.GetValueOrDefault("confused", false) ? "btn-warning fw-bold text-dark" : "btn-outline-secondary text-light")"
                                                    style="font-size: 0.68rem; height: 20px;" title="@Loc.T("confused", "Confused")"
                                                    @onclick='() => enemy.VolatileStatus["confused"] = !enemy.VolatileStatus.GetValueOrDefault("confused", false)'>
                                                <img src="img/battle/SCTP_001.png" alt="" style="height: 14px; width: 14px; object-fit: contain;" />
                                            </button>
                                            <button class="btn btn-sm py-0 px-1 @(enemy.VolatileStatus.GetValueOrDefault("trapped", false) ? "btn-warning fw-bold text-dark" : "btn-outline-secondary text-light")"
                                                    style="font-size: 0.68rem; height: 20px;" title="@Loc.T("trapped", "Trapped")"
                                                    @onclick='() => enemy.VolatileStatus["trapped"] = !enemy.VolatileStatus.GetValueOrDefault("trapped", false)'>
                                                <img src="img/battle/SCTP_004.png" alt="" style="height: 14px; width: 14px; object-fit: contain;" />
                                            </button>
                                            <button class="btn btn-sm py-0 px-1 @(enemy.VolatileStatus.GetValueOrDefault("flinching", false) ? "btn-warning fw-bold text-dark" : "btn-outline-secondary text-light")"
                                                    style="font-size: 0.68rem; height: 20px;" title="@Loc.T("flinch", "Flinching")"
                                                    @onclick='() => enemy.VolatileStatus["flinching"] = !enemy.VolatileStatus.GetValueOrDefault("flinching", false)'>
                                                <img src="img/battle/SCTP_002.png" alt="" style="height: 14px; width: 14px; object-fit: contain;" />
                                            </button>
                                            <button class="btn btn-sm py-0 px-1 @(enemy.PhysicalBreak ? "btn-pink fw-bold" : "btn-outline-secondary text-light")"
                                                    style="font-size: 0.68rem; height: 20px;" title="@Loc.T("phys_break", "Phys Break")"
                                                    @onclick="() => enemy.PhysicalBreak = !enemy.PhysicalBreak">
                                                <img src="img/battle/break_phys.png" alt="" style="height: 14px; width: 14px; object-fit: contain;" />
                                            </button>
                                            <button class="btn btn-sm py-0 px-1 @(enemy.SpecialBreak ? "btn-pink fw-bold" : "btn-outline-secondary text-light")"
                                                    style="font-size: 0.68rem; height: 20px;" title="@Loc.T("spec_break", "Spec Break")"
                                                    @onclick="() => enemy.SpecialBreak = !enemy.SpecialBreak">
                                                <img src="img/battle/break_spec.png" alt="" style="height: 14px; width: 14px; object-fit: contain;" />
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Rebuff Section -->
                                    <div class="mt-1 pt-1 border-top border-secondary border-opacity-50 small">
                                        <div class="d-flex flex-wrap align-items-center gap-1 mb-1">
                                            @{
                                                int rebuffCount = enemy.EnemyTypeRebuffs.Count(kv => kv.Value != 0);
                                            }
                                            <button class="btn btn-sm btn-outline-danger py-0 px-2 d-inline-flex align-items-center gap-1" style="font-size: 0.68rem; height: 22px;"
                                                    @onclick="() => OpenRebuffModal(targetIndex)">
                                                <i class="bi bi-shield-slash"></i> @Loc.T("rebuffs", "Rebuff")@(rebuffCount > 0 ? $" ({rebuffCount})" : "")
                                            </button>
                                            @if (enemy.EnemyTypeRebuffs.Any(kv => kv.Value != 0))
                                            {
                                                <button class="btn btn-outline-secondary py-0 px-1" style="font-size: 0.62rem; height: 22px;" @onclick="() => ClearEnemyRebuffs(targetIndex)">
                                                    @Loc.T("clear", "Clear")
                                                </button>
                                            }
                                        </div>

                                        <!-- Active Rebuff Chips -->
                                        @if (enemy.EnemyTypeRebuffs.Any(kv => kv.Value != 0))
                                        {
                                            <div class="d-flex flex-wrap gap-1 align-items-center">
                                                @foreach (var (t, val) in enemy.EnemyTypeRebuffs.Where(kv => kv.Value != 0))
                                                {
                                                    string tName = t;
                                                    int rVal = val;
                                                    <span class="badge type-badge type-@tName.ToLowerInvariant() d-inline-flex align-items-center gap-1 shadow-sm py-0 px-1" style="font-size: 0.68rem;" title="@Loc.GetTypeName(tName) Rebuff @rVal">
                                                        <img src="@CombatantState.GetTypeIcon(tName)" alt="" width="12" height="12" />
                                                        <b class="text-warning">@(rVal > 0 ? $"+{rVal}" : rVal.ToString())</b>
                                                        <i class="bi bi-x ms-1 cursor-pointer" title="@Loc.T("clear", "Remove")" @onclick="() => enemy.EnemyTypeRebuffs[tName] = 0"></i>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ==================== RIGHT COLUMN: DAMAGE CALCULATIONS ==================== -->
        <div class="col-12 col-xl-6">
            @if (State.ActiveAttacker.Pair != null)
            {
                <div>
                    <div class="card bg-dark border-secondary shadow-sm mb-3">
                        <div class="card-header bg-secondary bg-opacity-25 border-secondary d-flex justify-content-between align-items-center flex-wrap gap-2 py-2">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-graph-up text-warning fs-5"></i>
                                <span class="fw-bold text-light fs-6">
                                    @Loc.T("damage_calculations", "Damage Outputs"): @Loc.GetDisplayName(State.ActiveAttacker.Pair)
                                </span>
                            </div>
                        </div>

                        <div class="card-body p-2 p-md-3">
                            <div class="d-flex flex-column gap-3">
                                @{
                                    var allAttackerMoves = State.ActiveAttacker.Pair.Moves
                                        .Concat(CalcService.GetMaxMoves(State.ActiveAttacker.Pair))
                                        .Where(m => !m.Category.Equals("Status", StringComparison.OrdinalIgnoreCase) && int.TryParse(m.Power, out int p) && p > 0)
                                        .ToList();
                                    var normalAttackerMoves = allAttackerMoves.Where(m => !m.IsMax).ToList();
                                    var maxAttackerMoves = allAttackerMoves.Where(m => m.IsMax).ToList();
                                }

                                @foreach (var move in normalAttackerMoves)
                                {
                                    var teamResult = CalcService.CalculateTeamDamage(move, State, _rules);
                                    string cleanMoveName = LocalizationService.CleanTitle(Loc.GetMoveName(move.Id, move.Name));
                                    string effMoveType = CalcService.GetEffectiveMoveType(State.ActiveAttacker.Pair, move, State.ActiveAttacker.FormIndex);

                                    <div class="card move-card move-card-@effMoveType.ToLowerInvariant() p-3">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <div class="fw-bold text-light fs-6">@cleanMoveName</div>
                                                <div class="d-flex gap-1 align-items-center mt-1 flex-wrap">
                                                    <span class="badge type-badge type-@effMoveType.ToLowerInvariant()">@Loc.GetTypeName(effMoveType)</span>
                                                    <span class="badge bg-secondary">@Loc.T(move.Category.ToLowerInvariant(), move.Category)</span>
                                                    @if (move.IsSync)
                                                    {
                                                        <span class="badge bg-purple">@Loc.T("turn_sync_move", "Sync Move")</span>
                                                    }
                                                    @if (teamResult.IsAoE)
                                                    {
                                                        <span class="badge bg-info text-dark"><i class="bi bi-broadcast me-1"></i>@Loc.T("aoe_all_targets", "AoE (All Targets)")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-dark border border-secondary text-secondary">@Loc.T("single_target", "Single Target")</span>
                                                    }
                                                    @if (move.MaxUses > 0)
                                                    {
                                                        <span class="badge" style="background-color: rgba(56, 189, 248, 0.2); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.5); font-weight: 600;">
                                                            <i class="bi bi-arrow-repeat me-0.5"></i>@move.MaxUses @(move.MaxUses == 1 ? Loc.T("use", "Use") : Loc.T("uses", "Uses"))
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Triple Enemy Breakdown with Dealt % and Health Bar -->
                                        <div class="row g-2 mt-1">
                                            @for (int eIdx = 0; eIdx < 3; eIdx++)
                                            {
                                                int slot = eIdx;
                                                var dmg = slot switch
                                                {
                                                    0 => teamResult.LeftDamage,
                                                    1 => teamResult.CenterDamage,
                                                    _ => teamResult.RightDamage
                                                };
                                                var opp = State.Enemies[slot];
                                                bool isTargetedEnemy = State.ActiveTargetIndex == slot;
                                                string slotTitle = slot switch { 0 => Loc.T("enemy_left", "Left Enemy"), 1 => Loc.T("enemy_center", "Center (Boss)"), _ => Loc.T("enemy_right", "Right Enemy") };
                                                string oppName = string.IsNullOrEmpty(opp.CustomTrainerName) ? slotTitle : $"{opp.CustomTrainerName}";

                                                <div class="col-md-4">
                                                    <div class="p-2 rounded border @(isTargetedEnemy ? "border-warning bg-warning bg-opacity-10 shadow-sm" : (teamResult.IsAoE ? "border-secondary bg-black bg-opacity-25" : "border-secondary bg-black bg-opacity-10 opacity-50")) text-center">
                                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                                            <span class="small text-light fw-bold text-truncate" style="font-size: 0.78rem;">@oppName</span>
                                                            @if (teamResult.IsAoE)
                                                            {
                                                                <span class="badge bg-info text-dark py-0" style="font-size: 0.65rem;">@Loc.T("aoe_hit", "AoE Hit")</span>
                                                            }
                                                        </div>

                                                        <!-- Damage & HP Damage Percentage Dealt -->
                                                        <div class="damage-roll-hover-wrapper d-inline-block">
                                                            <div class="d-flex align-items-baseline justify-content-center gap-1 cursor-pointer">
                                                                <span class="fs-5 fw-bold @(isTargetedEnemy || teamResult.IsAoE ? "text-warning" : "text-secondary")">@dmg.AvgDamage.ToString("N0")</span>
                                                                <span class="fw-bold @(isTargetedEnemy || teamResult.IsAoE ? (dmg.AvgHpPercent >= 100 ? "text-danger" : (dmg.AvgHpPercent >= 50 ? "text-warning" : "text-info")) : "text-muted")" style="font-size: 0.95rem;">
                                                                    (@dmg.AvgHpPercent.ToString("0.0")%)
                                                                </span>
                                                            </div>
                                                            <div class="damage-roll-popover">
                                                                <div class="damage-roll-title">
                                                                    <i class="bi bi-dice-5-fill text-warning me-1"></i>@Loc.T("damage_rolls", "Damage Rolls") @(dmg.IsCritical ? "(Crit)" : "")
                                                                </div>
                                                                <table class="damage-roll-table">
                                                                    <tbody>
                                                                        @foreach (var roll in dmg.GetDetailedRolls(opp.ManualStats.GetValueOrDefault("hp", 2000)))
                                                                        {
                                                                            <tr>
                                                                                <td class="roll-label">Roll @roll.RollIndex (@(roll.MultiplierFactor.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))x)</td>
                                                                                <td class="roll-dmg">@roll.Damage.ToString("N0")</td>
                                                                                <td class="roll-pct">@roll.HpPercent.ToString("0.0")%</td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>

                                                        <!-- Min - Max Damage Range & Remaining HP -->
                                                        <div class="small text-secondary" style="font-size: 0.72rem;">
                                                            @if (!teamResult.IsAoE && !isTargetedEnemy)
                                                            {
                                                                <span class="text-muted">@Loc.Format("if_targeted", "(If targeted: {0}% • Leaves {1}% HP)", dmg.AvgHpPercent.ToString("0.0"), dmg.RemainingHpPercent.ToString("0.0"))</span>
                                                            }
                                                            else
                                                            {
                                                                <span>@dmg.MinHpPercent.ToString("0.0")% - @dmg.MaxHpPercent.ToString("0.0")% &bull; @Loc.Format("leaves_hp", "Leaves {0}% HP", dmg.RemainingHpPercent.ToString("0.0"))</span>
                                                            }
                                                        </div>

                                                        <!-- Health Bar: Blue for remaining HP, Red for damage dealt -->
                                                        <div class="progress mt-1" style="height: 7px; background-color: rgba(255,255,255,0.1); border-radius: 3px; overflow: hidden;">
                                                            @{
                                                                double remHp = Math.Clamp(dmg.RemainingHpPercent, 0.0, 100.0);
                                                                double dealtHp = Math.Clamp(100.0 - remHp, 0.0, 100.0);
                                                                string barOpacity = (!teamResult.IsAoE && !isTargetedEnemy) ? "opacity-40" : "";
                                                            }
                                                            <div class="progress-bar bg-primary @barOpacity"
                                                                 role="progressbar"
                                                                 style="width: @(remHp.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;"
                                                                 title="Remaining HP: @remHp.ToString("0.0")%"></div>
                                                            <div class="progress-bar bg-danger @barOpacity"
                                                                 role="progressbar"
                                                                 style="width: @(dealtHp.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;"
                                                                 title="Damage Dealt: @dmg.AvgHpPercent.ToString("0.0")%"></div>
                                                        </div>

                                                        @if (dmg.IsOHKO || dmg.RemainingHpPercent <= 0)
                                                        {
                                                            <div class="mt-1">
                                                                <span class="badge bg-danger text-white py-0" style="font-size: 0.68rem;">
                                                                    <i class="bi bi-skull-fill me-1"></i>@Loc.T("ohko", "OHKO")
                                                                </span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <!-- Breakdown Multiplier Pills for Active Target -->
                                        @if (teamResult.ActiveTargetDamage.Breakdown.Count > 0)
                                        {
                                            <details class="damage-breakdown-details mt-2">
                                                <summary>
                                                    <span class="d-inline-flex align-items-center gap-1">
                                                        <i class="bi bi-funnel-fill text-info" style="font-size: 0.75rem;"></i>
                                                        <span>@Loc.T("damage_modifiers", "Damage Modifiers") (@teamResult.ActiveTargetDamage.Breakdown.Count)</span>
                                                    </span>
                                                    <i class="bi bi-chevron-down details-chevron"></i>
                                                </summary>
                                                <div class="d-flex flex-wrap gap-1 mt-1">
                                                    @foreach (var pill in teamResult.ActiveTargetDamage.Breakdown)
                                                    {
                                                        <span class="badge" style="background-color: @pill.Color; font-size: 0.7rem;">
                                                            @pill.Label: @pill.Value
                                                        </span>
                                                    }
                                                </div>
                                            </details>
                                        }

                                        <!-- Stage Gimmick / Rules Warning (Purely Informational) -->
                                        @{
                                            var stageWarnings = GetStageGimmickWarnings(move, State.Enemies[State.ActiveTargetIndex]);
                                        }
                                        @if (stageWarnings.Count > 0)
                                        {
                                            <div class="mt-2 p-1 px-2 rounded bg-danger bg-opacity-25 border border-danger border-opacity-75 d-flex align-items-center gap-2" style="font-size: 0.72rem;">
                                                <i class="bi bi-exclamation-triangle-fill text-warning flex-shrink-0"></i>
                                                <div class="d-flex flex-column gap-0.5">
                                                    @foreach (var w in stageWarnings)
                                                    {
                                                        <span class="text-warning fw-bold">⚠️ @Loc.T("stage_rule", "Stage Rule:"): <span class="text-light fw-normal">@w</span></span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                @if (maxAttackerMoves.Count > 0)
                                {
                                    <div class="d-flex align-items-center justify-content-between gap-2 mt-3 pt-2 border-top border-secondary border-opacity-50">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge btn-pink text-white px-2 py-1" style="font-size: 0.8rem;">
                                                <i class="bi bi-clouds-fill me-1"></i> @Loc.T("turn_max_move", "Max Moves (Dynamax)")
                                            </span>
                                        </div>
                                        <span class="badge bg-secondary text-light" style="font-size: 0.7rem;">@maxAttackerMoves.Count @Loc.T("turn_power", "Available")</span>
                                    </div>

                                    @foreach (var move in maxAttackerMoves)
                                    {
                                        var teamResult = CalcService.CalculateTeamDamage(move, State, _rules);
                                        string cleanMaxName = LocalizationService.CleanTitle(Loc.GetMoveName(move.Id, move.Name));
                                        string effMaxType = CalcService.GetEffectiveMoveType(State.ActiveAttacker.Pair, move, State.ActiveAttacker.FormIndex);

                                        <div class="card move-card move-card-@effMaxType.ToLowerInvariant() p-3 border-pink">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div>
                                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                                        <span class="fw-bold text-light fs-6">@cleanMaxName</span>
                                                        <span class="badge btn-pink text-white">@Loc.T("turn_max_move", "Max Move")</span>
                                                    </div>
                                                    <div class="d-flex gap-1 align-items-center mt-1">
                                                        <span class="badge type-badge type-@effMaxType.ToLowerInvariant()">@Loc.GetTypeName(effMaxType)</span>
                                                        <span class="badge bg-secondary">@Loc.T(move.Category.ToLowerInvariant(), move.Category)</span>
                                                        @if (teamResult.IsAoE)
                                                        {
                                                            <span class="badge bg-info text-dark">@Loc.T("aoe_all_targets", "AoE / All Targets")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-dark border border-secondary text-secondary">@Loc.T("single_target", "Single Target")</span>
                                                        }
                                                        <span class="badge" style="background-color: rgba(232, 67, 147, 0.2); color: #ff79b0; border: 1px solid rgba(232, 67, 147, 0.5); font-weight: 600;">
                                                            <i class="bi bi-arrow-repeat me-0.5"></i>1 @Loc.T("turn_power", "Use")
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Triple Enemy Breakdown for Max Move -->
                                            <div class="row g-2 mt-1">
                                                @for (int eIdx = 0; eIdx < 3; eIdx++)
                                                {
                                                    int slot = eIdx;
                                                    var dmg = slot switch
                                                    {
                                                        0 => teamResult.LeftDamage,
                                                        1 => teamResult.CenterDamage,
                                                        _ => teamResult.RightDamage
                                                    };
                                                    var opp = State.Enemies[slot];
                                                    bool isTargetedEnemy = State.ActiveTargetIndex == slot;
                                                    string slotTitle = slot switch { 0 => Loc.T("enemy_left", "Left Enemy"), 1 => Loc.T("enemy_center", "Center (Boss)"), _ => Loc.T("enemy_right", "Right Enemy") };
                                                    string oppName = string.IsNullOrEmpty(opp.CustomTrainerName) ? slotTitle : $"{opp.CustomTrainerName}";

                                                    <div class="col-md-4">
                                                        <div class="p-2 rounded border @(isTargetedEnemy ? "border-warning bg-warning bg-opacity-10 shadow-sm" : (teamResult.IsAoE ? "border-secondary bg-black bg-opacity-25" : "border-secondary bg-black bg-opacity-10 opacity-50")) text-center">
                                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                                <span class="small text-light fw-bold text-truncate" style="font-size: 0.78rem;">@oppName</span>
                                                                @if (teamResult.IsAoE)
                                                                {
                                                                    <span class="badge bg-info text-dark py-0" style="font-size: 0.65rem;">@Loc.T("aoe_hit", "AoE Hit")</span>
                                                                }
                                                            </div>

                                                            <!-- Damage & HP Damage Percentage Dealt -->
                                                            <div class="damage-roll-hover-wrapper d-inline-block">
                                                                <div class="d-flex align-items-baseline justify-content-center gap-1 cursor-pointer">
                                                                    <span class="fs-5 fw-bold @(isTargetedEnemy || teamResult.IsAoE ? "text-warning" : "text-secondary")">@dmg.AvgDamage.ToString("N0")</span>
                                                                    <span class="fw-bold @(isTargetedEnemy || teamResult.IsAoE ? (dmg.AvgHpPercent >= 100 ? "text-danger" : (dmg.AvgHpPercent >= 50 ? "text-warning" : "text-info")) : "text-muted")" style="font-size: 0.95rem;">
                                                                        (@dmg.AvgHpPercent.ToString("0.0")%)
                                                                    </span>
                                                                </div>
                                                                <div class="damage-roll-popover">
                                                                    <div class="damage-roll-title">
                                                                        <i class="bi bi-dice-5-fill text-warning me-1"></i>@Loc.T("damage_rolls", "Damage Rolls") @(dmg.IsCritical ? "(Crit)" : "")
                                                                    </div>
                                                                    <table class="damage-roll-table">
                                                                        <tbody>
                                                                            @foreach (var roll in dmg.GetDetailedRolls(opp.ManualStats.GetValueOrDefault("hp", 2000)))
                                                                            {
                                                                                <tr>
                                                                                    <td class="roll-label">Roll @roll.RollIndex (@(roll.MultiplierFactor.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))x)</td>
                                                                                    <td class="roll-dmg">@roll.Damage.ToString("N0")</td>
                                                                                    <td class="roll-pct">@roll.HpPercent.ToString("0.0")%</td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            </div>

                                                            <!-- Min - Max Damage Range & Remaining HP -->
                                                            <div class="small text-secondary" style="font-size: 0.72rem;">
                                                                @if (!teamResult.IsAoE && !isTargetedEnemy)
                                                                {
                                                                    <span class="text-muted">@Loc.Format("if_targeted", "(If targeted: {0}% • Leaves {1}% HP)", dmg.AvgHpPercent.ToString("0.0"), dmg.RemainingHpPercent.ToString("0.0"))</span>
                                                                }
                                                                else
                                                                {
                                                                    <span>@dmg.MinHpPercent.ToString("0.0")% - @dmg.MaxHpPercent.ToString("0.0")% &bull; @Loc.Format("leaves_hp", "Leaves {0}% HP", dmg.RemainingHpPercent.ToString("0.0"))</span>
                                                                }
                                                            </div>

                                                            <!-- Health Bar: Blue for remaining HP, Red for damage dealt -->
                                                            <div class="progress mt-1" style="height: 7px; background-color: rgba(255,255,255,0.1); border-radius: 3px; overflow: hidden;">
                                                                @{
                                                                    double remHp = Math.Clamp(dmg.RemainingHpPercent, 0.0, 100.0);
                                                                    double dealtHp = Math.Clamp(100.0 - remHp, 0.0, 100.0);
                                                                    string barOpacity = (!teamResult.IsAoE && !isTargetedEnemy) ? "opacity-40" : "";
                                                                }
                                                                <div class="progress-bar bg-primary @barOpacity"
                                                                     role="progressbar"
                                                                     style="width: @(remHp.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;"
                                                                     title="Remaining HP: @remHp.ToString("0.0")%"></div>
                                                                <div class="progress-bar bg-danger @barOpacity"
                                                                     role="progressbar"
                                                                     style="width: @(dealtHp.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;"
                                                                     title="Damage Dealt: @dmg.AvgHpPercent.ToString("0.0")%"></div>
                                                            </div>

                                                            @if (dmg.IsOHKO || dmg.RemainingHpPercent <= 0)
                                                            {
                                                                <div class="mt-1">
                                                                    <span class="badge bg-danger text-white py-0" style="font-size: 0.68rem;">
                                                                        <i class="bi bi-skull-fill me-1"></i>@Loc.T("ohko", "OHKO")
                                                                    </span>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>

                                            <!-- Breakdown Multiplier Pills for Active Target -->
                                            @if (teamResult.ActiveTargetDamage.Breakdown.Count > 0)
                                            {
                                                <details class="damage-breakdown-details mt-2">
                                                    <summary>
                                                        <span class="d-inline-flex align-items-center gap-1">
                                                            <i class="bi bi-funnel-fill text-info" style="font-size: 0.75rem;"></i>
                                                            <span>@Loc.T("damage_modifiers", "Damage Modifiers") (@teamResult.ActiveTargetDamage.Breakdown.Count)</span>
                                                        </span>
                                                        <i class="bi bi-chevron-down details-chevron"></i>
                                                    </summary>
                                                    <div class="d-flex flex-wrap gap-1 mt-1">
                                                        @foreach (var pill in teamResult.ActiveTargetDamage.Breakdown)
                                                        {
                                                            <span class="badge" style="background-color: @pill.Color; font-size: 0.7rem;">
                                                                @pill.Label: @pill.Value
                                                            </span>
                                                        }
                                                    </div>
                                                </details>
                                            }

                                            <!-- Stage Gimmick / Rules Warning (Purely Informational) -->
                                            @{
                                                var stageWarnings = GetStageGimmickWarnings(move, State.Enemies[State.ActiveTargetIndex]);
                                            }
                                            @if (stageWarnings.Count > 0)
                                            {
                                                <div class="mt-2 p-1 px-2 rounded bg-danger bg-opacity-25 border border-danger border-opacity-75 d-flex align-items-center gap-2" style="font-size: 0.72rem;">
                                                    <i class="bi bi-exclamation-triangle-fill text-warning flex-shrink-0"></i>
                                                    <div class="d-flex flex-column gap-0.5">
                                                        @foreach (var w in stageWarnings)
                                                        {
                                                            <span class="text-warning fw-bold">⚠️ @Loc.T("stage_rule", "Stage Rule:"): <span class="text-light fw-normal">@w</span></span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Sync Pair Picker Modal -->
    <PairPickerModal @bind-IsOpen="_showPairPicker"
                     OnPairSelected="OnModalPairSelected" />

    <!-- Team Sync Grid Fullscreen Modal (Optional Expand) -->
    @if (_showGridModal && State.Allies.Count > _gridModalSlot && State.Allies[_gridModalSlot].Pair != null)
    {
        <TeamGridModal @bind-IsOpen="_showGridModal"
                       Pair="State.Allies[_gridModalSlot].Pair"
                       ActiveCells="State.AllyActiveGrids[_gridModalSlot]"
                       MoveLevel="State.Allies[_gridModalSlot].MoveLevel"
                       MoveLevelChanged="(newLevel) => { State.Allies[_gridModalSlot].MoveLevel = Math.Min(newLevel, 5); State.Allies[_gridModalSlot].SuperAwakeningLevel = newLevel > 5 ? newLevel - 5 : 0; StateHasChanged(); }"
                       OnGridChanged="StateHasChanged" />
    }

    <!-- Rebuff Modal for Enemies -->
    @if (_showRebuffModal && _rebuffModalSlot >= 0 && _rebuffModalSlot < State.Enemies.Count)
    {
        <RebuffModal @bind-IsOpen="_showRebuffModal"
                     Title="@_rebuffModalTitle"
                     Rebuffs="State.Enemies[_rebuffModalSlot].EnemyTypeRebuffs"
                     OnChanged="StateHasChanged" />
    }

    <!-- Apply Enemy Config Modal -->
    @if (_showApplyToAllModal)
    {
        <ApplyEnemyConfigModal @bind-IsOpen="_showApplyToAllModal"
                               Enemies="State.Enemies"
                               InitialSourceIndex="_applyToAllSourceIndex"
                               OnApplied="StateHasChanged" />
    }

    <!-- Share Team Modal -->
    <ShareTeamModal @bind-IsOpen="_showShareModal"
                    State="State"
                    OnConfigImported="OnConfigImportedHandler" />

    <!-- Saved Teams Modal -->
    <SavedTeamsModal @bind-IsOpen="_showSavedTeamsModal"
                     State="State"
                     OnLoadRequested="OnConfigImportedHandler"
                     OnCompareRequested="OnCompareRequestedHandler"
                     OnShareRequested="OnShareRequestedHandler" />

    <!-- Compare Teams Modal -->
    <CompareTeamsModal @bind-IsOpen="_showCompareModal"
                       State="State"
                       InitialTargetConfig="_compareTargetConfig"
                       Rules="_rules" />

    <!-- Regional Circle Modal -->
    <CircleModal @bind-IsOpen="_showCircleModal"
                 ActiveCircles="State.TeamCircles"
                 CircleAllyCounts="State.TeamCircleAllyCounts"
                 EnabledRegions="GetEnabledTeamRegions()"
                 OnChanged="StateHasChanged" />

    <!-- Team Gear Modal -->
    <GearModal @bind-IsOpen="_showTeamGearModal"
               Preset="State.TeamGearPreset"
               PresetChanged="(p) => { State.ApplyTeamGearPreset(p); StateHasChanged(); }"
               GearStats="State.TeamGear"
               MoveBoost="State.TeamGearMoveBoost"
               MoveBoostChanged="(v) => { State.TeamGearMoveBoost = v; State.SyncTeamGearToAllies(); StateHasChanged(); }"
               SyncBoost="State.TeamGearSyncBoost"
               SyncBoostChanged="(v) => { State.TeamGearSyncBoost = v; State.SyncTeamGearToAllies(); StateHasChanged(); }"
               ShowApplyToAll="true"
               OnApplyToAllRequested="() => { State.SyncTeamGearToAllies(); StateHasChanged(); }"
               OnChanged="() => { State.SyncTeamGearToAllies(); StateHasChanged(); }" />
</div>

@code {
    [Parameter] public TeamBattleState? SharedState { get; set; }
    private TeamBattleState _localState = new();
    private TeamBattleState State => SharedState ?? _localState;

    private List<StageLeague> _leagues = new();
    private List<TowerStageType> _towerStages = new();
    private List<StageFight> _ultimateStages = new();
    private List<PairManifestItem> _allManifest = new();
    private DamageRulesDocument _rules = new();

    private string _stageCategory = "gym"; // "gym", "tower", "ultimate"
    private string _selectedTowerType = "Normal";
    private int _selectedTowerFloor = 32;

    private bool _showPairPicker = false;
    private int _pickingSlot = 0;
    private bool _showCircleModal = false;
    private bool _showTeamGearModal = false;

    private HashSet<string> GetEnabledTeamRegions()
    {
        return CombatantState.CircleRegions
            .Where(r => State.GetMatchingRegionAllies(r) > 0)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private string GetTeamGearPresetLabel()
    {
        return State.TeamGearPreset switch
        {
            "none" => Loc.T("gear_preset_none", "None"),
            "3star" => Loc.T("gear_preset_3star", "3★ Lv 15"),
            "4star" => Loc.T("gear_preset_4star", "4★ Lv 15"),
            "skill" => Loc.T("gear_preset_skill", "Skill / Custom"),
            _ => Loc.T("gear_preset_none", "None")
        };
    }

    private bool _showGridModal = false;
    private int _gridModalSlot = 0;

    private bool _showInlineGrid = false;

    private bool _showRebuffModal = false;
    private int _rebuffModalSlot = 1;
    private string _rebuffModalTitle = "Enemy Rebuffs";

    private bool _showApplyToAllModal = false;
    private int _applyToAllSourceIndex = 1;

    private bool _showShareModal = false;
    private bool _showSavedTeamsModal = false;
    private bool _showCompareModal = false;
    private TeamConfigDto? _compareTargetConfig;
    private int _savedTeamsCount = 0;

    private void OpenApplyToAllModal()
    {
        _applyToAllSourceIndex = State.ActiveTargetIndex;
        _showApplyToAllModal = true;
    }

    private void OpenApplyToAllFromEnemy(int targetIndex)
    {
        _applyToAllSourceIndex = targetIndex;
        _showApplyToAllModal = true;
    }

    private void ToggleConfigureGrid(int slot)
    {
        if (_showInlineGrid && State.ActiveAttackerIndex == slot)
        {
            _showInlineGrid = false;
        }
        else
        {
            State.ActiveAttackerIndex = slot;
            _showInlineGrid = true;
        }
        StateHasChanged();
    }

    private void OpenRebuffModal(int targetIndex)
    {
        _rebuffModalSlot = targetIndex;
        string name = targetIndex switch { 0 => "Left Enemy", 1 => "Center (Boss)", _ => "Right Enemy" };
        if (!string.IsNullOrEmpty(State.Enemies[targetIndex].CustomTrainerName))
        {
            name = State.Enemies[targetIndex].CustomTrainerName;
        }
        _rebuffModalTitle = $"Rebuffs - {name}";
        _showRebuffModal = true;
    }

    private void ClearEnemyRebuffs(int targetIndex)
    {
        if (targetIndex >= 0 && targetIndex < State.Enemies.Count)
        {
            foreach (var t in CombatantState.AllTypes)
            {
                State.Enemies[targetIndex].EnemyTypeRebuffs[t] = 0;
            }
            StateHasChanged();
        }
    }

    private void SetAllEnemyDebuffs(int targetIndex, int stage)
    {
        if (targetIndex >= 0 && targetIndex < State.Enemies.Count)
        {
            foreach (var stat in new[] { "def", "spd", "spe", "atk", "spa", "acc", "eva" })
            {
                State.Enemies[targetIndex].Stages[stat] = stage;
            }
            StateHasChanged();
        }
    }

    private void OpenGridModal(int slot)
    {
        _gridModalSlot = slot;
        _showGridModal = true;
    }

    protected override async Task OnInitializedAsync()
    {
        Loc.OnLanguageChanged += OnLanguageChangedHandler;

        _leagues = await StageSvc.GetLeaguesAsync();
        _towerStages = await StageSvc.GetTowerStagesAsync();
        _ultimateStages = await StageSvc.GetUltimateStagesAsync();
        _allManifest = await DataService.GetManifestAsync();
        _rules = await DataService.GetDamageRulesAsync();

        if (State.ActiveFight == null && _leagues.Count > 0)
        {
            var firstLeague = _leagues[0];
            State.SelectedLeagueId = firstLeague.LeagueId;
            var firstFight = firstLeague.Fights.FirstOrDefault();
            if (firstFight != null)
            {
                State.SelectedFightId = firstFight.FightId;
                StageSvc.ApplyFightToEnemies(State, firstFight);
            }
        }

        // Set default Slot 1 pair if available and not yet set
        if (State.Allies[0].Pair == null && _allManifest.Count > 0)
        {
            await LoadAllyPair(0, _allManifest[0].TrainerId);
        }

        await RefreshSavedTeamsCount();
    }

    private void SetStageCategory(string category)
    {
        _stageCategory = category;
        if (category == "gym")
        {
            var currentLeague = _leagues.FirstOrDefault(l => l.LeagueId == State.SelectedLeagueId) ?? _leagues.FirstOrDefault();
            if (currentLeague != null)
            {
                State.SelectedLeagueId = currentLeague.LeagueId;
                var fight = currentLeague.Fights.FirstOrDefault(f => f.FightId == State.SelectedFightId) ?? currentLeague.Fights.FirstOrDefault();
                if (fight != null)
                {
                    State.SelectedFightId = fight.FightId;
                    StageSvc.ApplyFightToEnemies(State, fight);
                }
            }
        }
        else if (category == "tower")
        {
            ApplyCurrentTowerStage();
        }
        else if (category == "ultimate")
        {
            if (_ultimateStages.Count > 0)
            {
                var fight = _ultimateStages.FirstOrDefault(f => f.FightId == State.SelectedFightId) ?? _ultimateStages[0];
                State.SelectedFightId = fight.FightId;
                StageSvc.ApplyFightToEnemies(State, fight);
            }
        }
        StateHasChanged();
    }

    private void OnTowerTypeChanged(ChangeEventArgs e)
    {
        _selectedTowerType = e.Value?.ToString() ?? "Normal";
        ApplyCurrentTowerStage();
    }

    private void OnTowerFloorChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int floorNum))
        {
            _selectedTowerFloor = floorNum;
            ApplyCurrentTowerStage();
        }
    }

    private void ApplyCurrentTowerStage()
    {
        var towerObj = _towerStages.FirstOrDefault(t => t.Type.Equals(_selectedTowerType, StringComparison.OrdinalIgnoreCase)) ?? _towerStages.FirstOrDefault();
        if (towerObj != null && towerObj.Floors.Count > 0)
        {
            var floorObj = towerObj.Floors.FirstOrDefault(fl => fl.Floor == _selectedTowerFloor) ?? towerObj.Floors[0];
            _selectedTowerType = towerObj.Type;
            _selectedTowerFloor = floorObj.Floor;
            State.SelectedFightId = floorObj.Fight.FightId;
            StageSvc.ApplyFightToEnemies(State, floorObj.Fight);
        }
    }

    private void OnUltimateStageChanged(ChangeEventArgs e)
    {
        State.SelectedFightId = e.Value?.ToString() ?? "";
        var fight = _ultimateStages.FirstOrDefault(f => f.FightId == State.SelectedFightId);
        if (fight != null)
        {
            StageSvc.ApplyFightToEnemies(State, fight);
        }
    }

    private void OpenPairPicker(int slot)
    {
        _pickingSlot = slot;
        _showPairPicker = true;
    }

    private async Task OnModalPairSelected(string trainerId)
    {
        await LoadAllyPair(_pickingSlot, trainerId);
        _showPairPicker = false;
    }

    private void OnLeagueChanged(ChangeEventArgs e)
    {
        State.SelectedLeagueId = e.Value?.ToString() ?? "circuit_1";
        var currentLeague = _leagues.FirstOrDefault(l => l.LeagueId == State.SelectedLeagueId);
        if (currentLeague != null && currentLeague.Fights.Count > 0)
        {
            State.SelectedFightId = currentLeague.Fights[0].FightId;
            StageSvc.ApplyFightToEnemies(State, currentLeague.Fights[0]);
        }
    }

    private void OnFightChanged(ChangeEventArgs e)
    {
        State.SelectedFightId = e.Value?.ToString() ?? "";
        LoadSelectedStage();
    }

    private void LoadSelectedStage()
    {
        var currentLeague = _leagues.FirstOrDefault(l => l.LeagueId == State.SelectedLeagueId);
        var fight = currentLeague?.Fights.FirstOrDefault(f => f.FightId == State.SelectedFightId);
        if (fight != null)
        {
            StageSvc.ApplyFightToEnemies(State, fight);
        }
    }

    private List<string> GetTeamCircleRegions()
    {
        var regions = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var ally in State.Allies)
        {
            if (ally.Pair != null)
            {
                var reg = TeamBattleState.GetPairRegion(ally.Pair);
                if (!string.IsNullOrEmpty(reg) && CombatantState.CircleRegions.Contains(reg, StringComparer.OrdinalIgnoreCase))
                {
                    regions.Add(reg);
                }
            }
        }
        return CombatantState.CircleRegions.Where(r => regions.Contains(r)).ToList();
    }

    private void SetActiveAttacker(int slot)
    {
        State.ActiveAttackerIndex = slot;
        StateHasChanged();
    }

    private void RemoveAllyPair(int slot)
    {
        if (slot < 0 || slot >= State.Allies.Count) return;
        State.Allies[slot] = new CombatantState();
        State.AllyActiveGrids[slot].Clear();
        if (State.ActiveAttackerIndex == slot)
        {
            int nextAttacker = State.Allies.FindIndex(a => a.Pair != null);
            State.ActiveAttackerIndex = nextAttacker >= 0 ? nextAttacker : 0;
        }
        State.UpdateCircleAllyCounts();
        StateHasChanged();
    }

    private async Task LoadAllyPair(int slot, string trainerId)
    {
        var detail = await DataService.GetPairDetailAsync(trainerId);
        if (detail != null)
        {
            var ally = State.Allies[slot];
            ally.Pair = detail;
            ally.FormIndex = 0;
            ally.MoveLevel = 5;
            ally.SuperAwakeningLevel = detail.HasSuperAwakening ? 5 : 0;
            ally.HasExRole = detail.HasEx && !string.IsNullOrEmpty(detail.ExRole);
            ally.StarLevel = detail.HasEx ? "5★ EX" : (detail.Rarity == 5 ? "5★ 20/20" : $"{detail.Rarity}★");
            ally.CharLevel = "180";
            ally.IsCriticalMove = true;
            ally.SuperEffectiveNext = false;

            // Default stat stages
            foreach (var s in CombatantState.StageLabels)
            {
                ally.Stages[s] = s == "crit" ? 3 : ((s == "acc" || s == "eva") ? 0 : 6);
            }

            // Initialize grid with standard free center cells (same as solo calculator)
            GridState.ResetGrid(detail, ally.MoveLevel, State.AllyActiveGrids[slot]);

            State.UpdateCircleAllyCounts();

            StateHasChanged();
        }
    }

    private void SetAllyForm(int slot, int formIdx)
    {
        State.Allies[slot].FormIndex = formIdx;
        StateHasChanged();
    }

    private void OnAllyStageChange(int slot, string stat, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            State.Allies[slot].Stages[stat] = val;
            StateHasChanged();
        }
    }

    private void OnEnemyStageChange(int target, string stat, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            State.Enemies[target].Stages[stat] = val;
            StateHasChanged();
        }
    }

    private void OnEnemyHp(int target, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            State.Enemies[target].ManualStats["hp"] = val;
            StateHasChanged();
        }
    }

    private void OnEnemyDef(int target, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            State.Enemies[target].ManualStats["def"] = val;
            StateHasChanged();
        }
    }

    private void OnEnemySpd(int target, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            State.Enemies[target].ManualStats["spd"] = val;
            StateHasChanged();
        }
    }

    private List<string> GetStageGimmickWarnings(MoveItem move, CombatantState opp)
    {
        var warnings = new List<string>();
        if (State.ActiveFight?.Rules == null || State.ActiveFight.Rules.Count == 0) return warnings;

        string effType = CalcService.GetEffectiveMoveType(State.ActiveAttacker.Pair, move, State.ActiveAttacker.FormIndex);

        foreach (var rule in State.ActiveFight.Rules)
        {
            if (rule.Contains("status condition or interference", StringComparison.OrdinalIgnoreCase))
            {
                bool hasStatus = !string.IsNullOrEmpty(opp.StatusCondition);
                bool hasInterference = opp.VolatileStatus.GetValueOrDefault("confused", false) ||
                                       opp.VolatileStatus.GetValueOrDefault("trapped", false) ||
                                       opp.VolatileStatus.GetValueOrDefault("flinching", false);
                if (!hasStatus && !hasInterference)
                {
                    warnings.Add("Target is unaffected by status or interference! Deals 0 damage in this stage until afflicted.");
                }
            }

            if (rule.Contains("not supereffective", StringComparison.OrdinalIgnoreCase) ||
                rule.Contains("not super effective", StringComparison.OrdinalIgnoreCase))
            {
                bool isSE = !string.IsNullOrEmpty(opp.Weakness) && string.Equals(effType, opp.Weakness, StringComparison.OrdinalIgnoreCase);
                if (!isSE)
                {
                    warnings.Add("Move is not super effective! Deals 0 damage in this stage.");
                }
            }
        }
        return warnings;
    }

    private async Task RefreshSavedTeamsCount()
    {
        var list = await TeamConfigSvc.GetSavedTeamsAsync();
        _savedTeamsCount = list.Count;
        StateHasChanged();
    }

    private async Task OnConfigImportedHandler(TeamConfigDto config)
    {
        await TeamConfigSvc.ApplyConfigAsync(State, config);
        await RefreshSavedTeamsCount();
        StateHasChanged();
    }

    private void OnCompareRequestedHandler(TeamConfigDto target)
    {
        _compareTargetConfig = target;
        _showSavedTeamsModal = false;
        _showCompareModal = true;
        StateHasChanged();
    }

    private void OnShareRequestedHandler(TeamConfigDto target)
    {
        _showSavedTeamsModal = false;
        _showShareModal = true;
        StateHasChanged();
    }

    private void OpenCompare()
    {
        _showCompareModal = true;
    }

    private async Task ResetTeam()
    {
        State.Allies[0] = new CombatantState();
        State.Allies[1] = new CombatantState();
        State.Allies[2] = new CombatantState();
        State.AllyActiveGrids[0].Clear();
        State.AllyActiveGrids[1].Clear();
        State.AllyActiveGrids[2].Clear();
        State.ClearAllCircles();
        State.EnemySyncBuffs = 0;
        State.EnemyPhysicalDamageReduction = false;
        State.EnemySpecialDamageReduction = false;
        State.EnemyDamageField = "";
        State.Field = new FieldState();

        if (_allManifest.Count > 0)
        {
            await LoadAllyPair(0, _allManifest[0].TrainerId);
        }
        LoadSelectedStage();
        StateHasChanged();
    }

    private void OnLanguageChangedHandler()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Loc.OnLanguageChanged -= OnLanguageChangedHandler;
    }
