                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-dark border border-secondary text-secondary">Single Target</span>
                                                        }
                                                        <span class="badge" style="background-color: rgba(232, 67, 147, 0.2); color: #ff79b0; border: 1px solid rgba(232, 67, 147, 0.5); font-weight: 600;">
                                                            <i class="bi bi-arrow-repeat me-0.5"></i>1 Use
