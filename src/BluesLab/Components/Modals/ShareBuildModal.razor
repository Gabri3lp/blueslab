@inject GridStateService GridState
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (IsOpen)
{
    <div class="modal-backdrop fade show" @onclick="Close"></div>
    <div class="modal d-block fade show" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document" @onclick:stopPropagation>
            <div class="modal-content bg-dark text-light border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title d-flex align-items-center gap-2">
                        <i class="bi bi-share-fill text-warning"></i> Share Sync Grid Build
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>
                <div class="modal-body p-3">
                    <p class="small text-secondary mb-3">Copy this link to share your active grid build with others.</p>
                    
                    <div class="mb-3">
                        <label class="form-label small text-secondary">Shareable Link</label>
                        <div class="input-group">
                            <input type="text" class="form-control bg-dark text-light border-secondary small" value="@ShareUrl" readonly />
                            <button class="btn btn-warning" @onclick="CopyUrl">
                                <i class="bi bi-clipboard"></i> Copy
                            </button>
                        </div>
                        @if (Copied)
                        {
                            <div class="text-success small mt-1">✓ Copied to clipboard!</div>
                        }
                    </div>

                    <div class="mb-2">
                        <label class="form-label small text-secondary">Import Grid Code</label>
                        <div class="input-group">
                            <input type="text" class="form-control bg-dark text-light border-secondary small" placeholder="Paste build code here..." @bind="ImportCode" />
                            <button class="btn btn-outline-secondary" @onclick="ApplyImportCode">Import</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public SyncPairDetail? Pair { get; set; }

    private bool Copied;
    private string ImportCode = "";

    private string ShareUrl
    {
        get
        {
            if (Pair == null) return Navigation.BaseUri;
            string token = GridState.ExportBuildToken(Pair.Grid);
            return $"{Navigation.BaseUri}?pair={Pair.TrainerId}&monsterId={Pair.MonsterId}&baseId={Pair.MonsterBaseId}&formId=0&build={token}";
        }
    }

    private async Task CopyUrl()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", ShareUrl);
        Copied = true;
        await Task.Delay(2000);
        Copied = false;
    }

    private async Task ApplyImportCode()
    {
        if (Pair != null && !string.IsNullOrWhiteSpace(ImportCode))
        {
            GridState.ImportBuildToken(Pair.Grid, ImportCode.Trim());
            await Close();
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}