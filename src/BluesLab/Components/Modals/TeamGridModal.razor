@using BluesLab.Models
@using BluesLab.Services
@using BluesLab.Components.HexGrid
@inject GridStateService GridState

@if (IsOpen && Pair != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.85); z-index: 1060;" @onclick="Close">
        <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width: 95vw; height: 90vh;" @onclick:stopPropagation="true">
            <div class="modal-content bg-dark text-light h-100 border border-secondary shadow-lg d-flex flex-column">
                <!-- Modal Header: Sync Pair Info & Actions -->
                <div class="modal-header border-secondary py-2 px-3 bg-black bg-opacity-40 d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <img src="@Pair.IconUrl" alt="@Pair.DisplayName" class="rounded-circle border border-warning" style="width: 36px; height: 36px; object-fit: cover;" onerror="this.src='img/trainers/unknown.png';" />
                        <div>
                            <h6 class="modal-title fw-bold text-warning mb-0">@Pair.DisplayName - Sync Grid</h6>
                            <span class="small text-muted" style="font-size: 0.72rem;">@Pair.Role | @Pair.Type</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <!-- Hard Cap Toggle -->
                        <div class="form-check form-switch mb-0 me-2" title="Limit energy to 60 and enforce cell adjacency">
                            <input class="form-check-input cursor-pointer" type="checkbox" role="switch" id="teamHardCapToggle"
                                   checked="@GridState.HardCap" @onchange="OnHardCapToggle" />
                            <label class="form-check-label small text-secondary cursor-pointer" for="teamHardCapToggle">Hard Cap</label>
                        </div>

                        <!-- Reset Grid Button -->
                        <button class="btn btn-outline-secondary btn-sm" @onclick="OnResetGrid" title="Reset to free center cells">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                        </button>

                        <!-- Done / Close Button -->
                        <button type="button" class="btn btn-primary btn-sm fw-bold px-3" @onclick="Close">
                            <i class="bi bi-check-lg me-1"></i>Done
                        </button>
                    </div>
                </div>

                <!-- Modal Body: Full Hexagonal Grid View with complete visual layout -->
                <div class="modal-body p-0 flex-grow-1 overflow-hidden position-relative" style="height: calc(90vh - 65px);">
                    <HexGridView Pair="Pair"
                                 MoveLevel="MoveLevel"
                                 MoveLevelChanged="OnMoveLevelChangedInternal"
                                 ActiveCells="ActiveCells"
                                 OnGridChanged="OnGridChangedInternal" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public SyncPairDetail? Pair { get; set; }
    [Parameter] public int MoveLevel { get; set; } = 5;
    [Parameter] public EventCallback<int> MoveLevelChanged { get; set; }
    [Parameter] public HashSet<long> ActiveCells { get; set; } = new();
    [Parameter] public EventCallback OnGridChanged { get; set; }

    private async Task OnMoveLevelChangedInternal(int newLevel)
    {
        MoveLevel = newLevel;
        await MoveLevelChanged.InvokeAsync(newLevel);
        await OnGridChanged.InvokeAsync();
    }

    private async Task OnGridChangedInternal()
    {
        await OnGridChanged.InvokeAsync();
    }

    private async Task OnHardCapToggle(ChangeEventArgs e)
    {
        GridState.HardCap = (bool)(e.Value ?? true);
        if (Pair != null && GridState.HardCap)
        {
            GridState.ActivateFreeCenterCells(Pair, MoveLevel, ActiveCells);
            GridState.PruneDisconnected(Pair.Grid, ActiveCells);
            GridState.NotifyChanged();
        }
        await OnGridChanged.InvokeAsync();
    }

    private async Task OnResetGrid()
    {
        if (Pair != null)
        {
            GridState.ResetGrid(Pair, MoveLevel, ActiveCells);
            await OnGridChanged.InvokeAsync();
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
