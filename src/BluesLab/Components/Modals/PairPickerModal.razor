@inject SyncPairDataService DataService

@if (IsOpen)
{
    <div class="modal-backdrop fade show" @onclick="Close"></div>
    <div class="modal d-block fade show" tabindex="-1" role="dialog" @onkeydown="HandleKeyDown">
        <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document" @onclick:stopPropagation>
            <div class="modal-content bg-dark text-light border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title d-flex align-items-center gap-2">
                        <i class="bi bi-people-fill text-warning"></i> @Loc.T("select_sync_pair", "Select Sync Pair")
                        <span class="badge bg-secondary">@FilteredPairs.Count @Loc.T("selected", "pairs")</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>
                <div class="modal-body p-3">
                    <!-- Search and filters -->
                    <div class="row g-2 mb-3">
                        <div class="col-lg-4 col-md-6">
                            <div class="input-group">
                                <span class="input-group-text bg-secondary border-secondary text-light"><i class="bi bi-search"></i></span>
                                <input @ref="SearchInputRef" type="text" class="form-control bg-dark text-light border-secondary" placeholder="@Loc.T("filter_placeholder", "Search trainer or Pokémon...")" @bind="SearchQuery" @bind:event="oninput" autofocus />
                                @if (!string.IsNullOrEmpty(SearchQuery))
                                {
                                    <button class="btn btn-outline-secondary" type="button" @onclick="() => SearchQuery = string.Empty">✕</button>
                                }
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-3 col-6">
                            <select class="form-select bg-dark text-light border-secondary" @bind="SelectedType">
                                <option value="">@Loc.T("all_types", "All Types")</option>
                                @foreach (var t in CombatantState.AllTypes)
                                {
                                    <option value="@t">@Loc.GetTypeName(t)</option>
                                }
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-3 col-6">
                            <select class="form-select bg-dark text-light border-secondary" @bind="SelectedRole">
                                <option value="">@Loc.T("all_roles", "All Roles")</option>
                                <option value="Strike">@Loc.GetRoleName("Strike")</option>
                                <option value="Tech">@Loc.GetRoleName("Tech")</option>
                                <option value="Support">@Loc.GetRoleName("Support")</option>
                                <option value="Sprint">@Loc.GetRoleName("Sprint")</option>
                                <option value="Field">@Loc.GetRoleName("Field")</option>
                                <option value="Multi">@Loc.GetRoleName("Multi")</option>
                            </select>
                        </div>
                        <div class="col-lg-4 col-md-12">
                            <div class="input-group">
                                <span class="input-group-text bg-secondary border-secondary text-light" title="@Loc.T("sort_by", "Sort By")"><i class="bi bi-arrow-down-up"></i></span>
                                <select class="form-select bg-dark text-light border-secondary" @bind="SelectedSort">
                                    <option value="release_desc">📅 @Loc.T("sort_release_desc", "Release Date: Newest")</option>
                                    <option value="release_asc">📅 @Loc.T("sort_release_asc", "Release Date: Oldest")</option>
                                    <option value="name_asc">🔤 @Loc.T("sort_name_asc", "Name: A to Z")</option>
                                    <option value="name_desc">🔤 @Loc.T("sort_name_desc", "Name: Z to A")</option>
                                    <option value="rarity_desc">⭐ @Loc.T("sort_rarity_desc", "Rarity: High to Low")</option>
                                    <option value="rarity_asc">⭐ @Loc.T("sort_rarity_asc", "Rarity: Low to High")</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
                        <span class="text-muted small">@Loc.T("filter_special", "Special:"):</span>
                        <button class="btn btn-sm @(FilterMega ? "btn-warning" : "btn-outline-secondary")" @onclick="() => FilterMega = !FilterMega">Mega</button>
                        <button class="btn btn-sm @(FilterTera ? "btn-info" : "btn-outline-secondary")" @onclick="() => FilterTera = !FilterTera">Tera</button>
                        <button class="btn btn-sm @(FilterDMax ? "btn-pink" : "btn-outline-secondary")" @onclick="() => FilterDMax = !FilterDMax">Dynamax</button>
                        <button class="btn btn-sm @(FilterSA ? "btn-danger" : "btn-outline-secondary")" @onclick="() => FilterSA = !FilterSA">Super Awakening</button>
                        <button class="btn btn-sm @(FilterEx ? "btn-primary" : "btn-outline-secondary")" @onclick="() => FilterEx = !FilterEx">6★ EX</button>
                        @if (HasActiveFilters)
                        {
                            <button class="btn btn-sm btn-outline-danger ms-auto" @onclick="ResetFilters">@Loc.T("filter_reset", "Reset Filters")</button>
                        }
                    </div>

                    <!-- Pairs Grid -->
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-2">
                        @foreach (var pair in FilteredPairs)
                        {
                            var dName = Loc.GetDisplayName(pair);
                            <div class="col">
                                <div class="card h-100 bg-secondary bg-opacity-25 border-secondary pair-card p-2" @onclick="() => OnSelectPair(pair.TrainerId)">
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@pair.IconUrl" alt="@dName" class="rounded-circle border border-warning" width="48" height="48" onerror="this.src='img/trainers/unknown.png';" />
                                        <div class="flex-grow-1 overflow-hidden">
                                            <div class="fw-bold text-truncate text-light small" title="@dName">@dName</div>
                                            <div class="d-flex align-items-center gap-1 mt-1 flex-wrap">
                                                <span class="badge type-badge type-@pair.Type.ToLowerInvariant()">@Loc.GetTypeName(pair.Type)</span>
                                                <span class="badge bg-dark border border-secondary text-secondary small">@Loc.GetRoleName(pair.Role)</span>
                                                @if (pair.HasSuperAwakening)
                                                {
                                                    <span class="badge bg-danger" title="Super Awakening">SA</span>
                                                }
                                                @if (pair.HasMega)
                                                {
                                                    <span class="badge bg-warning text-dark" title="Mega Evolution">M</span>
                                                }
                                                @if (!string.IsNullOrEmpty(pair.ReleaseDate))
                                                {
                                                    <span class="badge bg-dark border border-secondary text-muted ms-auto small" style="font-size: 0.68rem;" title="@Loc.T("release_date", "Release Date"): @pair.ReleaseDate">
                                                        <i class="bi bi-calendar3 me-1"></i>@pair.ReleaseDate
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (FilteredPairs.Count == 0)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-search fs-1 d-block mb-2"></i>
                            @Loc.T("filter_not_found_desc", "No sync pairs match the current search or filters.")
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<string> OnPairSelected { get; set; }

    private ElementReference SearchInputRef;
    private bool _shouldFocusSearch;
    private bool _wasOpen;

    private List<PairManifestItem> AllPairs = new();
    private string SearchQuery = "";
    private string SelectedType = "";
    private string SelectedRole = "";
    private string SelectedSort = "release_desc";
    private bool FilterMega;
    private bool FilterTera;
    private bool FilterDMax;
    private bool FilterSA;
    private bool FilterEx;

    private bool HasActiveFilters => !string.IsNullOrEmpty(SearchQuery) || !string.IsNullOrEmpty(SelectedType) || !string.IsNullOrEmpty(SelectedRole) || FilterMega || FilterTera || FilterDMax || FilterSA || FilterEx || SelectedSort != "release_desc";

    protected override async Task OnInitializedAsync()
    {
        AllPairs = await DataService.GetManifestAsync();
    }

    protected override void OnParametersSet()
    {
        if (IsOpen && !_wasOpen)
        {
            _shouldFocusSearch = true;
        }
        _wasOpen = IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldFocusSearch)
        {
            _shouldFocusSearch = false;
            await Task.Delay(50);
            try
            {
                if (IsOpen)
                {
                    await SearchInputRef.FocusAsync();
                }
            }
            catch
            {
                // Ignore focus errors if element is detached
            }
        }
    }

    private List<PairManifestItem> FilteredPairs
    {
        get
        {
            var query = SearchQuery.Trim().ToLowerInvariant();
            var pairs = AllPairs.Where(p =>
            {
                if (!string.IsNullOrEmpty(query))
                {
                    bool matchEnglish = p.DisplayName.ToLowerInvariant().Contains(query) ||
                                       p.TrainerName.ToLowerInvariant().Contains(query) ||
                                       p.MonsterName.ToLowerInvariant().Contains(query);

                    if (!matchEnglish)
                    {
                        var locDisplay = Loc.GetDisplayName(p).ToLowerInvariant();
                        var locTrainer = Loc.GetTrainerName(p.TrainerId, p.TrainerKey, p.TrainerBaseId, p.TrainerName).ToLowerInvariant();
                        var locPokemon = Loc.GetPokemonName(p.MonsterBaseId, p.PokemonKey, p.MonsterName).ToLowerInvariant();

                        if (!locDisplay.Contains(query) && !locTrainer.Contains(query) && !locPokemon.Contains(query))
                        {
                            return false;
                        }
                    }
                }
                if (!string.IsNullOrEmpty(SelectedType) && !string.Equals(p.Type, SelectedType, StringComparison.OrdinalIgnoreCase))
                    return false;
                if (!string.IsNullOrEmpty(SelectedRole) && !p.Role.StartsWith(SelectedRole, StringComparison.OrdinalIgnoreCase))
                    return false;
                if (FilterMega && !p.HasMega) return false;
                if (FilterTera && !p.HasTera) return false;
                if (FilterDMax && !p.HasDynamax) return false;
                if (FilterSA && !p.HasSuperAwakening) return false;
                if (FilterEx && !p.HasEx) return false;
                return true;
            });

            return (SelectedSort switch
            {
                "release_asc" => pairs.OrderBy(p => p.ReleaseTimestamp).ThenBy(p => p.DisplayName),
                "name_asc" => pairs.OrderBy(p => Loc.GetDisplayName(p)).ThenByDescending(p => p.ReleaseTimestamp),
                "name_desc" => pairs.OrderByDescending(p => Loc.GetDisplayName(p)).ThenByDescending(p => p.ReleaseTimestamp),
                "rarity_desc" => pairs.OrderByDescending(p => p.Rarity).ThenByDescending(p => p.ReleaseTimestamp).ThenBy(p => p.DisplayName),
                "rarity_asc" => pairs.OrderBy(p => p.Rarity).ThenByDescending(p => p.ReleaseTimestamp).ThenBy(p => p.DisplayName),
                _ => pairs.OrderByDescending(p => p.ReleaseTimestamp).ThenBy(p => p.DisplayName)
            }).ToList();
        }
    }

    private void ResetFilters()
    {
        SearchQuery = "";
        SelectedType = "";
        SelectedRole = "";
        SelectedSort = "release_desc";
        FilterMega = false;
        FilterTera = false;
        FilterDMax = false;
        FilterSA = false;
        FilterEx = false;
    }

    private async Task OnSelectPair(string trainerId)
    {
        await OnPairSelected.InvokeAsync(trainerId);
        await Close();
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await Close();
        }
    }
}