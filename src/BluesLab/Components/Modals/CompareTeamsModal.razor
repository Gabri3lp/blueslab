@using BluesLab.Models
@using BluesLab.Services
@inject TeamConfigurationService TeamConfigSvc
@inject DamageCalculatorService CalcService
@inject SyncPairDataService DataService
@inject StageService StageSvc

@if (IsOpen)
{
    <div class="modal-backdrop fade show" style="z-index: 1060;" @onclick="Close"></div>
    <div class="modal d-block fade show" tabindex="-1" role="dialog" style="z-index: 1065;" @onclick="Close">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable" role="document" @onclick:stopPropagation="true">
            <div class="modal-content bg-dark text-light border border-secondary shadow-lg">
                <!-- Header -->
                <div class="modal-header border-secondary py-2 px-3 bg-black bg-opacity-40 d-flex justify-content-between align-items-center">
                    <h5 class="modal-title d-flex align-items-center gap-2 fs-6">
                        <i class="bi bi-speedometer2 text-info"></i> @Loc.T("compare_teams", "Compare Configurations")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>

                <div class="modal-body p-3">
                    <!-- Top Controls: Select Team to Compare against -->
                    <div class="row g-2 align-items-center mb-3 p-2 rounded bg-black bg-opacity-25 border border-secondary">
                        <div class="col-12 col-md-5">
                            <span class="small text-muted fw-bold d-block mb-1">
                                <i class="bi bi-1-circle text-warning me-1"></i>@Loc.T("current_team", "Configuration A (Current)")
                            </span>
                            <div class="fw-bold text-light small text-truncate">
                                @(State?.ActiveAttacker.Pair?.DisplayName ?? "Empty Slot")
                                <span class="text-muted ms-1">(@(State?.ActiveFight?.Title ?? "Gym Battle"))</span>
                            </div>
                        </div>

                        <div class="col-12 col-md-2 text-center">
                            <span class="badge bg-secondary px-3 py-1 fs-6">VS</span>
                        </div>

                        <div class="col-12 col-md-5">
                            <span class="small text-muted fw-bold d-block mb-1">
                                <i class="bi bi-2-circle text-info me-1"></i>@Loc.T("compared_team", "Configuration B (Target)")
                            </span>
                            <select class="form-select form-select-sm bg-dark text-light border-secondary"
                                    value="@_selectedTargetTeamId"
                                    @onchange="OnTargetTeamSelectionChanged">
                                <option value="">-- @Loc.T("my_team_select", "Select a saved team") --</option>
                                @foreach (var t in _savedTeams)
                                {
                                    <option value="@t.Id">@t.Name (@t.StageTitle)</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Comparison Table -->
                    @if (_isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-info mb-2" role="status"></div>
                            <div class="small text-muted">Calculating damage difference...</div>
                        </div>
                    }
                    else if (_summary == null || _summary.MoveResults.Count == 0)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-arrow-left-right fs-2 d-block mb-2 text-secondary"></i>
                            <p class="small mb-0">Select a saved team above to compare damage difference.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-hover table-bordered border-secondary align-middle text-center small mb-0">
                                <thead class="table-secondary text-light">
                                    <tr>
                                        <th class="text-start" style="width: 25%;">@Loc.T("moves", "Move")</th>
                                        <th style="width: 25%;" class="text-warning">Config A (Current)</th>
                                        <th style="width: 25%;" class="text-info">Config B (@_summary.ConfigBName)</th>
                                        <th style="width: 25%;">@Loc.T("diff", "Difference (B vs A)")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in _summary.MoveResults)
                                    {
                                        var isSync = m.IsSync;
                                        var isMax = m.IsMax;
                                        var diffSign = m.DamageDiff >= 0 ? "+" : "";
                                        var pctSign = m.DiffPercent >= 0 ? "+" : "";
                                        var diffColor = m.DamageDiff > 0 ? "text-success fw-bold" : (m.DamageDiff < 0 ? "text-danger fw-bold" : "text-muted");
                                        var badgeBg = m.DamageDiff > 0 ? "bg-success text-white" : (m.DamageDiff < 0 ? "bg-danger text-white" : "bg-secondary text-light");

                                        <tr>
                                            <td class="text-start">
                                                <div class="d-flex align-items-center gap-1">
                                                    <span class="badge type-badge type-@m.MoveType.ToLowerInvariant() py-0" style="font-size: 0.68rem;">@m.MoveType</span>
                                                    @if (isSync)
                                                    {
                                                        <span class="badge bg-purple py-0" style="font-size: 0.68rem;">Sync</span>
                                                    }
                                                    else if (isMax)
                                                    {
                                                        <span class="badge btn-pink text-white py-0" style="font-size: 0.68rem;">Max</span>
                                                    }
                                                    <span class="fw-bold text-light text-truncate">@m.MoveName</span>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="fw-bold text-warning fs-6">@m.DamageA.ToString("N0")</div>
                                                <span class="text-muted" style="font-size: 0.72rem;">(@m.HpPercentA.ToString("0.0")% HP)</span>
                                            </td>
                                            <td>
                                                <div class="fw-bold text-info fs-6">@m.DamageB.ToString("N0")</div>
                                                <span class="text-muted" style="font-size: 0.72rem;">(@m.HpPercentB.ToString("0.0")% HP)</span>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column align-items-center">
                                                    <span class="@diffColor fs-6">@diffSign@m.DamageDiff.ToString("N0")</span>
                                                    <span class="badge @badgeBg px-2 py-0.5" style="font-size: 0.72rem;">
                                                        @pctSign@m.DiffPercent.ToString("0.0")%
                                                    </span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="modal-footer border-secondary py-2 px-3 bg-black bg-opacity-40">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="Close">
                        @Loc.T("done", "Done")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public TeamBattleState? State { get; set; }
    [Parameter] public TeamConfigDto? InitialTargetConfig { get; set; }
    [Parameter] public DamageRulesDocument? Rules { get; set; }

    private List<TeamSavedItemDto> _savedTeams = new();
    private string _selectedTargetTeamId = string.Empty;
    private TeamConfigDto? _currentTargetConfig;
    private TeamComparisonSummary? _summary;
    private bool _isLoading = false;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            _savedTeams = await TeamConfigSvc.GetSavedTeamsAsync();
            if (InitialTargetConfig != null)
            {
                _currentTargetConfig = InitialTargetConfig;
                _selectedTargetTeamId = InitialTargetConfig.Id;
                await RunComparisonAsync();
            }
            else if (_savedTeams.Count > 0 && string.IsNullOrEmpty(_selectedTargetTeamId))
            {
                _selectedTargetTeamId = _savedTeams[0].Id;
                _currentTargetConfig = _savedTeams[0].Config;
                await RunComparisonAsync();
            }
        }
    }

    private async Task OnTargetTeamSelectionChanged(ChangeEventArgs e)
    {
        _selectedTargetTeamId = e.Value?.ToString() ?? string.Empty;
        var found = _savedTeams.FirstOrDefault(x => x.Id == _selectedTargetTeamId);
        if (found != null)
        {
            _currentTargetConfig = found.Config;
            await RunComparisonAsync();
        }
        else
        {
            _currentTargetConfig = null;
            _summary = null;
        }
    }

    private async Task RunComparisonAsync()
    {
        if (State == null || _currentTargetConfig == null || Rules == null) return;

        _isLoading = true;
        StateHasChanged();

        try
        {
            _summary = await TeamConfigSvc.CompareTeamsAsync(
                State,
                _currentTargetConfig,
                CalcService,
                DataService,
                StageSvc,
                Rules,
                Loc);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Comparison calculation error: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
