@inject DamageCalculatorService CalcService
@inject GridStateService GridState
@implements IDisposable

<div class="sync-pair-overview p-2">
    @if (Pair == null)
    {
        <div class="text-center py-5 text-muted">Please select a Sync Pair to view overview.</div>
    }
    else
    {
        <!-- Header Info & Controls -->
        <div class="card bg-dark border-secondary p-3 mb-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <img src="@Pair.IconUrl" alt="@Pair.DisplayName" width="56" height="56" class="rounded-circle border border-warning shadow" onerror="this.src=''img/trainers/unknown.png'';" />
                    <div>
                        <h5 class="fw-bold text-light mb-1">
                            @Pair.DisplayName
                            @if (Ally.FormIndex > 0 && Ally.FormIndex <= Pair.Variations.Count)
                            {
                                <span class="badge bg-warning text-dark fs-6 ms-2">(@Pair.Variations[Ally.FormIndex - 1].FormName)</span>
                            }
                        </h5>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="badge type-badge type-@Pair.Type.ToLowerInvariant()">@Pair.Type</span>
                            <span class="badge bg-secondary">@Pair.Role</span>
                            @if (!string.IsNullOrEmpty(Pair.ExRole))
                            {
                                <span class="badge bg-indigo">EX: @Pair.ExRole</span>
                            }
                            @if (!string.IsNullOrEmpty(Pair.Weakness))
                            {
                                <span class="badge bg-dark border border-danger text-danger">Weakness: @Pair.Weakness</span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Form Switcher Buttons (Base, Mega, Tera) -->
                @if (Pair.Variations.Count > 0 || Pair.HasMega || Pair.HasTera)
                {
                    <div class="btn-group btn-group-sm">
                        <button class="btn @(Ally.FormIndex == 0 ? "btn-warning fw-bold" : "btn-outline-secondary")" @onclick="() => SetForm(0)">
                            Base Form
                        </button>
                        @for (int i = 0; i < Pair.Variations.Count; i++)
                        {
                            int idx = i + 1;
                            var v = Pair.Variations[i];
                            <button class="btn @(Ally.FormIndex == idx ? "btn-warning fw-bold" : "btn-outline-secondary")" @onclick="() => SetForm(idx)">
                                @v.FormName
                            </button>
                        }
                    </div>
                }

                <!-- Star Level, Level, Move Level & EX Role Controls -->
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <!-- Move Level Selector (1-5) -->
                    <div class="d-flex align-items-center gap-1 bg-secondary bg-opacity-25 px-2 py-1 rounded border border-secondary">
                        <span class="small text-muted fw-bold">Move Lv:</span>
                        <select class="form-select form-select-sm bg-dark text-light border-0 p-0" style="width: 50px;" value="@Ally.MoveLevel" @onchange="OnMoveLevelSelect">
                            <option value="1">1/5</option>
                            <option value="2">2/5</option>
                            <option value="3">3/5</option>
                            <option value="4">4/5</option>
                            <option value="5">5/5</option>
                        </select>
                    </div>

                    <select class="form-select form-select-sm bg-dark text-light border-secondary" style="width: 100px;" @bind="Ally.StarLevel" @bind:after="StateHasChanged">
                        <option value="3★">3★</option>
                        <option value="4★">4★</option>
                        <option value="5★">5★</option>
                        <option value="5★ 20/20">5★ 20/20</option>
                        @if (Pair.HasEx)
                        {
                            <option value="5★ EX">5★ EX</option>
                        }
                    </select>

                    <!-- Level Selector -->
                    <select class="form-select form-select-sm bg-dark text-light border-secondary" style="width: 95px;" @bind="Ally.CharLevel" @bind:after="StateHasChanged">
                        <option value="1">Lv. 1</option>
                        <option value="30">Lv. 30</option>
                        <option value="45">Lv. 45</option>
                        <option value="100">Lv. 100</option>
                        <option value="120">Lv. 120</option>
                        <option value="130">Lv. 130</option>
                        <option value="140">Lv. 140</option>
                        <option value="150">Lv. 150</option>
                        <option value="200">Lv. 200</option>
                    </select>

                    @if (Pair.HasSuperAwakening)
                    {
                        <div class="d-flex align-items-center gap-1 bg-secondary bg-opacity-25 px-2 py-1 rounded border border-danger">
                            <span class="text-danger small fw-bold">SA:</span>
                            <select class="form-select form-select-sm bg-dark text-light border-0 p-0" style="width: 45px;" value="@Ally.SuperAwakeningLevel" @onchange="OnSaLevelSelect">
                                <option value="0">0</option>
                                <option value="1">1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                                <option value="4">4</option>
                                <option value="5">5</option>
                            </select>
                        </div>
                    }

                    @if (Pair.HasEx && !string.IsNullOrEmpty(Pair.ExRole))
                    {
                        <button class="btn btn-sm @(Ally.HasExRole ? "btn-indigo" : "btn-outline-secondary")" @onclick="() => { Ally.HasExRole = !Ally.HasExRole; StateHasChanged(); }">
                            EX Role
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Comprehensive Stats Table -->
        <div class="card bg-dark border-secondary p-3 mb-3">
            <h6 class="text-info fw-bold mb-3 d-flex align-items-center justify-content-between">
                <span class="d-flex align-items-center gap-2">
                    <i class="bi bi-bar-chart-fill"></i> Stats Breakdown (Lv. @Ally.CharLevel)
                </span>
                @if (Ally.FormIndex > 0 && Ally.FormIndex <= Pair.Variations.Count)
                {
                    <span class="badge bg-secondary text-warning small">
                        Form Scaling Active: @Pair.Variations[Ally.FormIndex - 1].FormName
                    </span>
                }
            </h6>
            <div class="table-responsive">
                <table class="table table-dark table-sm table-bordered text-center align-middle mb-0">
                    <thead>
                        <tr class="text-secondary small">
                            <th class="text-start">Category</th>
                            <th style="width: 15%;">HP</th>
                            <th style="width: 15%;">Attack</th>
                            <th style="width: 15%;">Defense</th>
                            <th style="width: 15%;">Sp. Atk</th>
                            <th style="width: 15%;">Sp. Def</th>
                            <th style="width: 15%;">Speed</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int lvl = int.TryParse(Ally.CharLevel, out int l) ? l : 140;
                            var pot = CalcService.CalcPotentialBonus(Pair.Rarity, Ally.StarLevel);
                            var ex = Ally.HasExRole ? CalcService.GetExRoleBonus(Pair.ExRole) : new();
                            string[] statsKeys = ["hp", "atk", "def", "spa", "spd", "spe"];
                            var currentVariation = (Ally.FormIndex > 0 && Ally.FormIndex <= Pair.Variations.Count)
                                ? Pair.Variations[Ally.FormIndex - 1]
                                : null;
                            bool isSaActive = Pair.HasSuperAwakening && Ally.SuperAwakeningLevel >= 1;
                        }
                        <tr>
                            <td class="text-start text-muted small">
                                Base Stat (Lv. @Ally.CharLevel)
                                @if (isSaActive)
                                {
                                    <span class="badge bg-danger text-light ms-1" style="font-size: 0.65rem;">+10% SA</span>
                                }
                            </td>
                            @foreach (var s in statsKeys)
                            {
                                int rawBase = Pair.Stats.GetStatAtLevel(s, lvl);
                                int saBase = rawBase;
                                if (isSaActive)
                                {
                                    saBase = (int)Math.Ceiling(rawBase * 1.1) + (rawBase % 10 != 0 ? -1 : 0);
                                    if (Pair.Role.Trim().StartsWith("Support", StringComparison.OrdinalIgnoreCase))
                                    {
                                        var saFlat = CalcService.GetSaSupportFlatBonus(Ally.SuperAwakeningLevel);
                                        if (saFlat.TryGetValue(s, out int fb))
                                            saBase += fb;
                                    }
                                }
                                <td>@saBase</td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start text-muted small">Potential + EX Role</td>
                            @foreach (var s in statsKeys)
                            {
                                int bonus = pot.GetValueOrDefault(s, 0) + ex.GetValueOrDefault(s, 0);
                                <td class="@(bonus > 0 ? "text-success" : "text-muted")">@(bonus > 0 ? $"+{bonus}" : "-")</td>
                            }
                        </tr>
                        @if (currentVariation != null)
                        {
                            <tr>
                                <td class="text-start text-muted small">Form Multiplier (@currentVariation.FormName)</td>
                                @foreach (var s in statsKeys)
                                {
                                    double mult = currentVariation.StatMultiplier.GetValueOrDefault(s, 1.0);
                                    <td class="@(mult > 1.0 ? "text-warning" : "text-muted")">@(mult > 1.0 ? $"×{mult:0.#}" : "×1.0")</td>
                                }
                            </tr>
                        }
                        <tr>
                            <td class="text-start text-muted small">Sync Grid Bonus</td>
                            @foreach (var s in statsKeys)
                            {
                                int gBonus = 0;
                                foreach (var cell in Pair.Grid)
                                {
                                    if (GridState.ActiveCells.Contains(cell.CellId) && cell.StatBonus.TryGetValue(s, out int sb))
                                        gBonus += sb;
                                }
                                <td class="@(gBonus > 0 ? "text-info" : "text-muted")">@(gBonus > 0 ? $"+{gBonus}" : "-")</td>
                            }
                        </tr>
                        <tr class="table-active fw-bold fs-6">
                            <td class="text-start text-warning">Total Stat</td>
                            @foreach (var s in statsKeys)
                            {
                                int rawBase = Pair.Stats.GetStatAtLevel(s, lvl);
                                int potVal = pot.GetValueOrDefault(s, 0);
                                int exVal = ex.GetValueOrDefault(s, 0);
                                double formMult = currentVariation?.StatMultiplier.GetValueOrDefault(s, 1.0) ?? 1.0;

                                int gBonus = 0;
                                foreach (var cell in Pair.Grid)
                                {
                                    if (GridState.ActiveCells.Contains(cell.CellId) && cell.StatBonus.TryGetValue(s, out int sb))
                                        gBonus += sb;
                                }

                                int total = CalcService.CalcTotalStat(
                                    s,
                                    rawBase,
                                    0,
                                    potential: potVal,
                                    exBonus: exVal,
                                    formMult: formMult,
                                    hasSa: Pair.HasSuperAwakening,
                                    saLevel: Ally.SuperAwakeningLevel,
                                    role: Pair.Role,
                                    gridStat: gBonus
                                );

                                <td class="text-warning">@total</td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Moves and Passives -->
        <div class="row g-3">
            <!-- Moves Section (with Dynamic Base Power according to Move Level & SA) -->
            <div class="col-lg-6">
                <div class="card bg-dark border-secondary h-100 p-3">
                    @{
                        int effectiveLvl = Ally.SuperAwakeningLevel > 0 ? (5 + Ally.SuperAwakeningLevel) : Ally.MoveLevel;
                    }
                    <h6 class="text-warning fw-bold mb-3 d-flex align-items-center justify-content-between">
                        <span class="d-flex align-items-center gap-2">
                            <i class="bi bi-lightning-fill"></i> Moves
                        </span>
                        <span class="badge bg-secondary text-light small">
                            Move Lv. @effectiveLvl/5 @(Ally.SuperAwakeningLevel > 0 ? $" (SA {Ally.SuperAwakeningLevel})" : "")
                        </span>
                    </h6>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var move in Pair.Moves)
                        {
                            int rawPwr = int.TryParse(move.Power, out int rp) ? rp : 0;
                            int scaledPwr = rawPwr > 0 ? CalcService.CalcPower(rawPwr, effectiveLvl, Pair.Role, move.IsSync) : 0;
                            int multPct = rawPwr > 0 ? CalcService.GetMoveMultiplier(effectiveLvl, Pair.Role, move.IsSync) : 100;

                            <div class="card bg-secondary bg-opacity-25 border-secondary p-2">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="fw-bold text-light">@move.Name</div>
                                        <div class="d-flex gap-1 align-items-center mt-1">
                                            <span class="badge type-badge type-@move.Type.ToLowerInvariant()">@move.Type</span>
                                            <span class="badge bg-secondary">@move.Category</span>
                                            @if (move.IsSync)
                                            {
                                                <span class="badge bg-purple">Sync Move</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="text-end small">
                                        @if (scaledPwr > 0)
                                        {
                                            <div>Power: <b class="text-warning">@scaledPwr</b> <span class="text-muted" style="font-size: 0.75rem;">(@multPct%)</span></div>
                                        }
                                        else
                                        {
                                            <div>Power: <b class="text-muted">-</b></div>
                                        }
                                        <div>Acc: <b>@move.Accuracy</b> | Gauge: <b>@move.Gauge</b></div>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(move.Description))
                                {
                                    <div class="text-secondary small mt-2">@move.Description</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Passives Section -->
            <div class="col-lg-6">
                <div class="card bg-dark border-secondary h-100 p-3">
                    <h6 class="text-success fw-bold mb-3 d-flex align-items-center justify-content-between">
                        <span class="d-flex align-items-center gap-2">
                            <i class="bi bi-shield-check"></i> Passive Skills
                        </span>
                        @if (Ally.FormIndex > 0 && Ally.FormIndex <= Pair.Variations.Count)
                        {
                            <span class="badge bg-warning text-dark small">@Pair.Variations[Ally.FormIndex - 1].FormName Passives</span>
                        }
                    </h6>
                    <div class="d-flex flex-column gap-2">
                        @{
                            var activePassives = (Ally.FormIndex > 0 && Ally.FormIndex <= Pair.Variations.Count && Pair.Variations[Ally.FormIndex - 1].Passives.Count > 0)
                                ? Pair.Variations[Ally.FormIndex - 1].Passives
                                : Pair.Passives;
                        }
                        @foreach (var passive in activePassives)
                        {
                            <div class="card bg-secondary bg-opacity-25 border-secondary p-2">
                                <div class="fw-bold text-light">@passive.Name</div>
                                <div class="text-secondary small mt-1">@passive.Description</div>
                                @if (passive.ChildPassives.Count > 0)
                                {
                                    <div class="mt-2 pt-2 border-top border-secondary">
                                        <span class="text-muted small fw-bold">Combined Skills:</span>
                                        @foreach (var child in passive.ChildPassives)
                                        {
                                            <div class="small ms-2 mt-1">
                                                <span class="text-info">• @child.Name:</span> <span class="text-muted">@child.Description</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        <!-- Super Awakening Passive (Unlocked at SA 5) -->
                        @if (Pair.HasSuperAwakening && Pair.SuperAwakeningPassive != null && !string.IsNullOrEmpty(Pair.SuperAwakeningPassive.Name))
                        {
                            bool isSa5Active = Ally.SuperAwakeningLevel >= 5;
                            <div class="card @(isSa5Active ? "border-danger bg-danger bg-opacity-10" : "border-secondary bg-secondary bg-opacity-10 opacity-75") p-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="fw-bold @(isSa5Active ? "text-danger" : "text-secondary")">
                                        <i class="bi bi-star-fill text-warning me-1"></i> @Pair.SuperAwakeningPassive.Name
                                    </div>
                                    <span class="badge @(isSa5Active ? "bg-danger text-light" : "bg-secondary text-muted")" style="font-size: 0.7rem;">
                                        @(isSa5Active ? "SA 5 Active" : "SA 5 Required")
                                    </span>
                                </div>
                                <div class="text-secondary small">@Pair.SuperAwakeningPassive.Description</div>
                            </div>
                        }

                        <!-- Active Grid Passives -->
                        @{
                            var activeGridPassives = Pair.Grid
                                .Where(c => GridState.ActiveCells.Contains(c.CellId) &&
                                            (c.ColorKind.Equals("passive", StringComparison.OrdinalIgnoreCase) ||
                                             c.ColorKind.Equals("move effect", StringComparison.OrdinalIgnoreCase) ||
                                             c.ColorKind.Equals("learn", StringComparison.OrdinalIgnoreCase)))
                                .ToList();
                        }
                        @if (activeGridPassives.Count > 0)
                        {
                            <div class="mt-2 pt-2 border-top border-secondary">
                                <div class="text-info small fw-bold mb-2">
                                    <i class="bi bi-grid-fill me-1"></i> Active Grid Skills (@activeGridPassives.Count):
                                </div>
                                <div class="d-flex flex-column gap-1">
                                    @foreach (var gc in activeGridPassives)
                                    {
                                        <div class="p-1 px-2 rounded bg-dark border border-secondary small">
                                            <b class="text-warning">@gc.Title</b>
                                            @if (!string.IsNullOrEmpty(gc.Description))
                                            {
                                                <span class="text-muted ms-1">- @gc.Description</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public SyncPairDetail? Pair { get; set; }
    [Parameter] public CombatantState Ally { get; set; } = new();
    [Parameter] public int MoveLevel { get; set; } = 5;
    [Parameter] public EventCallback<int> MoveLevelChanged { get; set; }

    protected override void OnInitialized()
    {
        GridState.OnGridChanged += OnGridUpdated;
    }

    private void OnGridUpdated()
    {
        InvokeAsync(StateHasChanged);
    }

    private void SetForm(int idx)
    {
        Ally.FormIndex = idx;
        StateHasChanged();
    }

    private async Task OnMoveLevelSelect(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            Ally.MoveLevel = val;
            int fullLvl = Ally.SuperAwakeningLevel > 0 ? (5 + Ally.SuperAwakeningLevel) : val;
            await MoveLevelChanged.InvokeAsync(fullLvl);
            StateHasChanged();
        }
    }

    private async Task OnSaLevelSelect(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            Ally.SuperAwakeningLevel = val;
            int fullLvl = val > 0 ? (5 + val) : Ally.MoveLevel;
            await MoveLevelChanged.InvokeAsync(fullLvl);
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        GridState.OnGridChanged -= OnGridUpdated;
    }
}