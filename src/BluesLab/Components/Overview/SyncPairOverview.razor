@using BluesLab.Models
@using BluesLab.Services
@inject DamageCalculatorService CalcService
@inject GridStateService GridState
@implements IDisposable

<div class="sync-pair-overview">
    @if (Pair == null)
    {
        <div class="text-center py-5 text-muted">Please select a Sync Pair to view overview.</div>
    }
    else
    {
        <!-- Header Info & Settings Bar -->
        <div class="card bg-dark border-secondary p-2 mb-2 shadow-sm">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-2">
                    <img src="@Pair.IconUrl" alt="@Loc.GetDisplayName(Pair)" width="44" height="44" class="rounded-circle border border-warning shadow-sm" onerror="this.src='img/trainers/unknown.png';" />
                    <div>
                        <div class="d-flex align-items-center flex-wrap gap-1">
                            <span class="fw-bold text-light" style="font-size: 1rem;">@Loc.GetDisplayName(Pair)</span>
                            @if (Ally.FormIndex > 0 && Ally.FormIndex <= Pair.Variations.Count)
                            {
                                <span class="badge bg-warning text-dark py-0 px-1" style="font-size: 0.7rem;">(@Pair.Variations[Ally.FormIndex - 1].FormName)</span>
                            }
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-1 mt-0.5">
                            <span class="badge type-badge type-@EffectivePairType.ToLowerInvariant() py-0 px-1.5" style="font-size: 0.7rem;">@Loc.GetTypeName(EffectivePairType)</span>
                            <span class="badge bg-secondary py-0 px-1.5" style="font-size: 0.7rem;">@Loc.GetRoleName(Pair.Role)</span>
                            @if (!string.IsNullOrEmpty(Pair.ExRole))
                            {
                                <span class="badge bg-indigo py-0 px-1.5" style="font-size: 0.7rem;">@Loc.T("ex_role", "EX Role"): @Loc.GetRoleName(Pair.ExRole)</span>
                            }
                            @if (!string.IsNullOrEmpty(Pair.Weakness))
                            {
                                <span class="badge bg-dark border border-danger text-danger py-0 px-1.5" style="font-size: 0.7rem;">@Loc.T("weakness", "Weakness"): @Loc.GetTypeName(Pair.Weakness)</span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Form Switcher Buttons (Base, Mega, Tera) -->
                @if (Pair.Variations.Count > 0 || Pair.HasMega || Pair.HasTera)
                {
                    <div class="btn-group btn-group-sm">
                        <button class="btn @(Ally.FormIndex == 0 ? "btn-warning fw-bold" : "btn-outline-secondary") py-0 px-2" style="font-size: 0.78rem; height: 28px;" @onclick="() => SetForm(0)">
                            @Loc.T("base_info", "Base Form")
                        </button>
                        @for (int i = 0; i < Pair.Variations.Count; i++)
                        {
                            int idx = i + 1;
                            var v = Pair.Variations[i];
                            string formLabel = (v.FormId == 4 || v.FormName == "Form 4") ? "Dynamax" : v.FormName;
                            <button class="btn @(Ally.FormIndex == idx ? "btn-warning fw-bold" : "btn-outline-secondary") py-0 px-2" style="font-size: 0.78rem; height: 28px;" @onclick="() => SetForm(idx)">
                                @formLabel
                            </button>
                        }
                    </div>
                }

                <!-- Star Level, Level, Move Level & EX Role Controls -->
                <div class="d-flex flex-wrap align-items-center gap-1">
                    <!-- Move Level Selector (1-5) -->
                    <div class="d-flex align-items-center gap-1 bg-secondary bg-opacity-25 px-2 rounded border border-secondary" style="height: 28px;">
                        <span class="small text-muted fw-bold" style="font-size: 0.72rem;">@Loc.T("level", "Move Lv"):</span>
                        <select class="form-select form-select-sm bg-dark text-light border-0 p-0" style="width: 46px; font-size: 0.8rem;" value="@Ally.MoveLevel" @onchange="OnMoveLevelSelect">
                            <option value="1">1/5</option>
                            <option value="2">2/5</option>
                            <option value="3">3/5</option>
                            <option value="4">4/5</option>
                            <option value="5">5/5</option>
                        </select>
                    </div>

                    <select class="form-select form-select-sm bg-dark text-light border-secondary px-1.5" style="width: 88px; height: 28px; font-size: 0.8rem;" @bind="Ally.StarLevel" @bind:after="StateHasChanged">
                        <option value="3★">3★</option>
                        <option value="4★">4★</option>
                        <option value="5★">5★</option>
                        <option value="5★ 20/20">5★ 20/20</option>
                        @if (Pair.HasEx)
                        {
                            <option value="5★ EX">5★ EX</option>
                        }
                    </select>

                    <!-- Level Selector -->
                    <select class="form-select form-select-sm bg-dark text-light border-secondary px-1.5" style="width: 82px; height: 28px; font-size: 0.8rem;" @bind="Ally.CharLevel" @bind:after="StateHasChanged">
                        <option value="1">Lv. 1</option>
                        <option value="30">Lv. 30</option>
                        <option value="45">Lv. 45</option>
                        <option value="100">Lv. 100</option>
                        <option value="120">Lv. 120</option>
                        <option value="130">Lv. 130</option>
                        <option value="140">Lv. 140</option>
                        <option value="150">Lv. 150</option>
                        <option value="180">Lv. 180</option>
                        <option value="200">Lv. 200</option>
                    </select>

                    @if (Pair.HasSuperAwakening)
                    {
                        <div class="d-flex align-items-center gap-1 bg-secondary bg-opacity-25 px-1.5 rounded border border-danger" style="height: 28px;">
                            <span class="text-danger fw-bold" style="font-size: 0.72rem;">SA:</span>
                            <select class="form-select form-select-sm bg-dark text-light border-0 p-0" style="width: 36px; font-size: 0.8rem;" value="@Ally.SuperAwakeningLevel" @onchange="OnSaLevelSelect">
                                <option value="0">0</option>
                                <option value="1">1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                                <option value="4">4</option>
                                <option value="5">5</option>
                            </select>
                        </div>
                    }

                    @if (Pair.HasEx && !string.IsNullOrEmpty(Pair.ExRole))
                    {
                        <button class="btn btn-sm @(Ally.HasExRole ? "btn-indigo" : "btn-outline-secondary") py-0 px-2" style="height: 28px; font-size: 0.8rem;" @onclick="() => { Ally.HasExRole = !Ally.HasExRole; StateHasChanged(); }">
                            EX Role
                        </button>
                    }
                </div>
            </div>

            <!-- Stats Bar (Integrated into Top Box) -->
            @{
                int lvl = int.TryParse(Ally.CharLevel, out int l) ? l : 180;
                var pot = CalcService.CalcPotentialBonus(Pair.Rarity, Ally.StarLevel);
                var ex = Ally.HasExRole ? CalcService.GetExRoleBonus(Pair.ExRole) : new();
                string[] statsKeys = ["hp", "atk", "def", "spa", "spd", "spe"];
                var currentVariation = (Ally.FormIndex > 0 && Ally.FormIndex <= Pair.Variations.Count)
                    ? Pair.Variations[Ally.FormIndex - 1]
                    : null;
                bool isSaActive = Pair.HasSuperAwakening && Ally.SuperAwakeningLevel >= 1;
            }

            <div class="mt-2 pt-2 border-top border-secondary border-opacity-50">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <!-- Compact 6-Pill Stats Grid -->
                    <div class="row g-1 flex-grow-1 align-items-center" style="margin: 0; min-width: 270px;">
                        @foreach (var s in statsKeys)
                        {
                            int rawBase = Pair.Stats.GetStatAtLevel(s, lvl);
                            int saBase = rawBase;
                            if (isSaActive)
                            {
                                saBase = (int)Math.Ceiling(rawBase * 1.1) + (rawBase % 10 != 0 ? -1 : 0);
                                if (Pair.Role.Trim().StartsWith("Support", StringComparison.OrdinalIgnoreCase))
                                {
                                    var saFlat = CalcService.GetSaSupportFlatBonus(Ally.SuperAwakeningLevel);
                                    if (saFlat.TryGetValue(s, out int fb))
                                        saBase += fb;
                                }
                            }

                            int potVal = pot.GetValueOrDefault(s, 0);
                            int exVal = ex.GetValueOrDefault(s, 0);
                            double formMult = currentVariation?.StatMultiplier.GetValueOrDefault(s, 1.0) ?? 1.0;

                            int gBonus = 0;
                            foreach (var cell in Pair.Grid)
                            {
                                if (GridState.ActiveCells.Contains(cell.CellId) && cell.StatBonus.TryGetValue(s, out int sb))
                                    gBonus += sb;
                            }

                            double inBattleMult = Field != null
                                ? CalcService.GetInBattleStatMultiplier(s, Ally, Field, GridState.ActiveCells)
                                : 1.0;

                            int total = CalcService.CalcTotalStat(
                                s,
                                rawBase,
                                0,
                                potential: potVal,
                                exBonus: exVal,
                                formMult: formMult,
                                inBattleStatMult: inBattleMult,
                                hasSa: Pair.HasSuperAwakening,
                                saLevel: Ally.SuperAwakeningLevel,
                                role: Pair.Role,
                                gridStat: gBonus
                            );

                            string tooltip = $"Base: {saBase} | Potential/EX: +{potVal + exVal} | Grid: +{gBonus} | Form: x{formMult:0.#}{(inBattleMult != 1.0 ? $" | Battle: x{inBattleMult:0.##}" : "")} => Total: {total}";

                            <div class="col" style="padding: 0 2px;">
                                <div class="py-1 px-1 rounded bg-black bg-opacity-30 border border-secondary text-center" title="@tooltip" style="cursor: pointer;" @onclick="() => ShowDetailedStats = !ShowDetailedStats">
                                    <div class="text-uppercase text-secondary fw-bold" style="font-size: 0.68rem; letter-spacing: 0.5px; line-height: 1;">@s</div>
                                    <div class="fw-bold text-warning" style="font-size: 1.05rem; line-height: 1.2;">@total</div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Right Side: SA Badge & Detailed Breakdown Button -->
                    <div class="d-flex align-items-center gap-1.5 ms-auto">
                        @if (isSaActive)
                        {
                            <span class="badge bg-danger text-light py-1 px-1.5" style="font-size: 0.68rem; white-space: nowrap;">SA +10% Active</span>
                        }
                        <button class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center text-light"
                                style="height: 38px; width: 38px; min-width: 38px;"
                                title="@(ShowDetailedStats ? "Hide Breakdown" : "Detailed Breakdown")"
                                @onclick="() => ShowDetailedStats = !ShowDetailedStats">
                            <i class="bi @(ShowDetailedStats ? "bi-chevron-up" : "bi-chevron-down")" style="font-size: 0.95rem;"></i>
                        </button>
                    </div>
                </div>

                <!-- Detailed Breakdown Accordion Table -->
                @if (ShowDetailedStats)
                {
                    <div class="table-responsive mt-2 pt-1 border-top border-secondary">
                        <table class="table table-dark table-sm table-bordered text-center align-middle mb-0" style="font-size: 0.78rem;">
                            <thead>
                                <tr class="text-secondary small">
                                    <th class="text-start">Category</th>
                                    <th style="width: 15%;">HP</th>
                                    <th style="width: 15%;">Attack</th>
                                    <th style="width: 15%;">Defense</th>
                                    <th style="width: 15%;">Sp. Atk</th>
                                    <th style="width: 15%;">Sp. Def</th>
                                    <th style="width: 15%;">Speed</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="text-start text-muted">
                                        Base Stat (Lv. @Ally.CharLevel)
                                        @if (isSaActive)
                                        {
                                            <span class="badge bg-danger text-light ms-1 py-0 px-1" style="font-size: 0.6rem;">+10% SA</span>
                                        }
                                    </td>
                                    @foreach (var s in statsKeys)
                                    {
                                        int rawBase = Pair.Stats.GetStatAtLevel(s, lvl);
                                        int saBase = rawBase;
                                        if (isSaActive)
                                        {
                                            saBase = (int)Math.Ceiling(rawBase * 1.1) + (rawBase % 10 != 0 ? -1 : 0);
                                            if (Pair.Role.Trim().StartsWith("Support", StringComparison.OrdinalIgnoreCase))
                                            {
                                                var saFlat = CalcService.GetSaSupportFlatBonus(Ally.SuperAwakeningLevel);
                                                if (saFlat.TryGetValue(s, out int fb))
                                                    saBase += fb;
                                            }
                                        }
                                        <td>@saBase</td>
                                    }
                                </tr>
                                <tr>
                                    <td class="text-start text-muted">Potential + EX Role</td>
                                    @foreach (var s in statsKeys)
                                    {
                                        int bonus = pot.GetValueOrDefault(s, 0) + ex.GetValueOrDefault(s, 0);
                                        <td class="@(bonus > 0 ? "text-success" : "text-muted")">@(bonus > 0 ? $"+{bonus}" : "-")</td>
                                    }
                                </tr>
                                @if (currentVariation != null)
                                {
                                    <tr>
                                        <td class="text-start text-muted">Form Multiplier (@currentVariation.FormName)</td>
                                        @foreach (var s in statsKeys)
                                        {
                                            double mult = currentVariation.StatMultiplier.GetValueOrDefault(s, 1.0);
                                            <td class="@(mult > 1.0 ? "text-warning" : "text-muted")">@(mult > 1.0 ? $"×{mult:0.#}" : "×1.0")</td>
                                        }
                                    </tr>
                                }
                                <tr>
                                    <td class="text-start text-muted">Sync Grid Bonus</td>
                                    @foreach (var s in statsKeys)
                                    {
                                        int gBonus = 0;
                                        foreach (var cell in Pair.Grid)
                                        {
                                            if (GridState.ActiveCells.Contains(cell.CellId) && cell.StatBonus.TryGetValue(s, out int sb))
                                                gBonus += sb;
                                        }
                                        <td class="@(gBonus > 0 ? "text-info" : "text-muted")">@(gBonus > 0 ? $"+{gBonus}" : "-")</td>
                                    }
                                </tr>
                                <tr class="table-active fw-bold">
                                    <td class="text-start text-warning">Total Stat</td>
                                    @foreach (var s in statsKeys)
                                    {
                                        int rawBase = Pair.Stats.GetStatAtLevel(s, lvl);
                                        int potVal = pot.GetValueOrDefault(s, 0);
                                        int exVal = ex.GetValueOrDefault(s, 0);
                                        double formMult = currentVariation?.StatMultiplier.GetValueOrDefault(s, 1.0) ?? 1.0;

                                        int gBonus = 0;
                                        foreach (var cell in Pair.Grid)
                                        {
                                            if (GridState.ActiveCells.Contains(cell.CellId) && cell.StatBonus.TryGetValue(s, out int sb))
                                                gBonus += sb;
                                        }

                                        double inBattleMult = Field != null
                                            ? CalcService.GetInBattleStatMultiplier(s, Ally, Field, GridState.ActiveCells)
                                            : 1.0;

                                        int total = CalcService.CalcTotalStat(
                                            s,
                                            rawBase,
                                            0,
                                            potential: potVal,
                                            exBonus: exVal,
                                            formMult: formMult,
                                            inBattleStatMult: inBattleMult,
                                            hasSa: Pair.HasSuperAwakening,
                                            saLevel: Ally.SuperAwakeningLevel,
                                            role: Pair.Role,
                                            gridStat: gBonus
                                        );

                                        <td class="text-warning">@total</td>
                                    }
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Section Switcher Tabs: Moves vs Passives -->
        <div class="card bg-dark border-secondary p-2 shadow-sm mb-2">
            @{
                var activeGridPassives = Pair.Grid
                    .Where(c => GridState.ActiveCells.Contains(c.CellId) &&
                                (c.ColorKind.Equals("passive", StringComparison.OrdinalIgnoreCase) ||
                                 c.ColorKind.Equals("move effect", StringComparison.OrdinalIgnoreCase) ||
                                 c.ColorKind.Equals("learn", StringComparison.OrdinalIgnoreCase)))
                    .ToList();
                bool isDynamaxActive = CalcService.IsDynamaxActive(Pair, Ally.FormIndex);
                var maxMovesList = CalcService.GetMaxMoves(Pair);
                var displayMoves = isDynamaxActive ? maxMovesList : Pair.Moves;
                var currentVar = (Ally.FormIndex > 0 && Ally.FormIndex <= Pair.Variations.Count)
                    ? Pair.Variations[Ally.FormIndex - 1]
                    : null;
            }

            <div class="d-flex flex-wrap align-items-center justify-content-between gap-1 mb-2 pb-1 border-bottom border-secondary">
                <div class="nav nav-pills gap-1" role="tablist">
                    <button class="btn btn-sm @(ActiveSection == "moves" ? (isDynamaxActive ? "btn-pink text-white fw-bold" : "btn-warning text-dark fw-bold") : "btn-outline-secondary text-light") py-1 px-2.5"
                            style="font-size: 0.8rem;"
                            @onclick='() => SetSection("moves")'>
                        @if (isDynamaxActive)
                        {
                            <i class="bi bi-clouds-fill me-1"></i> @Loc.T("turn_max_move", "Max Moves") <text>(@displayMoves.Count)</text>
                        }
                        else
                        {
                            <i class="bi bi-lightning-fill me-1"></i> @Loc.T("moves", "Moves") <text>(@displayMoves.Count)</text>
                        }
                    </button>
                    <button class="btn btn-sm @(ActiveSection == "passives" ? "btn-success text-dark fw-bold" : "btn-outline-secondary text-light") py-1 px-2.5"
                            style="font-size: 0.8rem;"
                            @onclick='() => SetSection("passives")'>
                        <i class="bi bi-shield-check me-1"></i> @Loc.T("passives", "Passives") (@(GetEffectivePassives().Count))
                    </button>
                    <button class="btn btn-sm @(ActiveSection == "grid" ? "btn-info text-dark fw-bold" : "btn-outline-secondary text-light") py-1 px-2.5"
                            style="font-size: 0.8rem;"
                            @onclick='() => SetSection("grid")'>
                        <i class="bi bi-grid-fill me-1"></i> @Loc.T("grid_date", "Grid Skills") (@activeGridPassives.Count)
                    </button>
                </div>

                @if (ActiveSection == "moves" && displayMoves.Count > 0)
                {
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2 text-light"
                            style="font-size: 0.75rem; height: 26px;"
                            @onclick="ToggleAllMoveDescs"
                            title="@(AllExpanded ? "Collapse all move descriptions" : "Expand all move descriptions")">
                        <i class="bi @(AllExpanded ? "bi-chevron-contract" : "bi-chevron-expand") me-1"></i>
                        @(AllExpanded ? Loc.T("collapse_all", "Collapse All") : Loc.T("expand_all", "Expand All"))
                    </button>
                }
            </div>

            <!-- Moves View -->
            @if (ActiveSection == "moves")
            {
                int effectiveLvl = isDynamaxActive
                    ? Math.Clamp(Ally.MoveLevel, 1, 5)
                    : (Ally.SuperAwakeningLevel > 0 ? (5 + Ally.SuperAwakeningLevel) : Ally.MoveLevel);

                <div class="d-flex flex-column gap-1">
                    @foreach (var move in displayMoves)
                    {
                        var (scaledPwr, multPct) = GetEffectiveMovePower(move, effectiveLvl);
                        string moveType = GetEffectiveMoveType(move);
                        string moveTarget = GetEffectiveMoveTarget(move);
                        bool isExpanded = !CollapsedMoveIds.Contains(move.Id);
                        string mName = Loc.GetMoveName(move.Id, move.Name);
                        string mDesc = Loc.GetMoveDescription(move.Id, move.Description);

                        <div class="card move-card move-card-@moveType.ToLowerInvariant() px-3 py-2 shadow-sm @(move.IsMax ? "border-pink" : "")">
                            <div class="d-flex justify-content-between align-items-center cursor-pointer" @onclick="() => ToggleMoveDesc(move.Id)">
                                <div>
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="fw-bold text-light" style="font-size: 0.95rem;">@mName</span>
                                        @if (move.IsSync)
                                        {
                                            <span class="badge bg-purple py-0 px-1" style="font-size: 0.7rem;">@Loc.T("turn_sync_move", "Sync Move")</span>
                                        }
                                        else if (move.IsMax)
                                        {
                                            <span class="badge btn-pink text-white py-0 px-1" style="font-size: 0.7rem;">@Loc.T("turn_max_move", "Max Move")</span>
                                        }
                                        else if (move.IsTerastalMove)
                                        {
                                            <span class="badge bg-info text-dark py-0 px-1" style="font-size: 0.7rem;">Terastal Move</span>
                                            @if (currentVar == null || currentVar.TerastalMoveId != move.Id)
                                            {
                                                <span class="badge bg-secondary text-light py-0 px-1" style="font-size: 0.65rem;" title="Requires Sync Terastallization to use">Locked</span>
                                            }
                                        }
                                    </div>
                                    <div class="d-flex gap-1 align-items-center mt-0.5 flex-wrap">
                                        @if (move.IsTrainerMove)
                                        {
                                            <span class="badge py-0 px-1" style="background-color: #38bdf8; color: #021427; font-size: 0.7rem; font-weight: 700;">Trainer Move</span>
                                        }
                                        else
                                        {
                                            <span class="badge type-badge type-@moveType.ToLowerInvariant() py-0 px-1" style="font-size: 0.7rem;">@Loc.GetTypeName(moveType)</span>
                                            <span class="badge bg-secondary py-0 px-1" style="font-size: 0.7rem;">@move.Category</span>
                                        }
                                        @if (!string.IsNullOrEmpty(moveTarget))
                                        {
                                            <span class="badge bg-dark border border-secondary text-light opacity-75 py-0 px-1" style="font-size: 0.7rem;">@moveTarget</span>
                                        }
                                    </div>
                                </div>

                                <div class="d-flex align-items-center gap-3">
                                    <div class="text-end small" style="line-height: 1.3;">
                                        @if (scaledPwr > 0)
                                        {
                                            <div>
                                                <span style="color: rgba(255, 255, 255, 0.75);">@Loc.T("damage_result_power", "Power"):</span>
                                                <b class="text-warning">@scaledPwr</b>
                                                <span style="color: rgba(255, 255, 255, 0.6); font-size: 0.72rem;">(@multPct%)</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div>
                                                <span style="color: rgba(255, 255, 255, 0.75);">@Loc.T("damage_result_power", "Power"):</span>
                                                <b style="color: rgba(255, 255, 255, 0.5);">-</b>
                                            </div>
                                        }
                                        <div style="font-size: 0.75rem; color: rgba(255, 255, 255, 0.75);">
                                            @if (move.IsMax)
                                            {
                                                <span>Acc: <b class="text-light">-</b> | Gauge: <b class="text-light">-</b> | @Loc.T("damage_move_uses", "Uses"): <b style="color: #ff79b0;">1</b></span>
                                            }
                                            else
                                            {
                                                <span>Acc: <b class="text-light">@(string.IsNullOrEmpty(move.Accuracy) || move.Accuracy == "0" ? "-" : move.Accuracy)</b> | Gauge: <b class="text-light">@(string.IsNullOrEmpty(move.Gauge) || move.Gauge == "0" ? "-" : move.Gauge)</b></span>
                                                @if (move.MaxUses > 0)
                                                {
                                                    <span class="ms-1">| @Loc.T("damage_move_uses", "Uses"): <b style="color: #38bdf8;">@move.MaxUses</b></span>
                                                }
                                            }
                                        </div>
                                    </div>

                                    <button class="btn btn-sm btn-outline-secondary py-0 px-1 text-light" style="font-size: 0.75rem; height: 24px; width: 24px;" title="Toggle Description">
                                        <i class="bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                    </button>
                                </div>
                            </div>

                            @if (isExpanded && !string.IsNullOrEmpty(mDesc))
                            {
                                <div class="text-light small mt-1 pt-1 border-top border-secondary border-opacity-50" style="font-size: 0.82rem; line-height: 1.35; color: rgba(255, 255, 255, 0.9) !important;">
                                    <div>@mDesc</div>
                                </div>
                            }
                        </div>
                    }

                    @if (!isDynamaxActive && maxMovesList.Count > 0)
                    {
                        var dynamaxIdx = Pair.Variations.FindIndex(v => v.FormId == 4 || v.FormName.Equals("Dynamax", StringComparison.OrdinalIgnoreCase) || v.FormName.Equals("Form 4", StringComparison.OrdinalIgnoreCase)) + 1;
                        if (dynamaxIdx > 0)
                        {
                            <div class="d-flex align-items-center justify-content-between p-2 rounded bg-pink bg-opacity-10 border border-pink mt-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge btn-pink text-white"><i class="bi bi-clouds-fill me-1"></i> Dynamax Available</span>
                                    <span class="text-light small">This sync pair can Dynamax! Switch to <b>Dynamax</b> form to view its Max Moves.</span>
                                </div>
                                <button class="btn btn-sm btn-pink py-0 px-2 text-white" style="font-size: 0.75rem;" @onclick="() => SetForm(dynamaxIdx)">
                                    Switch to Dynamax &rarr;
                                </button>
                            </div>
                        }
                    }
                </div>
            }

            <!-- Passives View -->
            @if (ActiveSection == "passives")
            {
                <div class="d-flex flex-column gap-1.5">
                    @{
                        var activePassives = GetEffectivePassives();
                    }
                    @foreach (var passive in activePassives)
                    {
                        string pName = Loc.GetPassiveName(passive.Id, passive.Name);
                        string pDesc = Loc.GetPassiveDescription(passive.Id, passive.Description);
                        bool isSubstituted = Ally.FormIndex > 0 && Pair.Passives.All(bp => bp.Id != passive.Id);

                        <div class="card bg-dark bg-opacity-75 @(isSubstituted ? "border-warning border-opacity-75" : "border-secondary") px-3 py-2 shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div class="fw-bold text-white" style="font-size: 0.95rem; letter-spacing: 0.2px;">@pName</div>
                                @if (isSubstituted && Ally.FormIndex <= Pair.Variations.Count)
                                {
                                    <span class="badge bg-warning text-dark py-0.5 px-1.5 fw-semibold" style="font-size: 0.68rem;">
                                        <i class="bi bi-arrow-repeat me-1"></i>@Pair.Variations[Ally.FormIndex - 1].FormName
                                    </span>
                                }
                            </div>
                            <div style="font-size: 0.85rem; line-height: 1.45; color: rgba(255, 255, 255, 0.88);">@pDesc</div>
                            @if (passive.ChildPassives.Count > 0)
                            {
                                <div class="mt-2 pt-1.5 border-top border-secondary border-opacity-50">
                                    <span class="fw-bold text-uppercase" style="font-size: 0.74rem; letter-spacing: 0.5px; color: rgba(255, 255, 255, 0.6);">@Loc.T("combined_skills", "Combined Skills"):</span>
                                    @foreach (var child in passive.ChildPassives)
                                    {
                                        string cName = Loc.GetPassiveName(child.Id, child.Name);
                                        string cDesc = Loc.GetPassiveDescription(child.Id, child.Description);
                                        <div class="ms-2 mt-1" style="font-size: 0.82rem; line-height: 1.35;">
                                            <span class="text-info fw-semibold">• @cName:</span> <span style="color: rgba(255, 255, 255, 0.85);">@cDesc</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <!-- Super Awakening Passive (Unlocked at SA 5) -->
                    @if (Pair.HasSuperAwakening && Pair.SuperAwakeningPassive != null && !string.IsNullOrEmpty(Pair.SuperAwakeningPassive.Name))
                    {
                        bool isSa5Active = Ally.SuperAwakeningLevel >= 5;
                        string saName = Loc.GetPassiveName(Pair.SuperAwakeningPassive.Id, Pair.SuperAwakeningPassive.Name);
                        string saDesc = Loc.GetPassiveDescription(Pair.SuperAwakeningPassive.Id, Pair.SuperAwakeningPassive.Description);

                        <div class="card @(isSa5Active ? "border-danger bg-danger bg-opacity-15" : "border-secondary bg-dark bg-opacity-75 opacity-75") px-3 py-2 shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div class="fw-bold @(isSa5Active ? "text-danger" : "text-white")" style="font-size: 0.95rem;">
                                    <i class="bi bi-star-fill text-warning me-1"></i> @saName
                                </div>
                                <span class="badge @(isSa5Active ? "bg-danger text-white" : "border border-secondary text-light") py-0.5 px-1.5" style="font-size: 0.72rem;">
                                    @(isSa5Active ? "SA 5 Active" : "SA 5 Required")
                                </span>
                            </div>
                            <div style="font-size: 0.85rem; line-height: 1.45; color: rgba(255, 255, 255, 0.88);">@saDesc</div>
                        </div>
                    }
                </div>
            }

            <!-- Grid Skills View -->
            @if (ActiveSection == "grid")
            {
                <div class="d-flex flex-column gap-1.5">
                    @if (activeGridPassives.Count == 0)
                    {
                        <div class="text-center py-4 small" style="color: rgba(255, 255, 255, 0.65);">
                            No passive skills or special effects activated on the Sync Grid yet.
                        </div>
                    }
                    else
                    {
                        @foreach (var gc in activeGridPassives)
                        {
                            string gTitle = Loc.GetTileTitle(gc.AbilityId, gc.Title);
                            string gDesc = Loc.GetTileDescription(gc.AbilityId, gc.Description);
                            <div class="card bg-dark bg-opacity-75 border border-secondary px-3 py-2 shadow-sm">
                                <div class="fw-bold text-info" style="font-size: 0.9rem;">@gTitle</div>
                                @if (!string.IsNullOrEmpty(gDesc))
                                {
                                    <div class="mt-0.5" style="font-size: 0.83rem; line-height: 1.4; color: rgba(255, 255, 255, 0.85);">@gDesc</div>
                                }
                            </div>
                        }
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public SyncPairDetail? Pair { get; set; }
    [Parameter] public CombatantState Ally { get; set; } = new();
    [Parameter] public FieldState? Field { get; set; }
    [Parameter] public int MoveLevel { get; set; } = 5;
    [Parameter] public EventCallback<int> MoveLevelChanged { get; set; }

    private bool ShowDetailedStats { get; set; } = false;
    private string ActiveSection { get; set; } = "moves";
    private HashSet<int> CollapsedMoveIds { get; set; } = new();
    private string? _lastPairTrainerId;

    protected override void OnInitialized()
    {
        GridState.OnGridChanged += OnGridUpdated;
    }

    protected override void OnParametersSet()
    {
        if (Pair?.TrainerId != _lastPairTrainerId)
        {
            _lastPairTrainerId = Pair?.TrainerId;
            CollapsedMoveIds.Clear();
        }
    }

    private void OnGridUpdated()
    {
        InvokeAsync(StateHasChanged);
    }

    private bool AllExpanded => Pair?.Moves.All(m => !CollapsedMoveIds.Contains(m.Id)) ?? true;

    private void ToggleAllMoveDescs()
    {
        if (Pair == null) return;
        if (AllExpanded)
        {
            foreach (var m in Pair.Moves)
                CollapsedMoveIds.Add(m.Id);
        }
        else
        {
            CollapsedMoveIds.Clear();
        }
        StateHasChanged();
    }

    private string EffectivePairType
    {
        get
        {
            if (Pair == null) return "Normal";
            if (Ally.FormIndex > 0 && Pair.Variations != null && Ally.FormIndex <= Pair.Variations.Count)
            {
                var form = Pair.Variations[Ally.FormIndex - 1];
                if (!string.IsNullOrEmpty(form.Type)) return form.Type;
                if (form.FormName.Contains("Stellar", StringComparison.OrdinalIgnoreCase)) return "Stellar";
            }
            return Pair.Type;
        }
    }

    private string GetEffectiveMoveType(MoveItem move)
    {
        if (move.IsTrainerMove)
        {
            return "Trainer";
        }
        if (move.IsMax)
        {
            return move.Type;
        }

        if (Ally.FormIndex > 0 && Pair?.Variations != null && Ally.FormIndex <= Pair.Variations.Count)
        {
            var form = Pair.Variations[Ally.FormIndex - 1];
            if (form.FormName.Contains("Stellar", StringComparison.OrdinalIgnoreCase) || string.Equals(form.Type, "Stellar", StringComparison.OrdinalIgnoreCase))
            {
                if (move.Name.Contains("Tera Starstorm", StringComparison.OrdinalIgnoreCase) || move.Name.Contains("Kaleidoscopic", StringComparison.OrdinalIgnoreCase) || move.IsSync)
                {
                    return "Stellar";
                }
            }
            else if (!string.IsNullOrEmpty(form.Type))
            {
                return form.Type;
            }
        }
        return move.Type;
    }

    private (int ScaledPower, int MultPct) GetEffectiveMovePower(MoveItem move, int effectiveLvl)
    {
        int rawPwr = int.TryParse(move.Power, out int rp) ? rp : 0;
        if (rawPwr <= 0) return (0, 100);

        bool isStellarForm = Ally.FormIndex > 0 && Pair?.Variations != null && Ally.FormIndex <= Pair.Variations.Count &&
            (Pair.Variations[Ally.FormIndex - 1].FormName.Contains("Stellar", StringComparison.OrdinalIgnoreCase) ||
             string.Equals(Pair.Variations[Ally.FormIndex - 1].Type, "Stellar", StringComparison.OrdinalIgnoreCase));

        if (isStellarForm && !move.IsSync && (move.Name.Contains("Tera Starstorm", StringComparison.OrdinalIgnoreCase) || move.Name.Contains("Kaleidoscopic", StringComparison.OrdinalIgnoreCase)))
        {
            rawPwr *= 2;
        }

        int scaledPwr = CalcService.CalcPower(rawPwr, effectiveLvl, Pair?.Role ?? string.Empty, move.IsSync, isMax: move.IsMax);
        int multPct = CalcService.GetMoveMultiplier(effectiveLvl, Pair?.Role ?? string.Empty, move.IsSync, isMax: move.IsMax);
        return (scaledPwr, multPct);
    }

    private string GetEffectiveMoveTarget(MoveItem move)
    {
        bool isStellarForm = Ally.FormIndex > 0 && Pair?.Variations != null && Ally.FormIndex <= Pair.Variations.Count &&
            (Pair.Variations[Ally.FormIndex - 1].FormName.Contains("Stellar", StringComparison.OrdinalIgnoreCase) ||
             string.Equals(Pair.Variations[Ally.FormIndex - 1].Type, "Stellar", StringComparison.OrdinalIgnoreCase));

        if (isStellarForm && (move.Name.Contains("Tera Starstorm", StringComparison.OrdinalIgnoreCase) || move.Name.Contains("Kaleidoscopic", StringComparison.OrdinalIgnoreCase)))
        {
            return "All opponents";
        }
        return move.Target;
    }

    private List<PassiveItem> GetEffectivePassives()
    {
        if (Pair == null) return new List<PassiveItem>();
        if (Ally.FormIndex > 0 && Pair.Variations != null && Ally.FormIndex <= Pair.Variations.Count)
        {
            var variation = Pair.Variations[Ally.FormIndex - 1];
            if (variation.Passives != null && variation.Passives.Count > 0)
            {
                return variation.Passives;
            }
        }
        return Pair.Passives ?? new List<PassiveItem>();
    }

    private void SetForm(int idx)
    {
        Ally.FormIndex = idx;
        StateHasChanged();
    }

    private void SetSection(string section)
    {
        ActiveSection = section;
        StateHasChanged();
    }

    private void ToggleMoveDesc(int moveId)
    {
        if (CollapsedMoveIds.Contains(moveId))
            CollapsedMoveIds.Remove(moveId);
        else
            CollapsedMoveIds.Add(moveId);
    }

    private async Task OnMoveLevelSelect(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            Ally.MoveLevel = val;
            int fullLvl = Ally.SuperAwakeningLevel > 0 ? (5 + Ally.SuperAwakeningLevel) : val;
            await MoveLevelChanged.InvokeAsync(fullLvl);
            StateHasChanged();
        }
    }

    private async Task OnSaLevelSelect(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            Ally.SuperAwakeningLevel = val;
            int fullLvl = val > 0 ? (5 + val) : Ally.MoveLevel;
            await MoveLevelChanged.InvokeAsync(fullLvl);
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        GridState.OnGridChanged -= OnGridUpdated;
    }
}