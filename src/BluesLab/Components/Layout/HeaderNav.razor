<header class="navbar navbar-dark bg-dark border-bottom border-secondary px-3 py-1.5 shadow-sm">
    <div class="container-fluid p-0 d-flex align-items-center justify-content-between gap-2">
        <!-- Left: Brand & Pair Selector -->
        <div class="d-flex align-items-center gap-2 gap-md-3">
            <span class="navbar-brand fw-bolder text-warning d-flex align-items-center gap-2 mb-0 fs-6">
                <i class="bi bi-cpu-fill"></i> BLUES LAB
            </span>

            @if (CurrentPair != null)
            {
                <button class="btn btn-outline-secondary d-flex align-items-center gap-2 text-light py-1 px-2 border-secondary" @onclick="OnOpenPairPicker">
                    <img src="@CurrentPair.IconUrl" alt="@Loc.GetDisplayName(CurrentPair)" width="28" height="28" class="rounded-circle border border-warning" onerror="this.src='img/trainers/unknown.png';" />
                    <span class="fw-bold small d-none d-sm-inline">@Loc.GetDisplayName(CurrentPair)</span>
                    <span class="badge type-badge type-@CurrentPair.Type.ToLowerInvariant()">@Loc.GetTypeName(CurrentPair.Type)</span>
                    <i class="bi bi-chevron-down small text-muted"></i>
                </button>
            }
            else
            {
                <button class="btn btn-outline-secondary d-flex align-items-center gap-2 text-secondary py-1 px-2 border-secondary" style="height: 34px; opacity: 0.85;" disabled>
                    <div class="spinner-border spinner-border-sm text-warning" role="status"></div>
                    <span class="small">@(Loc.T("loading", "Loading..."))</span>
                </button>
            }
        </div>

        <!-- Right: Language Selector -->
        <div class="d-flex align-items-center gap-1">
            <i class="bi bi-globe2 text-warning small" title="@Loc.T("language", "Language")"></i>
            <select class="form-select form-select-sm bg-dark text-light border-secondary py-0 px-2 cursor-pointer shadow-none"
                    style="font-size: 0.8rem; width: auto; height: 28px;"
                    value="@Loc.CurrentLanguage"
                    @onchange="OnLanguageSelected">
                @foreach (var (langCode, name) in LocalizationService.SupportedLanguages)
                {
                    <option value="@langCode">@name</option>
                }
            </select>
        </div>
    </div>
</header>

@code {
    [Parameter] public SyncPairDetail? CurrentPair { get; set; }
    [Parameter] public int MoveLevel { get; set; } = 5;
    [Parameter] public EventCallback OnOpenPairPicker { get; set; }

    private async Task OnLanguageSelected(ChangeEventArgs e)
    {
        var lang = e.Value?.ToString();
        if (!string.IsNullOrEmpty(lang))
        {
            await Loc.SetLanguageAsync(lang);
        }
    }
}