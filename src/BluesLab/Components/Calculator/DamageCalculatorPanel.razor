@inject DamageCalculatorService CalcService
@inject GridStateService GridState
@implements IDisposable

<div class="damage-calculator-panel p-2">
    @if (Ally.Pair == null)
    {
        <div class="text-center py-5 text-muted">Please select a Sync Pair to calculate damage.</div>
    }
    else
    {
        <!-- Form and Base Settings Bar -->
        <div class="card bg-dark border-secondary p-3 mb-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2">
                    <img src="@Ally.Pair.IconUrl" alt="@Loc.GetDisplayName(Ally.Pair)" width="40" height="40" class="rounded-circle border border-warning" onerror="this.src='img/trainers/unknown.png';" />
                    <div>
                        <div class="fw-bold text-light">@Loc.GetDisplayName(Ally.Pair)</div>
                        <div class="d-flex gap-1 align-items-center">
                            <span class="badge type-badge type-@EffectivePairType.ToLowerInvariant()">@Loc.GetTypeName(EffectivePairType)</span>
                            <span class="badge bg-secondary">@Loc.GetRoleName(Ally.Pair.Role)</span>
                            @if (!string.IsNullOrEmpty(Ally.Pair.ExRole))
                            {
                                <span class="badge bg-indigo">@Loc.T("ex_role", "EX"): @Loc.GetRoleName(Ally.Pair.ExRole)</span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Forms Tab (Base, Mega, Tera) -->
                @if (Ally.Pair.Variations.Count > 0 || Ally.Pair.HasMega || Ally.Pair.HasTera)
                {
                    <div class="btn-group btn-group-sm">
                        <button class="btn @(Ally.FormIndex == 0 ? "btn-warning" : "btn-outline-secondary")" @onclick="() => SetForm(0)">Base Form</button>
                        @for (int i = 0; i < Ally.Pair.Variations.Count; i++)
                        {
                            int idx = i + 1;
                            var v = Ally.Pair.Variations[i];
                            string formLabel = (v.FormId == 4 || v.FormName == "Form 4") ? "Dynamax" : v.FormName;
                            <button class="btn @(Ally.FormIndex == idx ? "btn-warning" : "btn-outline-secondary")" @onclick="() => SetForm(idx)">@formLabel</button>
                        }
                    </div>
                }

                <!-- Star Level, Level, Move Level & SA Controls -->
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <!-- Move Level Selector (1-5) -->
                    <div class="d-flex align-items-center gap-1 bg-secondary bg-opacity-25 px-2 py-1 rounded border border-secondary">
                        <span class="small text-muted fw-bold">Move Lv:</span>
                        <select class="form-select form-select-sm bg-dark text-light border-0 p-0" style="width: 50px;" value="@Ally.MoveLevel" @onchange="OnMoveLevelSelect">
                            <option value="1">1/5</option>
                            <option value="2">2/5</option>
                            <option value="3">3/5</option>
                            <option value="4">4/5</option>
                            <option value="5">5/5</option>
                        </select>
                    </div>

                    <select class="form-select form-select-sm bg-dark text-light border-secondary" style="width: 100px;" @bind="Ally.StarLevel" @bind:after="StateHasChanged">
                        <option value="3★">3★</option>
                        <option value="4★">4★</option>
                        <option value="5★">5★</option>
                        <option value="5★ 20/20">5★ 20/20</option>
                        @if (Ally.Pair.HasEx)
                        {
                            <option value="5★ EX">5★ EX</option>
                        }
                    </select>

                    <select class="form-select form-select-sm bg-dark text-light border-secondary" style="width: 90px;" @bind="Ally.CharLevel" @bind:after="StateHasChanged">
                        <option value="120">Lv. 120</option>
                        <option value="130">Lv. 130</option>
                        <option value="140">Lv. 140</option>
                        <option value="150">Lv. 150</option>
                        <option value="180">Lv. 180</option>
                        <option value="200">Lv. 200</option>
                    </select>

                    @if (Ally.Pair.HasSuperAwakening)
                    {
                        <div class="d-flex align-items-center gap-1 bg-secondary bg-opacity-25 px-2 py-1 rounded border border-danger">
                            <span class="text-danger small fw-bold">SA:</span>
                            <select class="form-select form-select-sm bg-dark text-light border-0 p-0" style="width: 45px;" value="@Ally.SuperAwakeningLevel" @onchange="OnSaLevelSelect">
                                <option value="0">0</option>
                                <option value="1">1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                                <option value="4">4</option>
                                <option value="5">5</option>
                            </select>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Field Effects Card (Above Moves) -->
        <div class="card bg-dark border-secondary p-3 mb-3 shadow-sm">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h6 class="text-success fw-bold mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-clouds"></i> Field Effects
                </h6>
                <div class="d-flex gap-2 align-items-center">
                    @if (!string.IsNullOrEmpty(Field.Zone) || !string.IsNullOrEmpty(Field.Terrain) || !string.IsNullOrEmpty(Field.Weather))
                    {
                        <button class="btn btn-outline-secondary btn-sm py-0 px-2 text-muted" style="font-size: 0.7rem;" @onclick="ResetFieldEffects">
                            Reset Field
                        </button>
                    }
                </div>
            </div>

            <!-- Primary Field Conditions: Zone, Terrain, Weather, Targets -->
            <div class="d-flex flex-wrap align-items-center gap-3">
                <!-- Zone (13 Valid PMEX Zones) -->
                <div class="d-flex align-items-center gap-1">
                    <span class="small text-secondary fw-bold" style="font-size: 0.75rem;">Zone:</span>
                    <div class="input-group input-group-sm" style="width: 170px;">
                        <select class="form-select bg-dark text-light border-secondary py-0" style="font-size: 0.75rem;" @bind="Field.Zone" @bind:after="StateHasChanged">
                            <option value="">None</option>
                            @foreach (var t in CombatantState.ValidZoneTypes)
                            {
                                <option value="@t Zone">@t Zone</option>
                            }
                        </select>
                        <button class="btn py-0 px-2 @(Field.ZoneEx ? "btn-warning" : "btn-outline-secondary text-light")" style="font-size: 0.75rem;" @onclick="() => { Field.ZoneEx = !Field.ZoneEx; StateHasChanged(); }">EX</button>
                    </div>
                </div>

                <!-- Terrain -->
                <div class="d-flex align-items-center gap-1">
                    <span class="small text-secondary fw-bold" style="font-size: 0.75rem;">Terrain:</span>
                    <div class="input-group input-group-sm" style="width: 170px;">
                        <select class="form-select bg-dark text-light border-secondary py-0" style="font-size: 0.75rem;" @bind="Field.Terrain" @bind:after="StateHasChanged">
                            <option value="">None</option>
                            <option value="Electric Terrain">Electric Terrain</option>
                            <option value="Grassy Terrain">Grassy Terrain</option>
                            <option value="Psychic Terrain">Psychic Terrain</option>
                        </select>
                        <button class="btn py-0 px-2 @(Field.TerrainEx ? "btn-warning" : "btn-outline-secondary text-light")" style="font-size: 0.75rem;" @onclick="() => { Field.TerrainEx = !Field.TerrainEx; StateHasChanged(); }">EX</button>
                    </div>
                </div>

                <!-- Weather -->
                <div class="d-flex align-items-center gap-1">
                    <span class="small text-secondary fw-bold" style="font-size: 0.75rem;">Weather:</span>
                    <div class="input-group input-group-sm" style="width: 160px;">
                        <select class="form-select bg-dark text-light border-secondary py-0" style="font-size: 0.75rem;" @bind="Field.Weather" @bind:after="StateHasChanged">
                            <option value="">None</option>
                            <option value="Sunny">Sunny</option>
                            <option value="Rainy">Rainy</option>
                            <option value="Sandstorm">Sandstorm</option>
                            <option value="Hail">Hail</option>
                        </select>
                        <button class="btn py-0 px-2 @(Field.WeatherEx ? "btn-warning" : "btn-outline-secondary text-light")" style="font-size: 0.75rem;" @onclick="() => { Field.WeatherEx = !Field.WeatherEx; StateHasChanged(); }">EX</button>
                    </div>
                </div>

            </div>
        </div>

        <!-- Damage Output Vertical List -->
        <div class="mb-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                <div class="d-flex align-items-center gap-3">
                    <h6 class="text-warning fw-bold text-uppercase mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-lightning-charge-fill"></i> Damage
                    </h6>
                    <div class="d-flex align-items-center gap-1 bg-secondary bg-opacity-25 px-2 py-0.5 rounded border border-secondary" style="font-size: 0.75rem;">
                        <span class="text-light fw-bold">Move Up Next:</span>
                        <select class="form-select form-select-sm bg-dark text-light border-secondary py-0 px-1 text-center"
                                style="width: 52px; font-size: 0.75rem; height: 24px;"
                                value="@MoveUpNextValue"
                                @onchange="OnMoveUpNextSelect">
                            @for (int b = 0; b <= 10; b++)
                            {
                                <option value="@b">@b</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-column gap-2">
                @if (CalcService.IsDynamaxActive(Ally.Pair, Ally.FormIndex))
                {
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge btn-pink text-white px-2 py-1" style="font-size: 0.78rem;">
                                <i class="bi bi-clouds-fill me-1"></i> @Loc.T("turn_max_move", "Max Moves") (Dynamax)
                            </span>
                            <span class="text-muted small" style="font-size: 0.75rem;">(Unaffected by Next Boosts &amp; AoE multi-target penalty)</span>
                        </div>
                    </div>
                }

                @foreach (var move in ActiveMoves)
                {
                    var result = CalcService.CalculateDamage(move, Ally, Enemy, Field, Rules, GridState.ActiveCells);
                    string moveType = GetEffectiveMoveType(move);
                    string mName = Loc.GetMoveName(move.Id, move.Name);
                    <div class="card move-card move-card-@moveType.ToLowerInvariant() p-2 px-3 shadow-sm @(move.IsMax ? "border-pink" : "")">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold text-light fs-6">@mName</span>
                                    @if (move.IsSync)
                                    {
                                        <span class="badge bg-purple" style="font-size: 0.7rem;">@Loc.T("turn_sync_move", "Sync Move")</span>
                                    }
                                    @if (move.IsMax)
                                    {
                                        <span class="badge btn-pink text-white" style="font-size: 0.7rem;">@Loc.T("turn_max_move", "Max Move")</span>
                                    }
                                </div>
                                <div class="d-flex gap-1 align-items-center mt-1">
                                    <span class="badge type-badge type-@moveType.ToLowerInvariant()" style="font-size: 0.7rem;">@Loc.GetTypeName(moveType)</span>
                                    <span class="badge bg-secondary" style="font-size: 0.7rem;">@move.Category</span>
                                    <span class="badge bg-black bg-opacity-50 border border-secondary text-light" style="font-size: 0.7rem;">@Loc.T("damage_result_power", "Power"): <b class="text-warning">@result.ScaledMovePower</b></span>
                                    @if (move.IsMax)
                                    {
                                        <span class="badge py-0 px-1" style="background-color: rgba(232, 67, 147, 0.2); color: #ff79b0; border: 1px solid rgba(232, 67, 147, 0.5); font-size: 0.7rem; font-weight: 600;">
                                            <i class="bi bi-arrow-repeat me-0.5"></i>1 Use
                                        </span>
                                    }
                                    else if (move.MaxUses > 0)
                                    {
                                        <span class="badge py-0 px-1" style="background-color: rgba(56, 189, 248, 0.2); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.5); font-size: 0.7rem; font-weight: 600;">
                                            <i class="bi bi-arrow-repeat me-0.5"></i>@move.MaxUses @(move.MaxUses == 1 ? "Use" : "Uses")
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="text-end">
                                <div class="fs-4 fw-bolder text-warning lh-1">@result.AvgDamage.ToString("N0")</div>
                                <div class="text-secondary small" style="font-size: 0.75rem;">
                                    Min: <b class="text-light">@result.MinDamage.ToString("N0")</b> &bull; Max: <b class="text-light">@result.MaxDamage.ToString("N0")</b>
                                </div>
                            </div>
                        </div>

                        @if (result.Breakdown.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-1 mt-2 pt-1 border-top border-secondary border-opacity-50">
                                @foreach (var pill in result.Breakdown)
                                {
                                    <span class="badge" style="background-color: @pill.Color; font-size: 0.7rem;">
                                        @pill.Label: @pill.Value
                                    </span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- 4. Target & User Cards Section (Target Above User) -->
        <div class="d-flex flex-column gap-2">
            <!-- 4A. Target Card (On Top) -->
            <div class="card bg-dark border-secondary p-3 shadow-sm">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="text-danger fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-crosshair"></i> Target
                    </h6>
                    <div class="d-flex align-items-center gap-1">
                        <span class="small text-secondary fw-bold" style="font-size: 0.75rem;">Opponents:</span>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-sm py-0 px-2 @(Field.TargetCount == 1 ? "btn-primary fw-bold" : "btn-outline-secondary text-light")" style="font-size: 0.75rem;" @onclick="() => { Field.TargetCount = 1; StateHasChanged(); }">1</button>
                            <button class="btn btn-sm py-0 px-2 @(Field.TargetCount == 2 ? "btn-primary fw-bold" : "btn-outline-secondary text-light")" style="font-size: 0.75rem;" @onclick="() => { Field.TargetCount = 2; StateHasChanged(); }">2</button>
                            <button class="btn btn-sm py-0 px-2 @(Field.TargetCount == 3 ? "btn-primary fw-bold" : "btn-outline-secondary text-light")" style="font-size: 0.75rem;" @onclick="() => { Field.TargetCount = 3; StateHasChanged(); }">3</button>
                        </div>
                    </div>
                </div>

                <!-- Target Stat Stages Dropdowns -->
                <div class="row row-cols-2 row-cols-sm-3 row-cols-md-5 g-2">
                    @foreach (var stat in new[] { "def", "spd", "atk", "spa", "spe" })
                    {
                        int val = Enemy.Stages.GetValueOrDefault(stat, -6);
                        <div class="col">
                            <div class="p-1 px-2 rounded bg-black bg-opacity-40 border border-secondary border-opacity-75 d-flex align-items-center justify-content-between gap-1">
                                <span class="small fw-bold text-secondary text-uppercase" style="font-size: 0.75rem;">@stat</span>
                                <select class="form-select form-select-sm bg-dark text-light border-secondary py-0 px-1 text-center"
                                        style="width: 58px; font-size: 0.75rem; height: 26px;"
                                        value="@val"
                                        @onchange="(e) => OnEnemyStageSelect(stat, e)">
                                    @for (int s = 6; s >= -6; s--)
                                    {
                                        <option value="@s">@(s > 0 ? $"+{s}" : s.ToString())</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                </div>

                <!-- Weakness, Status & Breaks Row -->
                <div class="d-flex flex-wrap align-items-center gap-3 mt-2 pt-2 border-top border-secondary border-opacity-50">
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-secondary fw-bold" style="font-size: 0.75rem;">Weakness:</span>
                        <select class="form-select form-select-sm bg-dark text-light border-secondary" style="width: 140px; font-size: 0.75rem;" @bind="Enemy.Weakness" @bind:after="StateHasChanged">
                            <option value="">None (Neutral)</option>
                            @foreach (var t in CombatantState.AllTypes)
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-secondary fw-bold" style="font-size: 0.75rem;">Status:</span>
                        <select class="form-select form-select-sm bg-dark text-light border-secondary" style="width: 130px; font-size: 0.75rem;" @bind="Enemy.StatusCondition" @bind:after="StateHasChanged">
                            <option value="">None</option>
                            <option value="burned">Burned</option>
                            <option value="paralyzed">Paralyzed</option>
                            <option value="poisoned">Poisoned</option>
                            <option value="badly poisoned">Badly Poisoned</option>
                            <option value="frozen">Frozen</option>
                            <option value="asleep">Asleep</option>
                        </select>
                    </div>

                    <!-- Volatile Status Interferences (Official Icons Only) -->
                    <div class="d-flex align-items-center gap-1">
                        <button class="btn btn-sm py-1 px-2 @(Enemy.VolatileStatus.GetValueOrDefault("confused", false) ? "btn-warning fw-bold text-dark" : "btn-outline-secondary text-light")"
                                style="font-size: 0.75rem;"
                                title="Confused"
                                @onclick='() => { Enemy.VolatileStatus["confused"] = !Enemy.VolatileStatus.GetValueOrDefault("confused", false); StateHasChanged(); }'>
                            <img src="img/battle/SCTP_001.png" alt="Confused" style="height: 18px; width: 18px; object-fit: contain;" />
                        </button>
                        <button class="btn btn-sm py-1 px-2 @(Enemy.VolatileStatus.GetValueOrDefault("trapped", false) ? "btn-warning fw-bold text-dark" : "btn-outline-secondary text-light")"
                                style="font-size: 0.75rem;"
                                title="Trapped"
                                @onclick='() => { Enemy.VolatileStatus["trapped"] = !Enemy.VolatileStatus.GetValueOrDefault("trapped", false); StateHasChanged(); }'>
                            <img src="img/battle/SCTP_004.png" alt="Trapped" style="height: 18px; width: 18px; object-fit: contain;" />
                        </button>
                        <button class="btn btn-sm py-1 px-2 @(Enemy.VolatileStatus.GetValueOrDefault("flinching", false) ? "btn-warning fw-bold text-dark" : "btn-outline-secondary text-light")"
                                style="font-size: 0.75rem;"
                                title="Flinching"
                                @onclick='() => { Enemy.VolatileStatus["flinching"] = !Enemy.VolatileStatus.GetValueOrDefault("flinching", false); StateHasChanged(); }'>
                            <img src="img/battle/SCTP_002.png" alt="Flinching" style="height: 18px; width: 18px; object-fit: contain;" />
                        </button>
                    </div>

                    <!-- Target Breaks (Icons Only) -->
                    <div class="d-flex align-items-center gap-1 ms-auto">
                        <button class="btn btn-sm py-1 px-2 d-inline-flex align-items-center @(Enemy.PhysicalBreak ? "btn-pink fw-bold" : "btn-outline-secondary text-light")"
                                style="font-size: 0.75rem;"
                                title="Physical Break"
                                @onclick="() => { Enemy.PhysicalBreak = !Enemy.PhysicalBreak; StateHasChanged(); }">
                            <img src="img/battle/break_phys.png" alt="Phys Break" style="height: 18px; width: 18px; object-fit: contain;" />
                        </button>
                        <button class="btn btn-sm py-1 px-2 d-inline-flex align-items-center @(Enemy.SpecialBreak ? "btn-pink fw-bold" : "btn-outline-secondary text-light")"
                                style="font-size: 0.75rem;"
                                title="Special Break"
                                @onclick="() => { Enemy.SpecialBreak = !Enemy.SpecialBreak; StateHasChanged(); }">
                            <img src="img/battle/break_spec.png" alt="Spec Break" style="height: 18px; width: 18px; object-fit: contain;" />
                        </button>
                    </div>
                </div>

                <!-- Comprehensive Multi-Type Rebuff Section for Target (Icons Only) -->
                <div class="mt-2 pt-2 border-top border-secondary border-opacity-50">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="small text-danger fw-bold d-flex align-items-center gap-1" style="font-size: 0.75rem;">
                                <i class="bi bi-shield-slash"></i> Target Rebuff:
                            </span>
                            
                            <!-- Type Picker with Official Icon Preview -->
                            <div class="input-group input-group-sm" style="width: 145px;">
                                <span class="input-group-text bg-dark border-secondary p-1">
                                    <img src="@CombatantState.GetTypeIcon(_selectedEnemyRebuffType)" alt="" width="18" height="18" />
                                </span>
                                <select class="form-select bg-dark text-light border-secondary py-0" style="font-size: 0.75rem;" value="@_selectedEnemyRebuffType" @onchange="OnEnemyRebuffTypeSelect">
                                    @foreach (var t in CombatantState.AllTypes)
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </select>
                            </div>

                            <!-- Value Selector for Selected Type (-3 to +3) -->
                            <div class="btn-group btn-group-sm">
                                @for (int r = -3; r <= 3; r++)
                                {
                                    int rb = r;
                                    int curVal = Enemy.EnemyTypeRebuffs.GetValueOrDefault(_selectedEnemyRebuffType, 0);
                                    <button class="btn btn-sm py-0 px-2 @(curVal == rb ? (rb < 0 ? "btn-primary fw-bold" : (rb > 0 ? "btn-danger fw-bold" : "btn-secondary text-light")) : "btn-outline-secondary text-light")"
                                            style="font-size: 0.75rem;"
                                            @onclick="() => SetEnemyRebuff(_selectedEnemyRebuffType, rb)">
                                        @(rb > 0 ? $"+{rb}" : rb.ToString())
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-sm btn-outline-info py-0 px-2" style="font-size: 0.75rem;" @onclick="() => _showAllEnemyRebuffs = !_showAllEnemyRebuffs">
                                <i class="bi bi-grid-3x3-gap me-1"></i> All Types @(GetActiveEnemyRebuffsCount() > 0 ? $"({GetActiveEnemyRebuffsCount()})" : "")
                            </button>
                            @if (GetActiveEnemyRebuffsCount() > 0)
                            {
                                <button class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 0.7rem;" @onclick="ClearAllEnemyRebuffs">
                                    Clear All
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Active Target Rebuff Badges List (Icons Only, No Text) -->
                    @if (GetActiveEnemyRebuffsCount() > 0)
                    {
                        <div class="d-flex flex-wrap gap-1 align-items-center mb-2">
                            <span class="small text-muted" style="font-size: 0.7rem;">Active:</span>
                            @foreach (var (t, val) in Enemy.EnemyTypeRebuffs.Where(kv => kv.Value != 0))
                            {
                                string typeName = t;
                                int rVal = val;
                                <span class="badge type-badge type-@typeName.ToLowerInvariant() d-inline-flex align-items-center gap-1 shadow-sm py-1 px-2" style="font-size: 0.75rem; cursor: pointer;" title="@typeName Rebuff @rVal" @onclick="() => _selectedEnemyRebuffType = typeName">
                                    <img src="@CombatantState.GetTypeIcon(typeName)" alt="" width="16" height="16" />
                                    <b class="text-warning">@(rVal > 0 ? $"+{rVal}" : rVal.ToString())</b>
                                    <i class="bi bi-x-circle-fill opacity-75 ms-1" title="Remove rebuff" @onclick:stopPropagation="true" @onclick="() => SetEnemyRebuff(typeName, 0)"></i>
                                </span>
                            }
                        </div>
                    }

                    <!-- Expandable Full 19-Type Rebuff Grid (Icons Only) -->
                    @if (_showAllEnemyRebuffs)
                    {
                        <div class="bg-black bg-opacity-30 p-2 rounded border border-secondary border-opacity-50 mt-2">
                            <div class="small fw-bold text-muted mb-2" style="font-size: 0.7rem;">All 19 Target Type Rebuffs:</div>
                            <div class="row row-cols-3 row-cols-sm-4 row-cols-md-6 g-2">
                                @foreach (var t in CombatantState.AllTypes)
                                {
                                    string typeName = t;
                                    int curVal = Enemy.EnemyTypeRebuffs.GetValueOrDefault(typeName, 0);
                                    <div class="col">
                                        <div class="p-1 px-2 rounded bg-dark border @(curVal != 0 ? "border-primary" : "border-secondary") d-flex align-items-center justify-content-between gap-1">
                                            <div class="d-flex align-items-center gap-1" title="@typeName">
                                                <img src="@CombatantState.GetTypeIcon(typeName)" alt="" width="20" height="20" />
                                            </div>
                                            <select class="form-select form-select-sm bg-dark text-light border-secondary py-0 px-1 text-center"
                                                    style="width: 50px; font-size: 0.7rem; height: 22px;"
                                                    value="@curVal"
                                                    @onchange="(e) => OnGridEnemyRebuffChange(typeName, e)">
                                                @for (int r = -3; r <= 3; r++)
                                                {
                                                    <option value="@r">@(r > 0 ? $"+{r}" : r.ToString())</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Target Mitigations (Sharpened Body / Mind) & Sync Buffs -->
                <div class="d-flex flex-wrap align-items-center gap-3 mt-2 pt-2 border-top border-secondary border-opacity-50">
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-secondary fw-bold text-uppercase" style="font-size: 0.75rem;" title="Reduces effect of physical stat debuffs (e.g. Sharpened Body 5 = 50% mitigation)">Def Mit (Body):</span>
                        <select class="form-select form-select-sm bg-dark text-light border-secondary text-center py-0 px-1"
                                style="width: 58px; font-size: 0.75rem; height: 26px;"
                                value="@Enemy.Mitigations.GetValueOrDefault("def", 5)"
                                @onchange='(e) => { if (int.TryParse(e.Value?.ToString(), out int v)) { Enemy.Mitigations["def"] = v; StateHasChanged(); } }'>
                            @for (int m = 0; m <= 9; m++)
                            {
                                <option value="@m">@m</option>
                            }
                        </select>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-secondary fw-bold text-uppercase" style="font-size: 0.75rem;" title="Reduces effect of special stat debuffs (e.g. Sharpened Mind 5 = 50% mitigation)">SpD Mit (Mind):</span>
                        <select class="form-select form-select-sm bg-dark text-light border-secondary text-center py-0 px-1"
                                style="width: 58px; font-size: 0.75rem; height: 26px;"
                                value="@Enemy.Mitigations.GetValueOrDefault("spd", 5)"
                                @onchange='(e) => { if (int.TryParse(e.Value?.ToString(), out int v)) { Enemy.Mitigations["spd"] = v; StateHasChanged(); } }'>
                            @for (int m = 0; m <= 9; m++)
                            {
                                <option value="@m">@m</option>
                            }
                        </select>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-secondary fw-bold text-uppercase" style="font-size: 0.75rem;">Target Sync Buffs:</span>
                        <input type="number" min="0" class="form-control form-control-sm bg-dark text-light border-secondary text-center py-0 px-1"
                               style="width: 60px; font-size: 0.75rem; height: 26px;"
                               @bind="Enemy.SyncBoosts" @bind:after="StateHasChanged" />
                        @if (Enemy.SyncBoosts > 0)
                        {
                            <span class="small text-danger fw-bold">×@(1.0 + Enemy.SyncBoosts * 0.5)</span>
                        }
                    </div>
                </div>

                <!-- Target Side Field Effects (Damage Field & Screens) -->
                <div class="d-flex flex-wrap align-items-center gap-3 mt-2 pt-2 border-top border-secondary border-opacity-50">
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-danger fw-bold" style="font-size: 0.75rem;"><i class="bi bi-crosshair"></i> Target Damage Field:</span>
                        <select class="form-select form-select-sm bg-dark text-light border-secondary" style="width: 170px; font-size: 0.75rem;" @bind="Enemy.DamageField" @bind:after="StateHasChanged">
                            <option value="">None (Inactive)</option>
                            @foreach (var t in CombatantState.AllTypes)
                            {
                                <option value="@t">@t Damage Field</option>
                            }
                        </select>
                    </div>

                    <div class="d-flex align-items-center gap-1">
                        <span class="small text-danger fw-bold me-1" style="font-size: 0.75rem;"><i class="bi bi-shield"></i> Target Screens:</span>
                        <button class="btn btn-sm py-0 px-2 d-inline-flex align-items-center gap-1 @(Enemy.PhysicalDamageReduction ? "btn-warning fw-bold text-dark" : "btn-outline-secondary text-light")" style="font-size: 0.75rem;"
                                title="Physical Damage Reduction (Reflect)"
                                @onclick="() => { Enemy.PhysicalDamageReduction = !Enemy.PhysicalDamageReduction; StateHasChanged(); }">
                            <img src="img/battle/STAT_002R.png" alt="Phys" style="height: 18px; width: 18px; object-fit: contain;" />
                            <span>Phys Dmg Red</span>
                        </button>
                        <button class="btn btn-sm py-0 px-2 d-inline-flex align-items-center gap-1 @(Enemy.SpecialDamageReduction ? "btn-warning fw-bold text-dark" : "btn-outline-secondary text-light")" style="font-size: 0.75rem;"
                                title="Special Damage Reduction (Light Screen)"
                                @onclick="() => { Enemy.SpecialDamageReduction = !Enemy.SpecialDamageReduction; StateHasChanged(); }">
                            <img src="img/battle/STAT_008R.png" alt="Spec" style="height: 18px; width: 18px; object-fit: contain;" />
                            <span>Spec Dmg Red</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- 4B. User Card (Below Target) -->
            <div class="card bg-dark border-secondary p-3 shadow-sm">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="text-info fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-person-fill"></i> User
                    </h6>
                    <button class="btn btn-outline-info btn-sm py-0 px-2" style="font-size: 0.75rem;" @onclick="() => _showCirclesPanel = !_showCirclesPanel">
                        <i class="bi bi-record-circle me-1"></i> Battle Circles @(GetActiveCirclesCount() > 0 ? $"({GetActiveCirclesCount()})" : "")
                    </button>
                </div>

                <!-- User Stat Stages Dropdowns -->
                <div class="row row-cols-2 row-cols-sm-3 row-cols-md-6 g-2">
                    @foreach (var stat in new[] { "atk", "def", "spa", "spd", "spe", "crit" })
                    {
                        int val = Ally.Stages.GetValueOrDefault(stat, stat == "crit" ? 3 : 6);
                        int maxStage = stat == "crit" ? 3 : 6;
                        int minStage = stat == "crit" ? 0 : -6;
                        <div class="col">
                            <div class="p-1 px-2 rounded bg-black bg-opacity-40 border border-secondary border-opacity-75 d-flex align-items-center justify-content-between gap-1">
                                <span class="small fw-bold text-secondary text-uppercase" style="font-size: 0.75rem;">@stat</span>
                                <select class="form-select form-select-sm bg-dark text-light border-secondary py-0 px-1 text-center"
                                        style="width: 58px; font-size: 0.75rem; height: 26px;"
                                        value="@val"
                                        @onchange="(e) => OnAllyStageSelect(stat, e)">
                                    @for (int s = maxStage; s >= minStage; s--)
                                    {
                                        <option value="@s">@(s > 0 ? $"+{s}" : s.ToString())</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                </div>

                <!-- Next Boosts (PMUN, SMUN, SYUN, Crit Hit, SE Next & Breaks) -->
                <div class="d-flex flex-wrap align-items-center gap-2 mt-2 pt-2 border-top border-secondary border-opacity-50">
                    <!-- PMUN Dropdown -->
                    <div class="d-flex align-items-center gap-1 bg-secondary bg-opacity-25 px-2 py-1 rounded border border-secondary" style="font-size: 0.75rem;">
                        <span class="text-light fw-bold">PMUN:</span>
                        <select class="form-select form-select-sm bg-dark text-light border-secondary py-0 px-1" style="width: 52px; font-size: 0.75rem; height: 24px;"
                                value="@Ally.PhysicalBoostNext"
                                @onchange="OnPmunSelect">
                            @for (int b = 0; b <= 10; b++)
                            {
                                <option value="@b">@b</option>
                            }
                        </select>
                    </div>

                    <!-- SMUN Dropdown -->
                    <div class="d-flex align-items-center gap-1 bg-secondary bg-opacity-25 px-2 py-1 rounded border border-secondary" style="font-size: 0.75rem;">
                        <span class="text-light fw-bold">SMUN:</span>
                        <select class="form-select form-select-sm bg-dark text-light border-secondary py-0 px-1" style="width: 52px; font-size: 0.75rem; height: 24px;"
                                value="@Ally.SpecialBoostNext"
                                @onchange="OnSmunSelect">
                            @for (int b = 0; b <= 10; b++)
                            {
                                <option value="@b">@b</option>
                            }
                        </select>
                    </div>

                    <!-- SYUN (Sync Move Up Next) Dropdown -->
                    <div class="d-flex align-items-center gap-1 bg-secondary bg-opacity-25 px-2 py-1 rounded border border-secondary" style="font-size: 0.75rem;">
                        <span class="text-light fw-bold">SYUN:</span>
                        <select class="form-select form-select-sm bg-dark text-light border-secondary py-0 px-1" style="width: 52px; font-size: 0.75rem; height: 24px;"
                                value="@Ally.SyncMoveBoostNext"
                                @onchange="OnSyunSelect">
                            @for (int b = 0; b <= 10; b++)
                            {
                                <option value="@b">@b</option>
                            }
                        </select>
                    </div>

                    <button class="btn btn-sm py-1 px-2 @(Ally.IsCriticalMove ? "btn-warning" : "btn-outline-secondary text-light")" style="font-size: 0.75rem;" @onclick="() => { Ally.IsCriticalMove = !Ally.IsCriticalMove; StateHasChanged(); }">Crit Hit</button>
                    <button class="btn btn-sm py-1 px-2 @(Ally.SuperEffectiveNext ? "btn-danger" : "btn-outline-secondary text-light")" style="font-size: 0.75rem;" @onclick="() => { Ally.SuperEffectiveNext = !Ally.SuperEffectiveNext; StateHasChanged(); }">SE Next (×3)</button>
                    
                    <!-- User Breaks (Icons Only) -->
                    <button class="btn btn-sm py-1 px-2 d-inline-flex align-items-center @(Ally.PhysicalBreak ? "btn-pink fw-bold" : "btn-outline-secondary text-light")"
                            style="font-size: 0.75rem;"
                            title="Physical Break"
                            @onclick="() => { Ally.PhysicalBreak = !Ally.PhysicalBreak; StateHasChanged(); }">
                        <img src="img/battle/break_phys.png" alt="Phys Break" style="height: 18px; width: 18px; object-fit: contain;" />
                    </button>
                    <button class="btn btn-sm py-1 px-2 d-inline-flex align-items-center @(Ally.SpecialBreak ? "btn-pink fw-bold" : "btn-outline-secondary text-light")"
                            style="font-size: 0.75rem;"
                            title="Special Break"
                            @onclick="() => { Ally.SpecialBreak = !Ally.SpecialBreak; StateHasChanged(); }">
                        <img src="img/battle/break_spec.png" alt="Spec Break" style="height: 18px; width: 18px; object-fit: contain;" />
                    </button>
                </div>

                <!-- Sync Buffs & Lucky Skill -->
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2 pt-2 border-top border-secondary border-opacity-50">
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-secondary fw-bold text-uppercase" style="font-size: 0.75rem;">User Sync Buffs:</span>
                        <input type="number" min="0" class="form-control form-control-sm bg-dark text-light border-secondary text-center py-0 px-1"
                               style="width: 60px; font-size: 0.75rem; height: 26px;"
                               @bind="Ally.SyncBoosts" @bind:after="StateHasChanged" />
                        <span class="small text-warning fw-bold">×@(1.0 + Ally.SyncBoosts * 0.5)</span>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-secondary fw-bold text-uppercase" style="font-size: 0.75rem;">Lucky Skill:</span>
                        <select class="form-select form-select-sm bg-dark text-light border-secondary" style="width: 180px; font-size: 0.75rem;" @bind="Ally.LuckySkillName" @bind:after="StateHasChanged">
                            <option value="">(None)</option>
                            @foreach (var ls in Rules.LuckySkills.Where(s => s.IsAvailableFor(Ally.Pair.Role, Ally.Pair.DisplayName)))
                            {
                                <option value="@ls.Name">@ls.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Comprehensive Multi-Type Rebuff Section for User (Icons Only) -->
                <div class="mt-2 pt-2 border-top border-secondary border-opacity-50">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="small text-info fw-bold d-flex align-items-center gap-1" style="font-size: 0.75rem;">
                                <i class="bi bi-shield-slash"></i> User Rebuff:
                            </span>
                            
                            <!-- Type Picker with Official Icon Preview -->
                            <div class="input-group input-group-sm" style="width: 145px;">
                                <span class="input-group-text bg-dark border-secondary p-1">
                                    <img src="@CombatantState.GetTypeIcon(_selectedUserRebuffType)" alt="" width="18" height="18" />
                                </span>
                                <select class="form-select bg-dark text-light border-secondary py-0" style="font-size: 0.75rem;" value="@_selectedUserRebuffType" @onchange="OnUserRebuffTypeSelect">
                                    @foreach (var t in CombatantState.AllTypes)
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </select>
                            </div>

                            <!-- Value Selector for Selected Type (-3 to +3) -->
                            <div class="btn-group btn-group-sm">
                                @for (int r = -3; r <= 3; r++)
                                {
                                    int rb = r;
                                    int curVal = Ally.UserTypeRebuffs.GetValueOrDefault(_selectedUserRebuffType, 0);
                                    <button class="btn btn-sm py-0 px-2 @(curVal == rb ? (rb < 0 ? "btn-primary fw-bold" : (rb > 0 ? "btn-danger fw-bold" : "btn-secondary text-light")) : "btn-outline-secondary text-light")"
                                            style="font-size: 0.75rem;"
                                            @onclick="() => SetUserRebuff(_selectedUserRebuffType, rb)">
                                        @(rb > 0 ? $"+{rb}" : rb.ToString())
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-sm btn-outline-info py-0 px-2" style="font-size: 0.75rem;" @onclick="() => _showAllUserRebuffs = !_showAllUserRebuffs">
                                <i class="bi bi-grid-3x3-gap me-1"></i> All Types @(GetActiveUserRebuffsCount() > 0 ? $"({GetActiveUserRebuffsCount()})" : "")
                            </button>
                            @if (GetActiveUserRebuffsCount() > 0)
                            {
                                <button class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 0.7rem;" @onclick="ClearAllUserRebuffs">
                                    Clear All
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Active User Rebuff Badges List (Icons Only) -->
                    @if (GetActiveUserRebuffsCount() > 0)
                    {
                        <div class="d-flex flex-wrap gap-1 align-items-center mb-2">
                            <span class="small text-muted" style="font-size: 0.7rem;">Active:</span>
                            @foreach (var (t, val) in Ally.UserTypeRebuffs.Where(kv => kv.Value != 0))
                            {
                                string typeName = t;
                                int rVal = val;
                                <span class="badge type-badge type-@typeName.ToLowerInvariant() d-inline-flex align-items-center gap-1 shadow-sm py-1 px-2" style="font-size: 0.75rem; cursor: pointer;" title="@typeName Rebuff @rVal" @onclick="() => _selectedUserRebuffType = typeName">
                                    <img src="@CombatantState.GetTypeIcon(typeName)" alt="" width="16" height="16" />
                                    <b class="text-warning">@(rVal > 0 ? $"+{rVal}" : rVal.ToString())</b>
                                    <i class="bi bi-x-circle-fill opacity-75 ms-1" title="Remove rebuff" @onclick:stopPropagation="true" @onclick="() => SetUserRebuff(typeName, 0)"></i>
                                </span>
                            }
                        </div>
                    }

                    <!-- Expandable Full 19-Type Rebuff Grid (Icons Only) -->
                    @if (_showAllUserRebuffs)
                    {
                        <div class="bg-black bg-opacity-30 p-2 rounded border border-secondary border-opacity-50 mt-2">
                            <div class="small fw-bold text-muted mb-2" style="font-size: 0.7rem;">All 19 User Type Rebuffs:</div>
                            <div class="row row-cols-3 row-cols-sm-4 row-cols-md-6 g-2">
                                @foreach (var t in CombatantState.AllTypes)
                                {
                                    string typeName = t;
                                    int curVal = Ally.UserTypeRebuffs.GetValueOrDefault(typeName, 0);
                                    <div class="col">
                                        <div class="p-1 px-2 rounded bg-dark border @(curVal != 0 ? "border-primary" : "border-secondary") d-flex align-items-center justify-content-between gap-1">
                                            <div class="d-flex align-items-center gap-1" title="@typeName">
                                                <img src="@CombatantState.GetTypeIcon(typeName)" alt="" width="20" height="20" />
                                            </div>
                                            <select class="form-select form-select-sm bg-dark text-light border-secondary py-0 px-1 text-center"
                                                    style="width: 50px; font-size: 0.7rem; height: 22px;"
                                                    value="@curVal"
                                                    @onchange="(e) => OnGridUserRebuffChange(typeName, e)">
                                                @for (int r = -3; r <= 3; r++)
                                                {
                                                    <option value="@r">@(r > 0 ? $"+{r}" : r.ToString())</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- User Side Field Effects (Damage Field & Screens) -->
                <div class="d-flex flex-wrap align-items-center gap-3 mt-2 pt-2 border-top border-secondary border-opacity-50">
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-info fw-bold" style="font-size: 0.75rem;"><i class="bi bi-shield-check"></i> User Damage Field:</span>
                        <select class="form-select form-select-sm bg-dark text-light border-secondary" style="width: 170px; font-size: 0.75rem;" @bind="Ally.DamageField" @bind:after="StateHasChanged">
                            <option value="">None (Inactive)</option>
                            @foreach (var t in CombatantState.AllTypes)
                            {
                                <option value="@t">@t Damage Field</option>
                            }
                        </select>
                    </div>

                    <div class="d-flex align-items-center gap-1">
                        <span class="small text-info fw-bold me-1" style="font-size: 0.75rem;"><i class="bi bi-shield"></i> User Screens:</span>
                        <button class="btn btn-sm py-0 px-2 d-inline-flex align-items-center gap-1 @(Ally.PhysicalDamageReduction ? "btn-warning fw-bold text-dark" : "btn-outline-secondary text-light")" style="font-size: 0.75rem;"
                                title="Physical Damage Reduction (Reflect)"
                                @onclick="() => { Ally.PhysicalDamageReduction = !Ally.PhysicalDamageReduction; StateHasChanged(); }">
                            <img src="img/battle/STAT_002R.png" alt="Phys" style="height: 18px; width: 18px; object-fit: contain;" />
                            <span>Phys Dmg Red</span>
                        </button>
                        <button class="btn btn-sm py-0 px-2 d-inline-flex align-items-center gap-1 @(Ally.SpecialDamageReduction ? "btn-warning fw-bold text-dark" : "btn-outline-secondary text-light")" style="font-size: 0.75rem;"
                                title="Special Damage Reduction (Light Screen)"
                                @onclick="() => { Ally.SpecialDamageReduction = !Ally.SpecialDamageReduction; StateHasChanged(); }">
                            <img src="img/battle/STAT_008R.png" alt="Spec" style="height: 18px; width: 18px; object-fit: contain;" />
                            <span>Spec Dmg Red</span>
                        </button>
                    </div>
                </div>

                <!-- Regional Battle Circles Collapsible Panel (User Side Only - Multi-Circle Support) -->
                @if (_showCirclesPanel || GetActiveCirclesCount() > 0)
                {
                    <div class="mt-2 pt-2 border-top border-secondary border-opacity-50 bg-black bg-opacity-25 p-2 rounded">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="small text-warning fw-bold text-uppercase" style="font-size: 0.75rem;">Circle Region:</span>
                                <select class="form-select form-select-sm bg-dark text-light border-secondary py-0" style="width: 120px; font-size: 0.75rem;" @bind="_selectedCircleRegion" @bind:after="StateHasChanged">
                                    @foreach (var r in CombatantState.CircleRegions)
                                    {
                                        <option value="@r">@r</option>
                                    }
                                </select>
                            </div>

                            <!-- Circle Type Toggles for Selected Region -->
                            <div class="d-flex flex-wrap align-items-center gap-1">
                                <button class="btn btn-sm py-0 px-2 @(IsCircleActive(_selectedCircleRegion, "physical") ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light")" style="font-size: 0.75rem;"
                                        @onclick='() => ToggleCircle(_selectedCircleRegion, "physical")'>
                                    Physical Circle
                                </button>
                                <button class="btn btn-sm py-0 px-2 @(IsCircleActive(_selectedCircleRegion, "special") ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light")" style="font-size: 0.75rem;"
                                        @onclick='() => ToggleCircle(_selectedCircleRegion, "special")'>
                                    Special Circle
                                </button>
                                <button class="btn btn-sm py-0 px-2 @(IsCircleActive(_selectedCircleRegion, "defensive") ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light")" style="font-size: 0.75rem;"
                                        @onclick='() => ToggleCircle(_selectedCircleRegion, "defensive")'>
                                    Defensive Circle
                                </button>
                            </div>

                            <!-- Same-Region Allies Count (Minimum 1 Ally) -->
                            <div class="d-flex align-items-center gap-1">
                                <span class="small text-secondary fw-bold" style="font-size: 0.75rem;">Allies:</span>
                                <div class="btn-group btn-group-sm">
                                    @for (int a = 1; a <= 3; a++)
                                    {
                                        int count = a;
                                        <button class="btn btn-sm py-0 px-2 @(Ally.CircleAllyCount.GetValueOrDefault(_selectedCircleRegion, 1) == count ? "btn-primary fw-bold" : "btn-outline-secondary text-light")" style="font-size: 0.75rem;"
                                                @onclick="() => SetCircleAllyCount(_selectedCircleRegion, count)">
                                            @count
                                        </button>
                                    }
                                </div>
                            </div>

                            @if (GetActiveCirclesCount() > 0)
                            {
                                <button class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 0.7rem;" @onclick="ClearAllCircles">
                                    Clear All Circles
                                </button>
                            }
                        </div>

                        <!-- Active Circles Summary Chips (Allows multiple circles across any regions!) -->
                        @if (GetActiveCirclesCount() > 0)
                        {
                            <div class="d-flex flex-wrap gap-1 align-items-center pt-2 mt-2 border-top border-secondary border-opacity-50">
                                <span class="small text-muted" style="font-size: 0.7rem;">Active Circles (@GetActiveCirclesCount()):</span>
                                @foreach (var r in CombatantState.CircleRegions)
                                {
                                    int allies = Ally.CircleAllyCount.GetValueOrDefault(r, 1);
                                    if (IsCircleActive(r, "physical"))
                                    {
                                        <span class="badge bg-info text-dark d-inline-flex align-items-center gap-1 shadow-sm" style="font-size: 0.75rem;">
                                            @r Phys (+@(10 + 10 * allies)%)
                                            <i class="bi bi-x-circle-fill opacity-75 ms-1" style="cursor: pointer;" title="Remove" @onclick='() => ToggleCircle(r, "physical")'></i>
                                        </span>
                                    }
                                    if (IsCircleActive(r, "special"))
                                    {
                                        <span class="badge bg-info text-dark d-inline-flex align-items-center gap-1 shadow-sm" style="font-size: 0.75rem;">
                                            @r Spec (+@(10 + 10 * allies)%)
                                            <i class="bi bi-x-circle-fill opacity-75 ms-1" style="cursor: pointer;" title="Remove" @onclick='() => ToggleCircle(r, "special")'></i>
                                        </span>
                                    }
                                    if (IsCircleActive(r, "defensive"))
                                    {
                                        <span class="badge bg-info text-dark d-inline-flex align-items-center gap-1 shadow-sm" style="font-size: 0.75rem;">
                                            @r Def (+@(5 + 5 * allies)%)
                                            <i class="bi bi-x-circle-fill opacity-75 ms-1" style="cursor: pointer;" title="Remove" @onclick='() => ToggleCircle(r, "defensive")'></i>
                                        </span>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public CombatantState Ally { get; set; } = new();
    [Parameter] public CombatantState Enemy { get; set; } = new();
    [Parameter] public FieldState Field { get; set; } = new();
    [Parameter] public DamageRulesDocument Rules { get; set; } = new();
    [Parameter] public int MoveLevel { get; set; } = 5;
    [Parameter] public EventCallback<int> MoveLevelChanged { get; set; }

    private string _selectedEnemyRebuffType = "Fire";
    private string _selectedUserRebuffType = "Fire";
    private string _selectedCircleRegion = "Kanto";
    private bool _showAllEnemyRebuffs = false;
    private bool _showAllUserRebuffs = false;
    private bool _showCirclesPanel = false;

    protected override void OnInitialized()
    {
        GridState.OnGridChanged += OnGridStateUpdated;
        if (Ally.Pair != null && !string.IsNullOrEmpty(Ally.Pair.Type))
        {
            _selectedUserRebuffType = Ally.Pair.Type;
            _selectedEnemyRebuffType = Ally.Pair.Type;
        }
    }

    private void OnGridStateUpdated()
    {
        InvokeAsync(StateHasChanged);
    }

    private string EffectivePairType
    {
        get
        {
            if (Ally.Pair == null) return "Normal";
            if (Ally.FormIndex > 0 && Ally.Pair.Variations != null && Ally.FormIndex <= Ally.Pair.Variations.Count)
            {
                var form = Ally.Pair.Variations[Ally.FormIndex - 1];
                if (!string.IsNullOrEmpty(form.Type)) return form.Type;
                if (form.FormName.Contains("Stellar", StringComparison.OrdinalIgnoreCase)) return "Stellar";
            }
            return Ally.Pair.Type;
        }
    }

    private string GetEffectiveMoveType(MoveItem move)
    {
        if (move.IsMax) return move.Type;
        if (Ally.FormIndex > 0 && Ally.Pair?.Variations != null && Ally.FormIndex <= Ally.Pair.Variations.Count)
        {
            var form = Ally.Pair.Variations[Ally.FormIndex - 1];
            if (form.FormName.Contains("Stellar", StringComparison.OrdinalIgnoreCase) || string.Equals(form.Type, "Stellar", StringComparison.OrdinalIgnoreCase))
            {
                if (move.Name.Contains("Tera Starstorm", StringComparison.OrdinalIgnoreCase) || move.Name.Contains("Kaleidoscopic", StringComparison.OrdinalIgnoreCase) || move.IsSync)
                {
                    return "Stellar";
                }
            }
            else if (!string.IsNullOrEmpty(form.Type))
            {
                return form.Type;
            }
        }
        return move.Type;
    }

    private IEnumerable<MoveItem> ActiveMoves
    {
        get
        {
            if (Ally.Pair == null) return Enumerable.Empty<MoveItem>();

            if (CalcService.IsDynamaxActive(Ally.Pair, Ally.FormIndex))
            {
                return CalcService.GetMaxMoves(Ally.Pair);
            }

            var currentVariation = (Ally.FormIndex > 0 && Ally.FormIndex <= Ally.Pair.Variations.Count)
                ? Ally.Pair.Variations[Ally.FormIndex - 1]
                : null;
            int activeTerastalMoveId = currentVariation?.TerastalMoveId ?? 0;

            var regularMoves = Ally.Pair.Moves.Where(m =>
                !m.Category.Equals("Status", StringComparison.OrdinalIgnoreCase) &&
                int.TryParse(m.Power, out int p) && p > 0 &&
                (!m.IsTerastalMove || (activeTerastalMoveId > 0 && m.Id == activeTerastalMoveId)));
            var learned = GridState.GetLearnedMoves(Ally.Pair);
            return regularMoves.Concat(learned);
        }
    }

    private void SetForm(int idx)
    {
        Ally.FormIndex = idx;
        StateHasChanged();
    }

    private async Task OnMoveLevelSelect(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            Ally.MoveLevel = val;
            int fullLvl = Ally.SuperAwakeningLevel > 0 ? (val + Ally.SuperAwakeningLevel) : val;
            await MoveLevelChanged.InvokeAsync(fullLvl);
            StateHasChanged();
        }
    }

    private async Task OnSaLevelSelect(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            Ally.SuperAwakeningLevel = val;
            int fullLvl = val > 0 ? (5 + val) : Ally.MoveLevel;
            await MoveLevelChanged.InvokeAsync(fullLvl);
            StateHasChanged();
        }
    }

    private void OnAllyStageSelect(string stat, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            Ally.Stages[stat] = val;
            StateHasChanged();
        }
    }

    private void OnEnemyStageSelect(string stat, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            Enemy.Stages[stat] = val;
            StateHasChanged();
        }
    }

    private int MoveUpNextValue => Math.Max(Ally.PhysicalBoostNext, Ally.SpecialBoostNext);

    private void OnMoveUpNextSelect(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            Ally.PhysicalBoostNext = val;
            Ally.SpecialBoostNext = val;
            StateHasChanged();
        }
    }

    private void OnPmunSelect(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            Ally.PhysicalBoostNext = val;
            StateHasChanged();
        }
    }

    private void OnSmunSelect(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            Ally.SpecialBoostNext = val;
            StateHasChanged();
        }
    }

    private void OnSyunSelect(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            Ally.SyncMoveBoostNext = val;
            StateHasChanged();
        }
    }

    private void OnEnemyRebuffTypeSelect(ChangeEventArgs e)
    {
        _selectedEnemyRebuffType = e.Value?.ToString() ?? "Fire";
    }

    private void OnUserRebuffTypeSelect(ChangeEventArgs e)
    {
        _selectedUserRebuffType = e.Value?.ToString() ?? "Fire";
    }

    private void SetEnemyRebuff(string type, int val)
    {
        Enemy.EnemyTypeRebuffs[type] = val;
        StateHasChanged();
    }

    private void SetUserRebuff(string type, int val)
    {
        Ally.UserTypeRebuffs[type] = val;
        StateHasChanged();
    }

    private void OnGridEnemyRebuffChange(string type, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            SetEnemyRebuff(type, val);
        }
    }

    private void OnGridUserRebuffChange(string type, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            SetUserRebuff(type, val);
        }
    }

    private void ClearAllEnemyRebuffs()
    {
        foreach (var t in CombatantState.AllTypes)
        {
            Enemy.EnemyTypeRebuffs[t] = 0;
        }
        StateHasChanged();
    }

    private void ClearAllUserRebuffs()
    {
        foreach (var t in CombatantState.AllTypes)
        {
            Ally.UserTypeRebuffs[t] = 0;
        }
        StateHasChanged();
    }

    private int GetActiveEnemyRebuffsCount()
    {
        return Enemy.EnemyTypeRebuffs.Count(kv => kv.Value != 0);
    }

    private int GetActiveUserRebuffsCount()
    {
        return Ally.UserTypeRebuffs.Count(kv => kv.Value != 0);
    }

    private bool IsCircleActive(string region, string circleType)
    {
        return Ally.CircleActive.TryGetValue(region, out var dict) && dict.GetValueOrDefault(circleType, false);
    }

    private void ToggleCircle(string region, string circleType)
    {
        if (!Ally.CircleActive.ContainsKey(region))
        {
            Ally.CircleActive[region] = new Dictionary<string, bool> { ["physical"] = false, ["special"] = false, ["defensive"] = false };
        }
        Ally.CircleActive[region][circleType] = !Ally.CircleActive[region].GetValueOrDefault(circleType, false);
        StateHasChanged();
    }

    private void SetCircleAllyCount(string region, int count)
    {
        Ally.CircleAllyCount[region] = count;
        StateHasChanged();
    }

    private int GetActiveCirclesCount()
    {
        return Ally.CircleActive.Values.Sum(dict => dict.Values.Count(v => v));
    }

    private void ClearAllCircles()
    {
        foreach (var r in CombatantState.CircleRegions)
        {
            if (Ally.CircleActive.ContainsKey(r))
            {
                Ally.CircleActive[r]["physical"] = false;
                Ally.CircleActive[r]["special"] = false;
                Ally.CircleActive[r]["defensive"] = false;
            }
            Ally.CircleAllyCount[r] = 1;
        }
        StateHasChanged();
    }

    private void ResetFieldEffects()
    {
        Field.Zone = string.Empty;
        Field.ZoneEx = false;
        Field.Terrain = string.Empty;
        Field.TerrainEx = false;
        Field.Weather = string.Empty;
        Field.WeatherEx = false;
        Field.TargetCount = 3;
        Ally.DamageField = string.Empty;
        Enemy.DamageField = string.Empty;
        Ally.PhysicalDamageReduction = false;
        Ally.SpecialDamageReduction = false;
        Enemy.PhysicalDamageReduction = false;
        Enemy.SpecialDamageReduction = false;
        foreach (var r in CombatantState.CircleRegions)
        {
            if (Ally.CircleActive.ContainsKey(r))
            {
                Ally.CircleActive[r]["physical"] = false;
                Ally.CircleActive[r]["special"] = false;
                Ally.CircleActive[r]["defensive"] = false;
            }
            Ally.CircleAllyCount[r] = 1;
        }
        StateHasChanged();
    }

    public void Dispose()
    {
        GridState.OnGridChanged -= OnGridStateUpdated;
    }
}