@inject DamageCalculatorService CalcService
@inject GridStateService GridState
@implements IDisposable

<div class="damage-calculator-panel p-2">
    @if (Ally.Pair == null)
    {
        <div class="text-center py-5 text-muted">Please select a Sync Pair to calculate damage.</div>
    }
    else
    {
        <!-- Form and Base Settings Bar -->
        <div class="card bg-dark border-secondary p-3 mb-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2">
                    <img src="@Ally.Pair.IconUrl" alt="@Ally.Pair.DisplayName" width="40" height="40" class="rounded-circle border border-warning" onerror="this.src=''img/trainers/unknown.png'';" />
                    <div>
                        <div class="fw-bold text-light">@Ally.Pair.DisplayName</div>
                        <div class="d-flex gap-1 align-items-center">
                            <span class="badge type-badge type-@Ally.Pair.Type.ToLowerInvariant()">@Ally.Pair.Type</span>
                            <span class="badge bg-secondary">@Ally.Pair.Role</span>
                            @if (!string.IsNullOrEmpty(Ally.Pair.ExRole))
                            {
                                <span class="badge bg-indigo">EX: @Ally.Pair.ExRole</span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Forms Tab (Base, Mega, Tera) -->
                @if (Ally.Pair.Variations.Count > 0 || Ally.Pair.HasMega || Ally.Pair.HasTera)
                {
                    <div class="btn-group btn-group-sm">
                        <button class="btn @(Ally.FormIndex == 0 ? "btn-warning" : "btn-outline-secondary")" @onclick="() => SetForm(0)">Base Form</button>
                        @for (int i = 0; i < Ally.Pair.Variations.Count; i++)
                        {
                            int idx = i + 1;
                            var v = Ally.Pair.Variations[i];
                            <button class="btn @(Ally.FormIndex == idx ? "btn-warning" : "btn-outline-secondary")" @onclick="() => SetForm(idx)">@v.FormName</button>
                        }
                    </div>
                }

                <!-- Star Level, Level, Move Level & SA Controls -->
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <!-- Move Level Selector (1-5) -->
                    <div class="d-flex align-items-center gap-1 bg-secondary bg-opacity-25 px-2 py-1 rounded border border-secondary">
                        <span class="small text-muted fw-bold">Move Lv:</span>
                        <select class="form-select form-select-sm bg-dark text-light border-0 p-0" style="width: 50px;" value="@Ally.MoveLevel" @onchange="OnMoveLevelSelect">
                            <option value="1">1/5</option>
                            <option value="2">2/5</option>
                            <option value="3">3/5</option>
                            <option value="4">4/5</option>
                            <option value="5">5/5</option>
                        </select>
                    </div>

                    <select class="form-select form-select-sm bg-dark text-light border-secondary" style="width: 100px;" @bind="Ally.StarLevel" @bind:after="StateHasChanged">
                        <option value="3★">3★</option>
                        <option value="4★">4★</option>
                        <option value="5★">5★</option>
                        <option value="5★ 20/20">5★ 20/20</option>
                        @if (Ally.Pair.HasEx)
                        {
                            <option value="5★ EX">5★ EX</option>
                        }
                    </select>

                    <select class="form-select form-select-sm bg-dark text-light border-secondary" style="width: 90px;" @bind="Ally.CharLevel" @bind:after="StateHasChanged">
                        <option value="120">Lv. 120</option>
                        <option value="130">Lv. 130</option>
                        <option value="140">Lv. 140</option>
                        <option value="150">Lv. 150</option>
                        <option value="200">Lv. 200</option>
                    </select>

                    @if (Ally.Pair.HasSuperAwakening)
                    {
                        <div class="d-flex align-items-center gap-1 bg-secondary bg-opacity-25 px-2 py-1 rounded border border-danger">
                            <span class="text-danger small fw-bold">SA:</span>
                            <select class="form-select form-select-sm bg-dark text-light border-0 p-0" style="width: 45px;" value="@Ally.SuperAwakeningLevel" @onchange="OnSaLevelSelect">
                                <option value="0">0</option>
                                <option value="1">1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                                <option value="4">4</option>
                                <option value="5">5</option>
                            </select>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Live Damage Output Hero Cards -->
        <div class="mb-4">
            <h6 class="text-warning fw-bold text-uppercase mb-2 d-flex align-items-center gap-2">
                <i class="bi bi-lightning-charge-fill"></i> Live Damage Results
                @if (GridState.ActiveCells.Count > 0)
                {
                    <span class="badge bg-secondary text-info fs-7 ms-2">
                        @GridState.ActiveCells.Count Grid Tiles Active
                    </span>
                }
            </h6>
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
                @foreach (var move in ActiveMoves)
                {
                    var result = CalcService.CalculateDamage(move, Ally, Enemy, Field, Rules, GridState.ActiveCells);
                    <div class="col">
                        <div class="card h-100 bg-dark border-secondary damage-card p-3 shadow">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div class="fw-bold text-light fs-6">@move.Name</div>
                                    <div class="d-flex gap-1 mt-1">
                                        <span class="badge type-badge type-@move.Type.ToLowerInvariant()">@move.Type</span>
                                        <span class="badge bg-secondary">@move.Category</span>
                                        @if (move.IsSync)
                                        {
                                            <span class="badge bg-purple">Sync Move</span>
                                        }
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="badge bg-secondary text-light">Power: @result.ScaledMovePower</div>
                                </div>
                            </div>

                            <!-- Big Damage Numbers -->
                            <div class="damage-hero text-center my-3 p-2 rounded bg-black bg-opacity-40 border border-secondary border-opacity-50">
                                <div class="text-muted small">Average Damage</div>
                                <div class="fs-2 fw-bolder text-warning">@result.AvgDamage.ToString("N0")</div>
                                <div class="small text-secondary d-flex justify-content-center gap-3 mt-1">
                                    <span>Min: <b class="text-light">@result.MinDamage.ToString("N0")</b></span>
                                    <span>Max: <b class="text-light">@result.MaxDamage.ToString("N0")</b></span>
                                </div>
                            </div>

                            <!-- Multipliers Breakdown Pills -->
                            <div class="d-flex flex-wrap gap-1 mt-auto">
                                @foreach (var pill in result.Breakdown)
                                {
                                    <span class="badge" style="background-color: @pill.Color; font-size: 0.75rem;">
                                        @pill.Label: @pill.Value
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Controls Accordion (Attacker, Defender, Field) -->
        <div class="row g-3">
            <!-- Attacker Settings -->
            <div class="col-lg-4">
                <div class="card bg-dark border-secondary h-100 p-3">
                    <h6 class="text-info fw-bold mb-3"><i class="bi bi-shield-shaded"></i> Attacker Buffs</h6>
                    
                    <!-- Stat Stages -->
                    <div class="row g-2 mb-3">
                        @foreach (var stat in new[] { "atk", "def", "spa", "spd", "spe", "crit" })
                        {
                            int val = Ally.Stages.GetValueOrDefault(stat, 0);
                            int maxStage = stat == "crit" ? 3 : 6;
                            int minStage = stat == "crit" ? 0 : -6;
                            <div class="col-6">
                                <label class="small text-secondary text-uppercase d-flex justify-content-between">
                                    <span>@stat</span>
                                    <span class="fw-bold @(val > 0 ? "text-success" : (val < 0 ? "text-danger" : "text-light"))">@(val > 0 ? $"+{val}" : val.ToString())</span>
                                </label>
                                <div class="input-group input-group-sm">
                                    <button class="btn btn-outline-secondary" type="button" @onclick="() => SetAllyStage(stat, Math.Max(minStage, val - 1))">-</button>
                                    <input type="range" class="form-range mx-2" min="@minStage" max="@maxStage" value="@val" @oninput="(e) => OnAllySliderInput(stat, e)" />
                                    <button class="btn btn-outline-secondary" type="button" @onclick="() => SetAllyStage(stat, Math.Min(maxStage, val + 1))">+</button>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Next Boosts (PMUN, SMUN, SE Next, Crit) -->
                    <div class="mb-3">
                        <label class="small text-secondary fw-bold text-uppercase d-block mb-1">Boosts Next</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="small text-muted">Phys Boost (PMUN): <b>@Ally.PhysicalBoostNext</b></label>
                                <input type="range" class="form-range" min="0" max="10" @bind="Ally.PhysicalBoostNext" @bind:after="StateHasChanged" />
                            </div>
                            <div class="col-6">
                                <label class="small text-muted">Spec Boost (SMUN): <b>@Ally.SpecialBoostNext</b></label>
                                <input type="range" class="form-range" min="0" max="10" @bind="Ally.SpecialBoostNext" @bind:after="StateHasChanged" />
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <button class="btn btn-sm @(Ally.IsCriticalMove ? "btn-warning" : "btn-outline-secondary")" @onclick="() => { Ally.IsCriticalMove = !Ally.IsCriticalMove; StateHasChanged(); }">Crit Hit</button>
                            <button class="btn btn-sm @(Ally.SuperEffectiveNext ? "btn-danger" : "btn-outline-secondary")" @onclick="() => { Ally.SuperEffectiveNext = !Ally.SuperEffectiveNext; StateHasChanged(); }">SE Next (×3)</button>
                            <button class="btn btn-sm @(Ally.PhysicalBreak ? "btn-pink" : "btn-outline-secondary")" @onclick="() => { Ally.PhysicalBreak = !Ally.PhysicalBreak; StateHasChanged(); }">Phys Break</button>
                            <button class="btn btn-sm @(Ally.SpecialBreak ? "btn-pink" : "btn-outline-secondary")" @onclick="() => { Ally.SpecialBreak = !Ally.SpecialBreak; StateHasChanged(); }">Spec Break</button>
                        </div>
                    </div>

                    <!-- Sync Boosts -->
                    <div class="mb-3">
                        <label class="small text-secondary fw-bold text-uppercase d-flex justify-content-between">
                            <span>Sync Buffs (Determinación)</span>
                            <span class="fw-bold text-warning">×@(1.0 + Ally.SyncBoosts * 0.5)</span>
                        </label>
                        <div class="btn-group btn-group-sm w-100">
                            @for (int sb = 0; sb <= 9; sb++)
                            {
                                int s = sb;
                                <button class="btn @(Ally.SyncBoosts == s ? "btn-warning" : "btn-outline-secondary")" @onclick="() => { Ally.SyncBoosts = s; StateHasChanged(); }">
                                    @s
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Lucky Skill Picker -->
                    <div class="mb-2">
                        <label class="small text-secondary fw-bold text-uppercase">Lucky Skill</label>
                        <select class="form-select form-select-sm bg-dark text-light border-secondary" @bind="Ally.LuckySkillName" @bind:after="StateHasChanged">
                            <option value="">(None)</option>
                            @foreach (var ls in Rules.LuckySkills.Where(s => s.IsAvailableFor(Ally.Pair.Role, Ally.Pair.DisplayName)))
                            {
                                <option value="@ls.Name">@ls.Name</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Defender Settings -->
            <div class="col-lg-4">
                <div class="card bg-dark border-secondary h-100 p-3">
                    <h6 class="text-danger fw-bold mb-3"><i class="bi bi-shield-x"></i> Defender (Enemy)</h6>

                    <!-- Stat Stages -->
                    <div class="row g-2 mb-3">
                        @foreach (var stat in new[] { "def", "spd", "atk", "spa", "spe" })
                        {
                            int val = Enemy.Stages.GetValueOrDefault(stat, 0);
                            <div class="col-6">
                                <label class="small text-secondary text-uppercase d-flex justify-content-between">
                                    <span>@stat</span>
                                    <span class="fw-bold @(val > 0 ? "text-success" : (val < 0 ? "text-danger" : "text-light"))">@(val > 0 ? $"+{val}" : val.ToString())</span>
                                </label>
                                <div class="input-group input-group-sm">
                                    <button class="btn btn-outline-secondary" type="button" @onclick="() => SetEnemyStage(stat, Math.Max(-6, val - 1))">-</button>
                                    <input type="range" class="form-range mx-2" min="-6" max="6" value="@val" @oninput="(e) => OnEnemySliderInput(stat, e)" />
                                    <button class="btn btn-outline-secondary" type="button" @onclick="() => SetEnemyStage(stat, Math.Min(6, val + 1))">+</button>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Weakness & Status Conditions -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="small text-secondary">Weakness Type</label>
                            <select class="form-select form-select-sm bg-dark text-light border-secondary" @bind="Enemy.Weakness" @bind:after="StateHasChanged">
                                <option value="">None (Neutral)</option>
                                @foreach (var t in CombatantState.AllTypes)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="small text-secondary">Status Condition</label>
                            <select class="form-select form-select-sm bg-dark text-light border-secondary" @bind="Enemy.StatusCondition" @bind:after="StateHasChanged">
                                <option value="">None</option>
                                <option value="burned">Burned</option>
                                <option value="paralyzed">Paralyzed</option>
                                <option value="poisoned">Poisoned</option>
                                <option value="badly poisoned">Badly Poisoned</option>
                                <option value="frozen">Frozen</option>
                                <option value="asleep">Asleep</option>
                            </select>
                        </div>
                    </div>

                    <!-- Type Rebuff -->
                    <div class="mb-2">
                        <label class="small text-secondary fw-bold text-uppercase d-flex justify-content-between">
                            <span>Enemy Type Rebuff (@Ally.Pair.Type)</span>
                            <span class="fw-bold">@Enemy.EnemyTypeRebuffs.GetValueOrDefault(Ally.Pair.Type, 0)</span>
                        </label>
                        <div class="btn-group btn-group-sm w-100">
                            @for (int r = -3; r <= 0; r++)
                            {
                                int rb = r;
                                <button class="btn @(Enemy.EnemyTypeRebuffs.GetValueOrDefault(Ally.Pair.Type, 0) == rb ? "btn-primary" : "btn-outline-secondary")"
                                        @onclick="() => { Enemy.EnemyTypeRebuffs[Ally.Pair.Type] = rb; StateHasChanged(); }">
                                    @rb
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Field Conditions -->
            <div class="col-lg-4">
                <div class="card bg-dark border-secondary h-100 p-3">
                    <h6 class="text-success fw-bold mb-3"><i class="bi bi-clouds"></i> Field Effects</h6>

                    <!-- Zone, Terrain, Weather -->
                    <div class="mb-3">
                        <label class="small text-secondary">Zone</label>
                        <div class="input-group input-group-sm">
                            <select class="form-select bg-dark text-light border-secondary" @bind="Field.Zone" @bind:after="StateHasChanged">
                                <option value="">None</option>
                                @foreach (var t in CombatantState.AllTypes)
                                {
                                    <option value="@t Zone">@t Zone</option>
                                }
                            </select>
                            <button class="btn @(Field.ZoneEx ? "btn-warning" : "btn-outline-secondary")" @onclick="() => { Field.ZoneEx = !Field.ZoneEx; StateHasChanged(); }">EX (×3)</button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="small text-secondary">Terrain</label>
                        <div class="input-group input-group-sm">
                            <select class="form-select bg-dark text-light border-secondary" @bind="Field.Terrain" @bind:after="StateHasChanged">
                                <option value="">None</option>
                                <option value="Electric Terrain">Electric Terrain</option>
                                <option value="Grassy Terrain">Grassy Terrain</option>
                                <option value="Psychic Terrain">Psychic Terrain</option>
                            </select>
                            <button class="btn @(Field.TerrainEx ? "btn-warning" : "btn-outline-secondary")" @onclick="() => { Field.TerrainEx = !Field.TerrainEx; StateHasChanged(); }">EX (×3)</button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="small text-secondary">Weather</label>
                        <div class="input-group input-group-sm">
                            <select class="form-select bg-dark text-light border-secondary" @bind="Field.Weather" @bind:after="StateHasChanged">
                                <option value="">None</option>
                                <option value="Sunny">Sunny</option>
                                <option value="Rainy">Rainy</option>
                                <option value="Sandstorm">Sandstorm</option>
                                <option value="Hail">Hail</option>
                            </select>
                            <button class="btn @(Field.WeatherEx ? "btn-warning" : "btn-outline-secondary")" @onclick="() => { Field.WeatherEx = !Field.WeatherEx; StateHasChanged(); }">EX (×3)</button>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="small text-secondary">Target Count</label>
                        <div class="btn-group btn-group-sm w-100">
                            <button class="btn @(Field.TargetCount == 1 ? "btn-primary" : "btn-outline-secondary")" @onclick="() => { Field.TargetCount = 1; StateHasChanged(); }">1 (Single)</button>
                            <button class="btn @(Field.TargetCount == 2 ? "btn-primary" : "btn-outline-secondary")" @onclick="() => { Field.TargetCount = 2; StateHasChanged(); }">2 Targets</button>
                            <button class="btn @(Field.TargetCount == 3 ? "btn-primary" : "btn-outline-secondary")" @onclick="() => { Field.TargetCount = 3; StateHasChanged(); }">3 Targets</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public CombatantState Ally { get; set; } = new();
    [Parameter] public CombatantState Enemy { get; set; } = new();
    [Parameter] public FieldState Field { get; set; } = new();
    [Parameter] public DamageRulesDocument Rules { get; set; } = new();
    [Parameter] public int MoveLevel { get; set; } = 5;
    [Parameter] public EventCallback<int> MoveLevelChanged { get; set; }

    protected override void OnInitialized()
    {
        GridState.OnGridChanged += OnGridStateUpdated;
    }

    private void OnGridStateUpdated()
    {
        InvokeAsync(StateHasChanged);
    }

    private IEnumerable<MoveItem> ActiveMoves
    {
        get
        {
            if (Ally.Pair == null) return Enumerable.Empty<MoveItem>();
            return Ally.Pair.Moves.Where(m => !m.Category.Equals("Status", StringComparison.OrdinalIgnoreCase) && int.TryParse(m.Power, out int p) && p > 0);
        }
    }

    private void SetForm(int idx)
    {
        Ally.FormIndex = idx;
        StateHasChanged();
    }

    private async Task OnMoveLevelSelect(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            Ally.MoveLevel = val;
            int fullLvl = Ally.SuperAwakeningLevel > 0 ? (val + Ally.SuperAwakeningLevel) : val;
            await MoveLevelChanged.InvokeAsync(fullLvl);
            StateHasChanged();
        }
    }

    private async Task OnSaLevelSelect(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            Ally.SuperAwakeningLevel = val;
            int fullLvl = val > 0 ? (5 + val) : Ally.MoveLevel;
            await MoveLevelChanged.InvokeAsync(fullLvl);
            StateHasChanged();
        }
    }

    private void SetAllyStage(string stat, int val)
    {
        Ally.Stages[stat] = val;
        StateHasChanged();
    }

    private void SetEnemyStage(string stat, int val)
    {
        Enemy.Stages[stat] = val;
        StateHasChanged();
    }

    private void OnAllySliderInput(string stat, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            SetAllyStage(stat, val);
        }
    }

    private void OnEnemySliderInput(string stat, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            SetEnemyStage(stat, val);
        }
    }

    public void Dispose()
    {
        GridState.OnGridChanged -= OnGridStateUpdated;
    }
}