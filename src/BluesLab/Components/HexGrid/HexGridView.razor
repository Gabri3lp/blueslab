@inject GridStateService GridState

<div class="hex-grid-container position-relative w-100 h-100 d-flex flex-column align-items-center justify-content-center">
    @if (Pair == null || Pair.Grid.Count == 0)
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-grid-3x3-gap fs-1 d-block mb-2"></i>
            No sync grid available for this character.
        </div>
    }
    else
    {
        <div class="grid-viewport w-100 h-100 position-relative overflow-hidden">
            <svg class="hex-svg w-100 h-100" viewBox="@ViewBoxString" preserveAspectRatio="xMidYMid meet">
                <defs>
                    <!-- Glowing Filter for selected/active tiles -->
                    <filter id="tile-glow" x="-30%" y="-30%" width="160%" height="160%">
                        <feGaussianBlur stdDeviation="4" result="blur" />
                        <feComponentTransfer in="blur" result="brightBlur">
                            <feFuncA type="linear" slope="1.5" />
                        </feComponentTransfer>
                        <feMerge>
                            <feMergeNode in="brightBlur" />
                            <feMergeNode in="SourceGraphic" />
                        </feMerge>
                    </filter>

                    <!-- Center Hex Clip Path -->
                    <clipPath id="center-hex-clip">
                        <polygon points="@GetHexPoints(0, 0, TileRadius * 0.95)" />
                    </clipPath>
                </defs>

                <!-- Grid Cells -->
                @foreach (var cell in Pair.Grid)
                {
                    bool isActive = GridState.ActiveCells.Contains(cell.CellId);
                    bool isLocked = cell.MoveLevel > Math.Clamp(MoveLevel, 1, 5);
                    var (fillColor, strokeColor) = GetTileColors(cell.ColorKind, isActive, isLocked);
                    var (cx, cy) = GetHexCenter(cell.Q, cell.R);

                    <g class="hex-tile @(isActive ? "active" : "") @(isLocked ? "locked" : "") cursor-pointer"
                       @onclick="() => OnTileClicked(cell)"
                       @onmouseover="() => HoveredCell = cell"
                       @onmouseout="() => { if (HoveredCell == cell) HoveredCell = null; }">
                        
                        <!-- Base Hexagon -->
                        <polygon points="@GetHexPoints(cell.Q, cell.R)"
                                 fill="@fillColor"
                                 stroke="@strokeColor"
                                 stroke-width="@(isActive ? 3.0 : 1.5)"
                                 filter="@(isActive ? "url(#tile-glow)" : "none")" />

                        <!-- Inner Accent Ring when Active -->
                        @if (isActive)
                        {
                            <polygon points="@GetHexPoints(cell.Q, cell.R, TileRadius * 0.85)"
                                     fill="none"
                                     stroke="#ffffff"
                                     stroke-width="1.2"
                                     stroke-opacity="0.85" />
                        }

                        <!-- SVG Text and Badge Markup -->
                        @((MarkupString)RenderTileContent(cell, cx, cy, isActive, isLocked))
                    </g>
                }

                <!-- Center Tile (Pokemon Face Portrait Image) -->
                <g class="center-tile cursor-pointer" @onclick="OnCenterClicked">
                    <!-- Outer glowing center hex -->
                    <polygon points="@GetHexPoints(0, 0, TileRadius * 1.05)" fill="#111827" stroke="#f59e0b" stroke-width="3" filter="url(#tile-glow)" />
                    
                    <!-- Clipped Pokemon Image -->
                    @{
                        string pkmImg = !string.IsNullOrEmpty(Pair.PokemonIconUrl) ? Pair.PokemonIconUrl : Pair.IconUrl;
                    }
                    <image href="@pkmImg"
                           clip-path="url(#center-hex-clip)"
                           x="@(-TileRadius)"
                           y="@(-TileRadius)"
                           width="@(TileRadius * 2)"
                           height="@(TileRadius * 2)"
                           preserveAspectRatio="xMidYMid slice"
                           onerror="this.setAttribute('href', 'img/trainers/unknown.png');" />

                    <!-- Inner Golden Border -->
                    <polygon points="@GetHexPoints(0, 0, TileRadius * 0.95)" fill="none" stroke="#fbbf24" stroke-width="1.5" />
                </g>
            </svg>

            <!-- Floating Hover Tooltip -->
            @if (HoveredCell != null)
            {
                <div class="hover-tooltip shadow-lg bg-dark border border-secondary text-light p-2 rounded position-absolute" style="max-width: 280px; z-index: 100;">
                    <div class="fw-bold text-warning small">@HoveredCell.Title</div>
                    @if (!string.IsNullOrEmpty(HoveredCell.Description))
                    {
                        <div class="text-secondary small mt-1">@HoveredCell.Description</div>
                    }
                    <div class="d-flex align-items-center gap-3 mt-2 small">
                        <span>⚡ Energy: <b>@HoveredCell.EnergyCost</b></span>
                        <span>🔮 Orbs: <b>@HoveredCell.OrbCost</b></span>
                        <span>Level: <b class="@(HoveredCell.MoveLevel > MoveLevel ? "text-danger" : "text-success")">@HoveredCell.MoveLevel/5</b></span>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public SyncPairDetail? Pair { get; set; }
    [Parameter] public int MoveLevel { get; set; } = 5;
    [Parameter] public EventCallback OnCenterClick { get; set; }

    private GridCellItem? HoveredCell;
    private const double TileRadius = 42.0;
    private double NormHexW = 1.5;
    private double NormHexH = Math.Sqrt(3);

    private (double X, double Y) GetHexCenter(int q, int r)
    {
        double x = TileRadius * NormHexW * q;
        double y = TileRadius * NormHexH * (r + q / 2.0);
        return (x, y);
    }

    private string GetHexPoints(int q, int r, double radius = TileRadius)
    {
        var (cx, cy) = GetHexCenter(q, r);
        var points = new List<string>();
        for (int i = 0; i < 6; i++)
        {
            double angle = Math.PI / 180 * (60 * i);
            double px = cx + radius * Math.Cos(angle);
            double py = cy + radius * Math.Sin(angle);
            points.Add($"{px:0.#},{py:0.#}");
        }
        return string.Join(" ", points);
    }

    private string ViewBoxString
    {
        get
        {
            if (Pair == null || Pair.Grid.Count == 0) return "-300 -300 600 600";
            double minX = 0, maxX = 0, minY = 0, maxY = 0;
            foreach (var cell in Pair.Grid)
            {
                var (cx, cy) = GetHexCenter(cell.Q, cell.R);
                minX = Math.Min(minX, cx - TileRadius);
                maxX = Math.Max(maxX, cx + TileRadius);
                minY = Math.Min(minY, cy - TileRadius);
                maxY = Math.Max(maxY, cy + TileRadius);
            }
            double pad = TileRadius * 1.2;
            double w = (maxX - minX) + pad * 2;
            double h = (maxY - minY) + pad * 2;
            double x = minX - pad;
            double y = minY - pad;
            return $"{x:0.#} {y:0.#} {w:0.#} {h:0.#}";
        }
    }

    private (string fill, string stroke) GetTileColors(string kind, bool active, bool locked)
    {
        if (locked)
            return ("#1e2229", "#4b5563");

        string k = kind.ToLowerInvariant();
        return k switch
        {
            "stat" => active ? ("#2563eb", "#ffffff") : ("#172554", "#3b82f6"),
            "move boost" => active ? ("#16a34a", "#ffffff") : ("#052e16", "#22c55e"),
            "move effect" => active ? ("#dc2626", "#ffffff") : ("#450a0a", "#ef4444"),
            "sync" => active ? ("#7c3aed", "#ffffff") : ("#2e1065", "#a855f7"),
            "passive" => active ? ("#d97706", "#ffffff") : ("#451a03", "#f59e0b"),
            _ => active ? ("#d97706", "#ffffff") : ("#451a03", "#f59e0b")
        };
    }

    private string RenderTileContent(GridCellItem cell, double cx, double cy, bool isActive, bool isLocked)
    {
        var (line1, line2) = SplitCellLabel(cell);
        var sb = new System.Text.StringBuilder();
        sb.Append("<g class=\"tile-labels\" style=\"user-select: none; pointer-events: none;\">");

        if (!string.IsNullOrEmpty(line2))
        {
            string color1 = isActive ? "#ffffff" : "#d1d5db";
            string color2 = isActive ? "#ffffff" : "#f59e0b";
            double fs1 = TileRadius * 0.20;
            double fs2 = TileRadius * 0.22;
            sb.Append($"<text x=\"{cx:0.#}\" y=\"{(cy - 6):0.#}\" text-anchor=\"middle\" dominant-baseline=\"central\" fill=\"{color1}\" font-size=\"{fs1:0.#}\" font-weight=\"bold\">{System.Net.WebUtility.HtmlEncode(line1)}</text>");
            sb.Append($"<text x=\"{cx:0.#}\" y=\"{(cy + 8):0.#}\" text-anchor=\"middle\" dominant-baseline=\"central\" fill=\"{color2}\" font-size=\"{fs2:0.#}\" font-weight=\"bold\">{System.Net.WebUtility.HtmlEncode(line2)}</text>");
        }
        else
        {
            string color = isActive ? "#ffffff" : "#f1f2f6";
            double fs = TileRadius * 0.23;
            sb.Append($"<text x=\"{cx:0.#}\" y=\"{cy:0.#}\" text-anchor=\"middle\" dominant-baseline=\"central\" fill=\"{color}\" font-size=\"{fs:0.#}\" font-weight=\"bold\">{System.Net.WebUtility.HtmlEncode(line1)}</text>");
        }

        if (isLocked)
        {
            double lx = cx + TileRadius * 0.55;
            double ly = cy - TileRadius * 0.55;
            sb.Append($"<circle cx=\"{lx:0.#}\" cy=\"{ly:0.#}\" r=\"9\" fill=\"#dc2626\" stroke=\"#ffffff\" stroke-width=\"1\" />");
            sb.Append($"<text x=\"{lx:0.#}\" y=\"{ly:0.#}\" text-anchor=\"middle\" dominant-baseline=\"central\" fill=\"#ffffff\" font-size=\"8\" font-weight=\"bold\">{cell.MoveLevel}/5</text>");
        }

        if (cell.EnergyCost > 0)
        {
            double ex = cx - TileRadius * 0.55;
            double ey = cy - TileRadius * 0.55;
            string ecColor = isActive ? "#ffffff" : "#9ca3af";
            sb.Append($"<text x=\"{ex:0.#}\" y=\"{ey:0.#}\" text-anchor=\"middle\" dominant-baseline=\"central\" fill=\"{ecColor}\" font-size=\"8\" font-weight=\"bold\">{cell.EnergyCost}</text>");
        }

        sb.Append("</g>");
        return sb.ToString();
    }

    private (string line1, string line2) SplitCellLabel(GridCellItem cell)
    {
        string t = cell.Title.Trim();
        if (string.IsNullOrEmpty(t)) return ("", "");

        // Stat bonus
        if (t.StartsWith("HP +")) return ("HP", $"+{t[4..]}");
        if (t.StartsWith("Attack +")) return ("Attack", $"+{t[8..]}");
        if (t.StartsWith("Defense +")) return ("Defense", $"+{t[9..]}");
        if (t.StartsWith("Sp. Atk +")) return ("Sp. Atk", $"+{t[9..]}");
        if (t.StartsWith("Sp. Def +")) return ("Sp. Def", $"+{t[9..]}");
        if (t.StartsWith("Speed +")) return ("Speed", $"+{t[7..]}");

        // Move boosts
        if (t.Contains(": Power +"))
        {
            var parts = t.Split(": Power +");
            return (ShortenMoveName(parts[0]), $"Power +{parts[1]}");
        }
        if (t.Contains(": Accuracy +"))
        {
            var parts = t.Split(": Accuracy +");
            return (ShortenMoveName(parts[0]), $"Acc +{parts[1]}");
        }
        if (t.Contains(": Move Gauge Refresh "))
        {
            var parts = t.Split(": Move Gauge Refresh ");
            return (ShortenMoveName(parts[0]), $"MGR {parts[1]}");
        }
        if (t.Contains(": MP Refresh "))
        {
            var parts = t.Split(": MP Refresh ");
            return (ShortenMoveName(parts[0]), $"MPR {parts[1]}");
        }
        if (t.Contains(":"))
        {
            var parts = t.Split(":", 2);
            return (ShortenMoveName(parts[0]), parts[1].Trim());
        }

        // Single long skill names
        if (t.Length > 11 && t.Contains(" "))
        {
            var words = t.Split(" ");
            if (words.Length == 2) return (words[0], words[1]);
            if (words.Length >= 3) return ($"{words[0]} {words[1]}", string.Join(" ", words.Skip(2)));
        }

        return (t, "");
    }

    private string ShortenMoveName(string move)
    {
        move = move.Trim();
        if (move.Length <= 10) return move;
        if (move.StartsWith("Ultimate ")) return "U-" + move[9..];
        if (move.StartsWith("Buddy ")) return "B-" + move[6..];
        if (move.Length > 12) return move[..10] + "..";
        return move;
    }

    private void OnTileClicked(GridCellItem cell)
    {
        if (Pair != null)
        {
            GridState.ToggleCell(Pair, cell, MoveLevel);
        }
    }

    private async Task OnCenterClicked()
    {
        await OnCenterClick.InvokeAsync();
    }
}