@inject GridStateService GridState

<div class="hex-grid-container position-relative w-100 h-100 d-flex flex-column">
    @if (Pair == null || Pair.Grid.Count == 0)
    {
        <div class="text-center py-5 text-muted m-auto">
            <i class="bi bi-grid-3x3-gap fs-1 d-block mb-2"></i>
            No sync grid available for this character.
        </div>
    }
    else
    {
        <!-- Seamless Grid Controls Toolbar (No solid background) -->
        <div class="grid-controls-bar w-100 d-flex flex-wrap align-items-center justify-content-between px-3 py-2 border-bottom border-secondary border-opacity-50">
            <!-- Left: Energy & Orbs (Clean text with clear icons, no dark container box) -->
            <div class="d-flex align-items-center gap-3">
                <span class="fw-bold text-warning d-flex align-items-center gap-1 fs-6">
                    ⚡ <b>@GridState.GetRemainingEnergy(Pair)</b>/60
                </span>
                <span class="text-secondary opacity-50">|</span>
                <span class="fw-bold text-info d-flex align-items-center gap-1 fs-6">
                    🔮 <b>@GridState.GetTotalOrbs(Pair)</b>
                </span>
            </div>

            <!-- Right: Move Level Gems, SA, Hard Cap, Reset, Share -->
            <div class="d-flex flex-wrap align-items-center gap-2">
                <!-- Move Level Gems (1-5) -->
                <div class="d-flex align-items-center gap-1">
                    @for (int i = 1; i <= 5; i++)
                    {
                        int lvl = i;
                        <img src="@(MoveLevel >= lvl ? "img/sync_level_on.png" : "img/sync_level_off.png")"
                             alt="Lv.@lvl"
                             width="26"
                             height="26"
                             class="cursor-pointer @(MoveLevel >= lvl ? "" : "opacity-50")"
                             title="Move Level @lvl/5"
                             @onclick="() => OnMoveLevelClick(lvl)" />
                    }

                    <!-- Super Awakening (6-10) -->
                    @if (Pair.HasSuperAwakening)
                    {
                        <span class="text-secondary opacity-50 mx-1">|</span>
                        @for (int i = 6; i <= 10; i++)
                        {
                            int lvl = i;
                            <img src="img/transcendance.png"
                                 alt="SA.@(lvl-5)"
                                 width="26"
                                 height="26"
                                 class="cursor-pointer @(MoveLevel >= lvl ? "" : "opacity-25")"
                                 title="Super Awakening @(lvl-5)/5"
                                 @onclick="() => OnMoveLevelClick(MoveLevel == lvl ? lvl - 1 : lvl)" />
                        }
                    }
                </div>

                <!-- Hard Cap Toggle -->
                <div class="form-check form-switch d-flex align-items-center gap-1 mb-0 ms-2">
                    <input class="form-check-input cursor-pointer" type="checkbox" id="gridHardCapSwitch" checked="@GridState.HardCap" @onchange="OnHardCapToggle" />
                    <label class="form-check-label text-secondary small select-none" for="gridHardCapSwitch" style="font-size: 0.8rem;">Hard Cap</label>
                </div>

                <!-- Reset Grid -->
                <button class="btn btn-outline-danger btn-sm p-1 px-2" title="Reset Grid" @onclick="OnResetGrid">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </button>

                <!-- Share Build -->
                <button class="btn btn-outline-warning btn-sm p-1 px-2" title="Share Build" @onclick="OnShareClick">
                    <i class="bi bi-share"></i>
                </button>
            </div>
        </div>

        <div class="grid-viewport w-100 flex-grow-1 position-relative overflow-hidden">
            <svg class="hex-svg w-100 h-100" viewBox="@ViewBoxString" preserveAspectRatio="xMidYMid meet">
                <defs>
                    <filter id="tile-glow" x="-30%" y="-30%" width="160%" height="160%">
                        <feGaussianBlur stdDeviation="3" result="blur" />
                        <feComposite in="SourceGraphic" in2="blur" operator="over" />
                    </filter>
                </defs>

                <!-- Grid Cells using Brybry PNG Tile Assets -->
                @foreach (var cell in Pair.Grid)
                {
                    bool isActive = GridState.ActiveCells.Contains(cell.CellId);
                    bool isLocked = cell.MoveLevel > Math.Clamp(MoveLevel, 1, 5);
                    var (cx, cy) = GetHexCenter(cell.Q, cell.R);

                    string panelType = GetPanelType(cell);
                    string tileIcon = GetTileIcon(cell, panelType, isLocked);

                    string bgHref = isActive ? $"data/sync-grids/{panelType}-selected.png" : $"data/sync-grids/{panelType}.png";
                    string iconHref = (isActive && !isLocked && panelType != "arceuspanel")
                        ? $"data/sync-grids/icons/{tileIcon}-selected.png"
                        : $"data/sync-grids/icons/{tileIcon}.png";

                    double imgX = cx - 34.5;
                    double imgY = cy - 30.0;

                    <g class="hex-tile @(isActive ? "active" : "") @(isLocked ? "locked" : "")"
                       style="cursor: pointer;"
                       @onclick="() => OnTileClicked(cell)"
                       @onmouseover="() => HoveredCell = cell"
                       @onmouseout="() => { if (HoveredCell == cell) HoveredCell = null; }">

                        <!-- Layer 1: Background Hex Tile Image -->
                        <image href="@bgHref"
                               x="@imgX"
                               y="@imgY"
                               width="69"
                               height="60"
                               class="bg-layer" />

                        <!-- Layer 2: Tile Icon Image -->
                        <image href="@iconHref"
                               x="@imgX"
                               y="@imgY"
                               width="69"
                               height="60"
                               class="icon-layer" />

                        <!-- Layer 3: Selected Glow Overlay -->
                        @if (isActive)
                        {
                            <image href="data/sync-grids/selected-overlay.png"
                                   x="@imgX"
                                   y="@imgY"
                                   width="69"
                                   height="60"
                                   class="overlay-layer" />
                        }

                        <!-- Layer 4: Interactive Polygon Mask -->
                        <polygon points="@GetBrybryHexPoints(cx, cy)"
                                 style="fill: transparent; stroke: none; cursor: pointer; pointer-events: all;" />
                    </g>
                }

                <!-- Center Tile (Brybry Center Tile Asset) -->
                <g class="center-tile" style="cursor: pointer;" @onclick="OnCenterClicked">
                    <image href="data/sync-grids/center.png"
                           x="-34.5"
                           y="-30.0"
                           width="69"
                           height="60"
                           class="bg-layer" />
                    <polygon points="@GetBrybryHexPoints(0, 0)"
                             style="fill: transparent; stroke: none; cursor: pointer; pointer-events: all;" />
                </g>
            </svg>

            <!-- Floating Hover Tooltip -->
            @if (HoveredCell != null)
            {
                <div class="hover-tooltip shadow-lg bg-dark border border-secondary text-light p-2 rounded position-absolute" style="max-width: 280px; z-index: 100;">
                    <div class="fw-bold text-warning small">@HoveredCell.Title</div>
                    @if (!string.IsNullOrEmpty(HoveredCell.Description))
                    {
                        <div class="text-secondary small mt-1">@HoveredCell.Description</div>
                    }
                    <div class="d-flex align-items-center gap-3 mt-2 small">
                        <span>⚡ Energy: <b>@HoveredCell.EnergyCost</b></span>
                        <span>🔮 Orbs: <b>@HoveredCell.OrbCost</b></span>
                        <span>Level: <b class="@(HoveredCell.MoveLevel > MoveLevel ? "text-danger" : "text-success")">@HoveredCell.MoveLevel/5</b></span>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public SyncPairDetail? Pair { get; set; }
    [Parameter] public int MoveLevel { get; set; } = 5;
    [Parameter] public EventCallback<int> MoveLevelChanged { get; set; }
    [Parameter] public EventCallback OnCenterClick { get; set; }
    [Parameter] public EventCallback OnOpenShareModal { get; set; }

    private GridCellItem? HoveredCell;

    private async Task OnMoveLevelClick(int lvl)
    {
        MoveLevel = lvl;
        await MoveLevelChanged.InvokeAsync(lvl);
    }

    private void OnHardCapToggle(ChangeEventArgs e)
    {
        GridState.HardCap = (bool)(e.Value ?? true);
        if (Pair != null && GridState.HardCap)
        {
            GridState.ActivateFreeCenterCells(Pair, MoveLevel);
            GridState.PruneDisconnected(Pair.Grid);
            GridState.NotifyChanged();
        }
    }

    private void OnResetGrid()
    {
        if (Pair != null)
        {
            GridState.ResetGrid(Pair, MoveLevel);
        }
    }

    private async Task OnShareClick()
    {
        await OnOpenShareModal.InvokeAsync();
    }

    // Brybry standard tile dimensions (51 width offset per col, 30 height offset per row)
    private const double ColWidth = 51.0;
    private const double RowHeight = 30.0;

    private (double X, double Y) GetHexCenter(int q, int r)
    {
        double x = q * ColWidth;
        double y = (r + q / 2.0) * RowHeight * 2.0;
        return (x, y);
    }

    private string GetBrybryHexPoints(double cx, double cy)
    {
        // Brybry standard polygon: "17,0 52,0 69,30 52,60 17,60 0,30" relative to (cx - 34.5, cy - 30)
        double left = cx - 34.5;
        double top = cy - 30.0;
        return $"{left + 17:0.#},{top:0.#} {left + 52:0.#},{top:0.#} {left + 69:0.#},{top + 30:0.#} {left + 52:0.#},{top + 60:0.#} {left + 17:0.#},{top + 60:0.#} {left:0.#},{top + 30:0.#}";
    }

    private string ViewBoxString
    {
        get
        {
            if (Pair == null || Pair.Grid.Count == 0) return "-300 -300 600 600";
            double minX = 0, maxX = 0, minY = 0, maxY = 0;
            foreach (var cell in Pair.Grid)
            {
                var (cx, cy) = GetHexCenter(cell.Q, cell.R);
                minX = Math.Min(minX, cx - 34.5);
                maxX = Math.Max(maxX, cx + 34.5);
                minY = Math.Min(minY, cy - 30.0);
                maxY = Math.Max(maxY, cy + 30.0);
            }
            double pad = 40.0;
            double w = (maxX - minX) + pad * 2;
            double h = (maxY - minY) + pad * 2;
            double x = minX - pad;
            double y = minY - pad;
            return $"{x:0.#} {y:0.#} {w:0.#} {h:0.#}";
        }
    }

    private string GetPanelType(GridCellItem cell)
    {
        string title = cell.Title.Trim().ToLowerInvariant();
        string kind = cell.ColorKind.Trim().ToLowerInvariant();

        if (title.Contains("arc suit") || title.Contains("arceus") || kind.Contains("arc"))
            return "arceuspanel";

        if (kind == "stat" || title.StartsWith("hp +") || title.StartsWith("attack +") ||
            title.StartsWith("defense +") || title.StartsWith("sp. atk +") ||
            title.StartsWith("sp. def +") || title.StartsWith("speed +"))
            return "statsup";

        if (kind == "sync" || title.Contains("sync move"))
            return "syncmove";

        if (kind == "max" || title.Contains("max move"))
            return "maxmove";

        if (title.Contains(": power +") || kind == "move boost")
            return "movepowerup";

        if (title.Contains(": move gauge refresh") || title.Contains(": mp refresh") ||
            title.Contains(": accuracy +") || kind == "move effect")
            return "moveeffect";

        if (title.Contains("learn ") || kind == "learn")
            return "learnmove";

        return "passiveskill";
    }

    private string GetTileIcon(GridCellItem cell, string panelType, bool isLocked)
    {
        if (isLocked)
        {
            int lvl = Math.Clamp(cell.MoveLevel, 2, 5);
            return $"locked-{lvl}";
        }

        if (panelType == "movepowerup")
        {
            int typeId = GetTypeId(Pair?.Type);
            return $"movepowerup-{typeId}";
        }

        return panelType;
    }

    private int GetTypeId(string? pairType)
    {
        string t = (pairType ?? "Normal").Trim().ToLowerInvariant();
        return t switch
        {
            "normal" => 1,
            "fire" => 2,
            "water" => 3,
            "electric" => 4,
            "grass" => 5,
            "ice" => 6,
            "fighting" => 7,
            "poison" => 8,
            "ground" => 9,
            "flying" => 10,
            "psychic" => 11,
            "bug" => 12,
            "rock" => 13,
            "ghost" => 14,
            "dragon" => 15,
            "dark" => 16,
            "steel" => 17,
            "fairy" => 18,
            _ => 1
        };
    }

    private void OnTileClicked(GridCellItem cell)
    {
        if (Pair != null)
        {
            GridState.ToggleCell(Pair, cell, MoveLevel);
        }
    }

    private async Task OnCenterClicked()
    {
        await OnCenterClick.InvokeAsync();
    }
}